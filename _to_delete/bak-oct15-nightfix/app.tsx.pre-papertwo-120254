  mark: number;
  closeTime?: string;
  secondsLeft: number;
  why: string;
  onRefresh: () => void;
}) {
  const step = row.name === "BTC" ? 1 : 0.01;
  const price = useRollingPrice(spot);
  const strike = useRollingPrice(row.target ?? 0);
  const left = useLiveCountdown(closeTime, secondsLeft);
