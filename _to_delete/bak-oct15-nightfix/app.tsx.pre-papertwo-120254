type TruthFill = { at: string; kind: string; venue: string; ticker: string; side: string; asset: string; tradeId: string; stake: number; profit: number | null; pattern: string; multiple: number };

function kalshiByTrade(fills: TruthFill[]) {
  const live = new Map<string, number>();
  for (const r of fills) {
    if (r.venue !== "kalshi" || r.kind !== "banked" || r.profit == null) continue;
    const k = `${r.ticker}|${r.side}`;
    live.set(k, (live.get(k) ?? 0) + r.profit);
  }
  return live;
}

function TruthHeader({ title, sub, chips }: { title: string; sub: string; chips: { label: string; value: string; tone?: "up" | "down" }[] }) {
  return (
    <section className="rounded-[22px] border border-white/30 px-5 pb-4 pt-4 shadow-[0_0_24px_rgba(255,255,255,0.07)]">
