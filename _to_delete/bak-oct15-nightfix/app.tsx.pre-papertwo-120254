          </button>
        ))}
      </div>
      {showWhy ? <p className="mt-1.5 text-[12px] leading-snug text-white/80">{why}</p> : null}
    </li>
  );
}

function DockOrder({ row, onClose: onCloseNow, onPart: onPartNow }: { row: HeldOrder; onClose: () => void; onPart?: (pct: number) => void }) {
  // ONE TAP AGAIN (Love, Oct 5 ~1:30 PM PT: "the close button doesn't work... it blocks it with a label and makes me click
  // again"). The two-tap rule (Oct 4, after a slider touch landed on the flush 75% button) is gone. What it guarded against
  // is guarded directly now: a sell button ignores any tap that comes within 0.8 s of touching the slider, and the buttons
  // sit a little further from the slider. A real tap sells on the first touch.
  const slideAt = useRef(0);
  // 350 ms, was 800 (Oct 15, Love: "it doesn't even register sometimes"): the slider guard ate real clicks in silence.
  const fromSlider = () => Date.now() - slideAt.current < 350;
  // TWO TAPS, NO LABEL (Love, Oct 5 ~1:40 PM PT: "i like the tap again concept. But the label was blocking it"). First tap
  // arms the button (it reads AGAIN for 3 s), the second tap sells. No pop-up toast over the buttons anymore.
  const [armedSell, setArmedSell] = useState<string | null>(null);
  const armedAt = useRef(0);
  const twoTap = (key: string, go: () => void) => {
    if (fromSlider()) return;
    if (armedSell === key && Date.now() - armedAt.current < 3000) {
      setArmedSell(null);
      go();
      return;
    }
    armedAt.current = Date.now();
    setArmedSell(key);
    setTimeout(() => setArmedSell((cur) => (cur === key ? null : cur)), 3000);
  };
  // ONE TAP (Love, Oct 5 ~11:15 PM PT: "can we take the two clicks off the boxes to close? its being troublesome"). The
  // slider guard stays (a tap within 0.8 s of touching the slider is ignored).
  void twoTap;
  const onPart = (pct: number) => {
    if (fromSlider()) { toast("Finger was on the slider - tap once more."); return; }
    onPartNow?.(pct);
  };
  const onClose = () => {
    if (fromSlider()) { toast("Finger was on the slider - tap once more."); return; }
    onCloseNow();
  };
  const cash = row.value > 0 ? row.value : row.cost;
  const roll = useRollingPrice(cash);
  const livePct = row.cost > 0 ? ((cash - row.cost) / row.cost) * 100 : 0;
  // A quote that didn't come back (or is 15 s+ old) no longer paints a stale red/green: it goes grey with "SYNCING".
  const old = Boolean(row.stale) || (row.at ? Date.now() - Date.parse(row.at) > 15000 : false);
  const tone = old ? "text-white/50" : livePct > 0.5 ? "text-up" : livePct < -0.5 ? "text-down" : "text-white";
  const maxCash = Math.round(row.contracts * 100) / 100;
  const mult = row.cost > 0 ? maxCash / row.cost : 0;
  // SLIM DOCK (Love, Oct 3 ~5:30 PM PT: "more compact rectangles and less squares... the whole box a bit more compact,
  // slimmer... remove the slide to set a scale"). The sell-at slider lives on the big card now; the dock keeps the
  // quick sells plus one small line with the stake, multiple and max. Buttons draw their own even 1px outline (no glow,
  // no half-pixel offsets) so the top never reads brighter than the sides.
  const btn = { border: "1px solid rgba(255,255,255,0.78)", boxShadow: "none" };
  // SELL-AT SLIDER, back in the dock (Love, Oct 3 ~7 PM PT: "just a slider with the percentage and dollar amount...
  // matched to kalshi's numbers"). It moves in whole cents like Kalshi's own sell ticket: the price per contract, the %
  // that price is on your cost, and the dollars it pays (contracts x price, before Kalshi's fee).
  const entryC = row.contracts > 0 ? (row.cost / row.contracts) * 100 : 0;
  const minC = Math.min(99, Math.floor(entryC) + 1);
  const pctAtC = (c: number) => (row.cost > 0 ? ((row.contracts * c) / 100 / row.cost - 1) * 100 : 0);
  const cashAtC = (c: number) => Math.round(row.contracts * c) / 100;
  const cFromPct = (pct: number) => Math.max(minC, Math.min(99, Math.round(entryC * (1 + pct / 100))));
  const remembered = savedSale(row.ticker);
  const [pinC, setPinC] = useState<number | null>(remembered != null && remembered > 0 ? cFromPct(remembered) : null);
  const [dragC, setDragC] = useState<number | null>(null);
  const shownC = dragC ?? pinC;
  const nowC = Math.max(minC, Math.min(99, Math.round(row.contracts > 0 ? (cash / row.contracts) * 100 : minC)));
  const armC = (c: number) => {
    const cc = Math.max(minC, Math.min(99, Math.round(c)));
    const pct = Math.round(pctAtC(cc) * 10) / 10;
    setPinC(cc);
    setDragC(null);
    keepSale(row.ticker, pct);
    void setPinSale({ data: { ticker: row.ticker, ask: cashAtC(cc), pct } });
    toast(`Sells at ${cc}¢ · +${pct}% · $${cashAtC(cc).toFixed(2)}.`);
  };
  const canSlide = entryC > 0 && minC < 99;
  // DOCK LAYOUT (Love, Oct 3 ~6:55 PM PT: "numbers above the slider, not under the percentage boxes... boxes sit flush on
  // the floor... slider a lil less long so they can sit next to each other"). Top: the position line + IN/x/MAX.
  // Bottom row, on the floor: the sale numbers stacked over a shorter slider, then the 25/50/75/100 boxes beside it.
  return (
    <div className="border-t border-white/25 pt-1 first:border-t-0">
      <p className="truncate font-sans text-[12px] leading-[14px] tabular-nums text-white">
        {row.name}
        <span className="px-1 text-white/40">•</span>
        {row.side.toUpperCase()}
        <span className="px-1 text-white/40">•</span>
        <span className={tone}>
          {livePct > 0.5 ? "+" : livePct < -0.5 ? "−" : ""}
          {Math.abs(Math.round(livePct))}%
        </span>
        <span className="px-1 text-white/40">•</span>
        <span className={tone}>${roll >= 20 ? roll.toFixed(0) : roll.toFixed(2)}</span>
        {old ? <span className="pl-1 font-mono text-[9px] text-white/50">SYNCING</span> : null}
      </p>
      <p className="truncate font-mono text-[9px] leading-[11px] tabular-nums text-white/60">
        IN ${row.cost.toFixed(2)} · {mult > 0 ? `${mult.toFixed(2)}x` : "—"} · MAX ${maxCash.toFixed(2)}
      </p>
      <div className="mt-1 flex items-end gap-1.5">
        <div className="mr-1.5 min-w-0 flex-1">
          {canSlide ? (
            <>
              <p className="truncate font-mono text-[10px] leading-[12px] tabular-nums text-white">
                {shownC != null ? (
                  <>
                    <span className="text-white/60">SELL </span>
                    {shownC}¢ · <span className="text-up">+{pctAtC(shownC).toFixed(1)}%</span> · ${cashAtC(shownC).toFixed(2)}
                  </>
                ) : (
                  <span className="text-white/60">SLIDE TO SET A SALE</span>
                )}
              </p>
              <input
                type="range"
                min={minC}
                max={99}
                step={1}
                value={shownC ?? nowC}
                onPointerDown={() => {
                  slideAt.current = Date.now();
                }}
                onInput={(e) => {
                  slideAt.current = Date.now();
                  setDragC(Number(e.currentTarget.value));
                }}
                onChange={(e) => setDragC(Number(e.currentTarget.value))}
                onPointerUp={(e) => {
                  slideAt.current = Date.now();
                  armC(dragC ?? Number(e.currentTarget.value));
                }}
                onKeyUp={() => {
                  if (dragC != null) armC(dragC);
                }}
                aria-label="Sell at this price"
                className="glass-range mt-0.5 block h-4 w-full cursor-pointer"
                style={{ touchAction: "none" }}
              />
            </>
          ) : null}
        </div>
        {/* Love, Oct 3: sell a share right from the dock, no tab switching. 100% = CLOSE. */}
        {[25, 50, 75].map((p) => (
          <button key={p} type="button" style={btn} className="h-7 w-[44px] shrink-0 rounded-[5px] bg-black font-mono text-[10px] leading-none text-white" onClick={() => onPart(p)}>
            {armedSell === String(p) ? "AGAIN" : `${p}%`}
          </button>
        ))}
        <button type="button" style={btn} className="h-7 w-[48px] shrink-0 rounded-[5px] bg-black font-mono text-[10px] leading-none text-white" onClick={onClose}>
          {armedSell === "close" ? "AGAIN" : "100%"}
        </button>
      </div>
    </div>
  );
}

