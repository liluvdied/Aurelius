import { useMemo as useShiftMemo, useState as useShiftState } from "react";
import type { FillEvent as ShiftFill } from "@/lib/desk/fill-log";
import type { HeldOrder as ShiftHeld } from "@/lib/desk/fns";
// one shared Pacific formatter for the inline trade lists (building one per row is what made Safari reload, Oct 11)
const INLINE_FMT = new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });

// SHIFT — the book that starts when Claude took over the desk.
// Kalshi live only. One row per 15-minute window. Pure black; light comes only from lines and numbers.

const SHIFT_UP = "#3ddc84";
const SHIFT_DOWN = "#ff5c5c";

type ShiftRow = { ticker: string; at: string; asset: string; side: string; setup: string; stake: number; multiple: number; pnl: number };

// A 15-minute window is over once its close time passes, even before Kalshi posts the result (Love, Oct 3).
function windowDone(ticker: string): boolean {
  const m = ticker.match(/-(\d\d)([A-Z]{3})(\d\d)(\d\d)(\d\d)/);
  if (!m) return false;
  const mon = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"].indexOf(m[2]);
  if (mon < 0) return false;
  const off = mon >= 2 && mon <= 9 ? 4 : 5;
  return Date.now() >= Date.UTC(2000 + Number(m[1]), mon, Number(m[3]), Number(m[4]) + off, Number(m[5]));
}
function shiftClock(at: string) {
  return new Date(at).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true });
}
function shiftDay(at: string) {
  return new Date(at).toLocaleDateString("en-US", { month: "short", day: "numeric" }).toUpperCase();
}
function shiftMoney(n: number) {
  const s = `$${Math.abs(n).toFixed(2)}`;
  return n > 0.004 ? `+${s}` : n < -0.004 ? `−${s}` : s;
}
const shiftGlow = (color: string, px = 10) => ({ textShadow: `0 0 ${px}px ${color}` });

function ShiftChip({ label, value, tone }: { label: string; value: string; tone?: "up" | "down" }) {
  const color = tone === "up" ? SHIFT_UP : tone === "down" ? SHIFT_DOWN : "#ffffff";
  return (
    <div className="flex min-w-[96px] flex-1 flex-col items-center gap-1 rounded-full border border-white/25 px-4 py-2 shadow-[0_0_14px_rgba(255,255,255,0.08)]">
      <span className="text-[9px] tracking-[0.24em] text-white/70">{label}</span>
      <span className="font-mono text-sm tabular-nums" style={{ color, ...shiftGlow(color, 8) }}>
        {value}
      </span>
    </div>
  );
}

function shiftSym(row: { asset?: string; ticker?: string }) {
  const a = String(row.asset || row.ticker || "");
  if (/^KXMVE/i.test(a)) return "COMBO";
  if (/^KX/i.test(a)) return a.replace(/^KX/i, "").replace(/(15M|D)?-.*$/i, "").toUpperCase();
  return a.toUpperCase();
}
function ShiftCurve({ rows }: { rows: ShiftRow[] }) {
  // SHIFT CURVE (Love, Oct 4 ~12:40 AM PT: "it has whatever the last card opened stuck there... some dots are blocked by
  // the card... make the dots smaller and a tiny bit bigger when you hover... make the line white and remove the dotted
  // line"). Hover now follows the nearest dot to the pointer (no tiny targets to hit), the card sits next to that dot and
  // never over it, and it clears when the pointer leaves (or 2.5 s after a tap on a phone).
  const [hover, setHover] = useShiftState<number | null>(null);
  // Oct 12 (Love: "4h - 12 - 24h - 1 week - & all buttons to view the chart in those timeframes"): the curve restarts at
  // $0 at the start of the chosen window, so RUN on a dot is what that window has made up to that trade.
  const [range, setRange] = useShiftState<"4H" | "12H" | "24H" | "1W" | "ALL">("ALL");
  const boxRef = useRef<HTMLDivElement>(null);
  const clearRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const W = 640;
  const H = 200;
  const P = 18;
  const view = useShiftMemo(() => {
    const ms = { "4H": 4, "12H": 12, "24H": 24, "1W": 168, ALL: 0 }[range] * 3600 * 1000;
    if (!ms) return rows;
    const from = Date.now() - ms;
    return rows.filter((r) => Date.parse(r.at) >= from);
  }, [rows, range]);
  const pts = useShiftMemo(() => {
    let run = 0;
    const out: { x: number; y: number; row: ShiftRow | null }[] = [{ x: 0, y: 0, row: null }];
    view.forEach((row, i) => {
      run += row.pnl;
      out.push({ x: i + 1, y: Math.round(run * 100) / 100, row });
    });
    return out;
  }, [view]);
  const ys = pts.map((p) => p.y);
  const lo = Math.min(0, ...ys);
  const hi = Math.max(0, ...ys);
  const span = hi - lo || 1;
  const sx = (x: number) => P + (x / Math.max(1, pts.length - 1)) * (W - 2 * P);
  const sy = (y: number) => H - P - ((y - lo) / span) * (H - 2 * P);
  const path = pts.map((p, i) => `${i ? "L" : "M"}${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join(" ");
  const nearest = (clientX: number) => {
    const el = boxRef.current;
    if (!el || pts.length < 2) return null;
    const r = el.getBoundingClientRect();
    const fx = ((clientX - r.left) / r.width) * W;
    let best = 1;
    let bd = Infinity;
    for (let i = 1; i < pts.length; i++) {
      const d = Math.abs(sx(pts[i].x) - fx);
      if (d < bd) {
        bd = d;
        best = i;
      }
    }
    return best;
  };
  const pick = (clientX: number) => {
    if (clearRef.current) clearTimeout(clearRef.current);
    setHover(nearest(clientX));
  };
  const h = hover != null ? pts[hover] : null;
  const hx = h ? (sx(h.x) / W) * 100 : 0;
  const hy = h ? (sy(h.y) / H) * 100 : 0;
  const runEnd = pts.length ? pts[pts.length - 1].y : 0;
  return (
    <div>
    <div className="mb-1.5 flex items-center justify-end gap-1.5">
      {/* Oct 12 (Love: "her labels stick... the card blocks them... just the symbol, the date and time and the P&L"): the
          readout sits up here, never over the dots. */}
      {h?.row ? (
        <span className="mr-auto font-mono text-[10px] tabular-nums tracking-[0.08em]">
          <span className="text-white/80">{shiftSym(h.row)} · {shiftDay(h.row.at)} · {shiftClock(h.row.at)} · </span>
          <span style={{ color: h.row.pnl >= 0 ? SHIFT_UP : SHIFT_DOWN }}>{shiftMoney(h.row.pnl)}</span>
        </span>
      ) : (
        <span className="mr-auto font-mono text-[10px] tabular-nums" style={{ color: runEnd >= 0 ? SHIFT_UP : SHIFT_DOWN }}>
          {range === "ALL" ? "" : `${range} · ${shiftMoney(runEnd)} · ${view.length} trades`}
        </span>
      )}
      {(["4H", "12H", "24H", "1W", "ALL"] as const).map((k) => (
        <button
          key={k}
          type="button"
          onClick={() => { setRange(k); setHover(null); }}
          className="rounded-full border px-2.5 py-0.5 font-mono text-[9px] tracking-[0.15em]"
          style={{ borderColor: range === k ? SHIFT_UP : "rgba(255,255,255,0.3)", color: range === k ? SHIFT_UP : "rgba(255,255,255,0.7)" }}
        >
          {k}
        </button>
      ))}
    </div>
    <div
      ref={boxRef}
      className="relative touch-pan-y select-none"
      onMouseMove={(e) => pick(e.clientX)}
      onMouseLeave={() => setHover(null)}
      onTouchStart={(e) => pick(e.touches[0].clientX)}
      onTouchMove={(e) => pick(e.touches[0].clientX)}
      onTouchEnd={() => {
        if (clearRef.current) clearTimeout(clearRef.current);
        clearRef.current = setTimeout(() => setHover(null), 2500);
      }}
    >
      <svg viewBox={`0 0 ${W} ${H}`} className="h-[200px] w-full" preserveAspectRatio="none">
        <defs>
          <filter id="shift-shiftGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="b" />
            <feMerge>
              <feMergeNode in="b" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <path d={path} fill="none" stroke="#ffffff" strokeWidth="1.6" filter="url(#shift-shiftGlow)" vectorEffect="non-scaling-stroke" strokeLinejoin="round" />
      </svg>
      {pts.map((p, i) => {
        if (i === 0) return null;
        const c = (p.row?.pnl ?? 0) >= 0 ? SHIFT_UP : SHIFT_DOWN;
        const on = hover === i;
        return (
          <span
            key={i}
            className="pointer-events-none absolute -translate-x-1/2 -translate-y-1/2 rounded-full transition-[width,height] duration-150"
            style={{
              left: `${(sx(p.x) / W) * 100}%`,
              top: `${(sy(p.y) / H) * 100}%`,
              width: on ? 10 : 4,
              height: on ? 10 : 4,
              background: c,
              boxShadow: on ? `0 0 10px ${c}` : undefined,
              zIndex: on ? 2 : 1,
            }}
          />
        );
      })}
    </div>
    </div>
  );
}

