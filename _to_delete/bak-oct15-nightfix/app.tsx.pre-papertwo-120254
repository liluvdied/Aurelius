// LOTTO LAB: $5 out-of-band tickets, 3x-20x, scored five ways on real Kalshi bids. Paper only.
function LottoCard({ rows }: { rows: ShiftLotto[] }) {
  const done = rows.filter((r) => r.result !== "open" && r.profits);
  const rules = ["+50", "+100", "+200", "+300", "hold"];
  const score = rules.map((k) => {
    const pnl = done.reduce((t, r) => t + (r.profits?.[k] ?? 0), 0);
    const wins = done.filter((r) => (r.profits?.[k] ?? 0) > 0).length;
    return { k, pnl, wins };
  });
  const best = done.length ? score.reduce((b, x) => (x.pnl > b.pnl ? x : b), score[0]) : null;
  return (
    <section className="rounded-[22px] border border-white/20 px-5 py-4 shadow-[0_0_18px_rgba(255,255,255,0.05)]">
      <div className="flex items-baseline justify-between gap-3">
        <p className="text-[10px] tracking-[0.28em] text-white/85">LOTTO LAB · OUT OF BAND</p>
        <p className="text-[9px] tracking-[0.2em] text-white/50">PAPER ONLY · $5 · 3x–20x · FADE 2σ+</p>
      </div>
      <div className="mt-3 flex flex-wrap gap-2">
        <ShiftChip label="TICKETS" value={`${rows.length}${rows.length - done.length ? ` · ${rows.length - done.length} OPEN` : ""}`} />
        {score.map((x) => (
          <ShiftChip
            key={x.k}
            label={`${x.k === "hold" ? "HOLD TO BELL" : `SELL AT ${x.k}%`}${best && best.k === x.k ? " ★" : ""}`}
            value={done.length ? `${shiftMoney(x.pnl)} · ${x.wins}/${done.length}` : "—"}
            tone={done.length ? (x.pnl >= 0 ? "up" : "down") : undefined}
          />
        ))}
      </div>
      <div className="mt-3 flex flex-col gap-1.5">
        {rows.slice(0, 8).map((r) => {
          const p = best && r.profits ? r.profits[best.k] : null;
          const c = p == null ? "#ffffff" : p >= 0 ? SHIFT_UP : SHIFT_DOWN;
          return (
            <div key={r.id} className="flex items-center justify-between gap-3 rounded-full border border-white/15 px-4 py-1.5">
              <span className="text-[10px] tracking-[0.16em] text-white/85">
                {shiftClock(r.at)} · {r.asset.toUpperCase()} {r.side === "up" ? "LONG" : "SHORT"} · {r.sigma > 0 ? "+" : ""}{Number(r.sigma).toFixed(1)}σ · {Number(r.multiple).toFixed(1)}x
              </span>
              <span className="font-mono text-[11px] tabular-nums" style={{ color: c }}>
                PEAK {r.peakPct > 0 ? "+" : ""}{r.peakPct}%{r.result === "open" ? " · OPEN" : p != null ? ` · ${shiftMoney(p)}` : ""}
              </span>
            </div>
          );
        })}
        {!rows.length ? <p className="py-2 text-center text-[10px] tracking-[0.22em] text-white/55">WAITING FOR PRICE TO LEAVE THE BANDS</p> : null}
      </div>
    </section>
  );
}

