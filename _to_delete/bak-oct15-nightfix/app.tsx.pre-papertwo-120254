      {Object.entries(((benchQ.data as any)?.benched ?? {}) as Record<string, { until: string }>).map(([bk, b]) => (
        <button key={bk} type="button" disabled={busy} title="Lift this bench now"
          onClick={async () => { setBusy(true); try { await setBench({ data: { book: bk, until: b.until } }); await benchQ.refetch(); } finally { setBusy(false); } }}
          className="rounded-full px-2.5 py-0.5 font-mono text-[9px] tracking-[0.12em]" style={{ border: "1px solid #ff5c5c", color: "#ff5c5c" }}>
          {bk.toUpperCase()} BENCHED TIL {new Date(b.until).toLocaleTimeString("en-US", { timeZone: "America/Los_Angeles", hour: "numeric", minute: "2-digit" })} · LIFT
        </button>
      ))}
      <button type="button" disabled={busy} title="ON: a bounce off a band is an entry and a rejection blocks the opposite trade. OFF: her plain band / break entries."
        onClick={async () => { setBusy(true); try { await setLineupMode({ data: { mode: bounce === "on" ? "bounce:off" : "bounce:on" } }); await q.refetch(); } finally { setBusy(false); } }}
        className="ml-auto rounded-full px-2.5 py-0.5 font-mono text-[9px] tracking-[0.12em]"
        style={bounce === "on" ? { border: "1px solid #ffd479", color: "#000", background: "#ffd479" } : { border: "1px solid rgba(255,255,255,0.3)", color: "rgba(255,255,255,0.7)" }}>
        {bounce === "on" ? "BOUNCE 🛡️ ON" : "BOUNCE OFF · PLAIN BREAKS"}
      </button>
    </div>
  );
}
