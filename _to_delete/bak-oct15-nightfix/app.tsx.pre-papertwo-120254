export function ShiftBook({ fills, start, held, shadow = [], lotto = [], night = [], bt = null, paperStake = 50, whatIf, truth = null, monitor, rules, onRule, tapes, look: lookIn, card }: { card?: (asset: AssetId) => ReactNode; tapes?: Partial<Record<AssetId, { spark: number[]; spot: number; target: number | null; closeTime?: string }>>; look?: Look; fills: ShiftFill[]; start?: string | null; held: ShiftHeld[]; shadow?: ShiftShadow[]; lotto?: ShiftLotto[]; night?: ShiftNight[]; bt?: ClaudeBt; paperStake?: number; whatIf?: number; truth?: { at: string | null; rows: (ShiftRow & { exit?: string; manual?: number; fees?: number })[]; open: string[] } | null; monitor?: ShiftMonitor; rules?: ShiftRules; onRule?: (patch: { lockOn?: boolean; channelOn?: boolean; gatesOn?: boolean; asset?: "btc" | "gold" | "silver"; assetOn?: boolean; model?: "original" | "new" }) => void }) {
  const from = start || "2026-10-02T01:58:00.000Z";
  const real = Boolean(truth?.rows?.length);
  // CLOSES: this shift, or every Kalshi window on record (Love: "the full history").
  const [allCloses, setAllCloses] = useState(false);
  const [closeLimit, setCloseLimit] = useState(60);
  const rows = useShiftMemo<ShiftRow[]>(() => {
    // Kalshi truth first: every window rebuilt from Kalshi's own fills + settlements, fees included.
    if (truth?.rows?.length) return truth.rows.filter((r) => r.at >= from).map((r) => ({ ...r }));
    const byTicker = new Map<string, ShiftRow>();
    for (const e of fills) {
      if (e.venue !== "kalshi" || e.kind !== "banked" || e.profit == null || e.at < from) continue;
      const cur = byTicker.get(e.ticker);
      if (cur) {
        cur.pnl += e.profit;
        continue;
      }
      byTicker.set(e.ticker, {
        ticker: e.ticker,
        at: e.at,
        asset: String(e.asset),
        side: String(e.side),
        setup: e.pattern || "",
        stake: Number(e.stake) || 0,
        multiple: Number(e.multiple) || 0,
        pnl: e.profit,
      });
    }
    return [...byTicker.values()].sort((a, b) => a.at.localeCompare(b.at));
  }, [fills, from, truth]);
  const s = useShiftMemo(() => {
    const wins = rows.filter((r) => r.pnl > 0.05);
    const losses = rows.filter((r) => r.pnl < -0.05);
    const pnl = rows.reduce((t, r) => t + r.pnl, 0);
    const avg = (xs: ShiftRow[]) => (xs.length ? xs.reduce((t, r) => t + r.pnl, 0) / xs.length : 0);
    const best = rows.reduce((b, r) => (r.pnl > b ? r.pnl : b), 0);
    const decided = wins.length + losses.length;
    return { pnl, wins: wins.length, losses: losses.length, hit: decided ? (wins.length / decided) * 100 : 0, decided, avgWin: avg(wins), avgLoss: avg(losses), best };
  }, [rows]);
  const pnlColor = s.pnl >= 0 ? SHIFT_UP : SHIFT_DOWN;

  return (
    <div className="flex flex-col gap-4">
      <section className="rounded-[22px] border border-white/30 px-5 pb-5 pt-4 shadow-[0_0_24px_rgba(255,255,255,0.07)]">
        <div className="flex items-start justify-between gap-3">
          <div>
            <p className="text-[11px] tracking-[0.36em] text-white" style={shiftGlow("rgba(255,255,255,0.75)", 8)}>
              SHIFT
            </p>
            <p className="mt-1 text-[9px] tracking-[0.22em] text-white/60">
              SINCE {shiftClock(from)} · {shiftDay(from)} · {real ? "KALSHI TRUTH ✓ · FEES IN" : "KALSHI LIVE"}
            </p>
            {monitor?.status ? (
              <p
                className="mt-2 inline-flex rounded-full border px-2.5 py-0.5 text-[9px] tracking-[0.2em]"
                style={{ borderColor: monitor.status.modelOk ? SHIFT_UP : SHIFT_DOWN, color: monitor.status.modelOk ? SHIFT_UP : SHIFT_DOWN }}
                title={monitor.status.changed?.length ? `Changed: ${monitor.status.changed.join(", ")}` : "Every model file matches the approved fingerprint."}
              >
                {monitor.status.modelOk ? "MODEL ✓ APPROVED" : `MODEL CHANGED · ${(monitor.status.changed ?? []).join(", ")}`}
              </p>
            ) : null}
          </div>
          <p className="whitespace-nowrap font-mono text-[28px] leading-none tabular-nums sm:text-[34px]" style={{ color: pnlColor, ...shiftGlow(pnlColor, 14) }}>
            {shiftMoney(s.pnl)}
          </p>
        </div>
        <div className="mt-4 flex flex-wrap gap-2">
          <ShiftChip label="WINS" value={String(s.wins)} tone="up" />
          <ShiftChip label="LOSSES" value={String(s.losses)} tone="down" />
          <ShiftChip label="HIT RATE" value={s.decided ? `${s.hit.toFixed(0)}%` : "—"} />
          <ShiftChip label="AVG WIN" value={s.wins ? shiftMoney(s.avgWin) : "—"} tone="up" />
          <ShiftChip label="AVG LOSS" value={s.losses ? shiftMoney(s.avgLoss) : "—"} tone="down" />
          <ShiftChip label="BEST" value={s.best > 0 ? shiftMoney(s.best) : "—"} tone="up" />
        </div>
        <div className="mt-4">
          {rows.length ? (
            <ShiftCurve rows={rows} />
          ) : (
            <p className="py-10 text-center text-[10px] tracking-[0.24em] text-white/60">THE FIRST CLOSE DRAWS THE LINE</p>
          )}
        </div>
          {/* LIVE TAPE per open position (Love, Oct 4: "put that chart for whatever we have open positions on... under the chart on
              shift"). Her tape design on the smooth engine, one per open position, right under the SHIFT curve. */}
          {/* Nothing open (Love, Oct 4: "the chart with the animation isn't here on the shift tab"): the BTC card stays up so the
              tape is always on SHIFT; open positions take its place the moment one is on. */}
          {!held.length && card ? (
            <div className="mt-5">
              <p className="mb-2 text-[9px] tracking-[0.18em] text-white/70">NOTHING OPEN · WATCHING BTC</p>
              <div className="text-left">{card("btc")}</div>
            </div>
          ) : null}
          {held.length
            ? (["btc", "gold", "silver"] as AssetId[]).map((asset) => {
                const mine = held.filter((h) => (/GOLD/i.test(h.ticker) ? "gold" : /SILVER/i.test(h.ticker) ? "silver" : "btc") === asset);
                if (!mine.length) return null;
                const LIVE_BOOKS = ["brick", "cotc", "trend", "claude", "brickc", "sole5", "sole5v"];
                const BOOKNAME: Record<string, string> = { brick: "BRICK", brickc: "BRICK · CLEAN", cotc: "COTC", trend: "CLAUDE · TREND", claude: "CLAUDE", sole5: "5M SOLE", sole5v: "5M SOLE · VANTAGE" };
                const t = tapes?.[asset];
                const whole = card ? card(asset) : null;
                return (
