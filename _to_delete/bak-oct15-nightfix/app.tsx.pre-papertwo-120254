// OWN CLOSE LANE (Oct 16, Love: "close at market when i click... no latency pls"): the close goes to its own door (port 8091),
// out of the browser's 6-at-a-time line behind the page's polling. Falls back to the normal path if that door is down.
function fastClose(ticker: string, tapAt?: number): Promise<{ line: string }> {
  const clickAt = Date.now();
  const url = `${window.location.protocol}//${window.location.hostname}:8091/close`;
  return fetch(url, { method: "POST", body: JSON.stringify({ ticker, clickAt, tapAt: tapAt || 0 }), headers: { "Content-Type": "text/plain" } })
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
    .catch(() => closeNow({ data: { ticker, clickAt } }));
}

// SCROLL ANCHOR (Love, Oct 5 ~1:15 PM PT: "the page keeps jumping up and down"). Cards above where she is reading grow and
// shrink as trades open and close and numbers refresh; Safari has no built-in scroll anchoring, so the page jumped. This
// holds whatever she is looking at in place: it remembers an element near the top of the view and, whenever the page's
// content changes, scrolls by exactly how far that element moved. Native anchoring is switched off so the two never fight.
function useScrollAnchor(ref: { current: HTMLDivElement | null }) {
  useEffect(() => {
    const el = ref.current;
    if (!el || typeof ResizeObserver === "undefined") return;
    el.style.overflowAnchor = "none";
    let anchor: Element | null = null;
    let anchorTop = 0;
    let fixing = false;
    let frame = 0;
    // Her own taps (12H / 24H / ALL, opening a card, a tab) are meant to move things: don't hold the page for 0.7s after one.
    let quietUntil = 0;
    const pick = () => {
      anchor = null;
      if (el.scrollTop < 8) return; // at the very top: nothing to hold
      const box = el.getBoundingClientRect();
      let n = document.elementFromPoint(box.left + box.width / 2, box.top + Math.min(120, box.height / 4));
      // climb off tiny text to a block (a card / row) at least 24px tall
      while (n && n !== el && n.getBoundingClientRect().height < 24) n = n.parentElement;
      if (!n || n === el || !el.contains(n)) return;
      anchor = n;
      anchorTop = n.getBoundingClientRect().top;
    };
    const check = () => {
      frame = 0;
      if (!anchor || !anchor.isConnected || Date.now() < quietUntil) {
        pick();
        return;
      }
      const d = anchor.getBoundingClientRect().top - anchorTop;
      if (Math.abs(d) >= 1) {
        fixing = true;
        el.scrollTop += d;
        anchorTop = anchor.getBoundingClientRect().top;
        requestAnimationFrame(() => {
          fixing = false;
        });
      }
    };
    const soon = () => {
      if (!frame) frame = requestAnimationFrame(check);
    };
    const onScroll = () => {
      if (!fixing) pick();
    };
    const onTap = () => {
      quietUntil = Date.now() + 700;
    };
    el.addEventListener("scroll", onScroll, { passive: true });
    el.addEventListener("pointerdown", onTap, { passive: true });
    el.addEventListener("keydown", onTap);
    const ro = new ResizeObserver(soon);
    const content = el.children;
    for (const c of Array.from(content)) ro.observe(c);
    const mo = new MutationObserver(soon);
    mo.observe(el, { childList: true, subtree: true });
    pick();
    return () => {
      el.removeEventListener("scroll", onScroll);
      el.removeEventListener("pointerdown", onTap);
      el.removeEventListener("keydown", onTap);
      ro.disconnect();
      mo.disconnect();
      if (frame) cancelAnimationFrame(frame);
    };
  }, [ref]);
}

function ticketDollars(row: { result: string; multiple?: number; profit?: number | null }): number | null {
  if (row.result !== "open" && row.profit != null && Number.isFinite(row.profit)) return row.profit;
  if (row.result === "no") return -25;
  if (row.multiple && row.multiple > 1) return Math.round(25 * (row.multiple - 1) * 100) / 100;
  return null;
}

function bookedDollars(row: { result: string; multiple?: number; profit?: number | null }): number | null {
  if (row.result === "open") return null;
  return ticketDollars(row);
}

