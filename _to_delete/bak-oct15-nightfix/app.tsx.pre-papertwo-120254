function BookRoll({
  rows,
}: {
  rows: { asset: string; side: string; setup: string; yes: number; no: number; net: number }[];
}) {
  const [which, setWhich] = useState<"all" | "prime" | "paper">("all");
  const [sort, setSort] = useState<"paying" | "hitting" | "success">("hitting");
  const grouped = useMemo(() => {
    const prime = rows.filter((row) => row.yes >= 2 && row.yes > row.no);
    const primeKeys = new Set(prime.map((row) => `${row.asset}|${row.side}|${row.setup}`));
    const paper = rows.filter((row) => !primeKeys.has(`${row.asset}|${row.side}|${row.setup}`));
    return { all: rows, prime, paper };
  }, [rows]);
  const shown = useMemo(() => {
    const list = grouped[which];
    const hit = (row: { yes: number; no: number }) => {
      const n = row.yes + row.no;
      return n ? row.yes / n : 0;
    };
    return [...list].sort((a, b) => {
      if (sort === "paying") return b.net - a.net || hit(b) - hit(a);
      if (sort === "hitting") return hit(b) - hit(a) || b.yes - a.yes;
      return b.yes - b.no - (a.yes - a.no) || hit(b) - hit(a);
    });
  }, [grouped, which, sort]);
  const totals = useMemo(() => {
    const list = grouped[which];
    const yes = list.reduce((sum, row) => sum + row.yes, 0);
    const no = list.reduce((sum, row) => sum + row.no, 0);
    return { yes, no, hit: yes + no ? Math.round((100 * yes) / (yes + no)) : 0 };
  }, [grouped, which]);
  const pill = (on: boolean) => cn("desk-pill h-6 px-2", on ? "text-fg" : "text-white/45");
  return (
    <section className="px-3 pb-8">
      <div className="flex flex-wrap gap-1">
        <button type="button" className={pill(which === "all")} onClick={() => setWhich("all")}>ALL</button>
        <button type="button" className={pill(which === "prime")} onClick={() => setWhich("prime")}>PRIME</button>
        <button type="button" className={pill(which === "paper")} onClick={() => setWhich("paper")}>PAPER</button>
      </div>
      <div className="mt-2 flex flex-wrap gap-1">
        <button type="button" className={pill(sort === "paying")} onClick={() => setSort("paying")}>HIGHEST PAYING</button>
        <button type="button" className={pill(sort === "hitting")} onClick={() => setSort("hitting")}>HIGHEST HITTING</button>
        <button type="button" className={pill(sort === "success")} onClick={() => setSort("success")}>MOST SUCCESSFUL</button>
      </div>
      <p className="mt-3 text-[12px] text-white/60">
        {shown.length} setups · {totals.yes}-{totals.no} · {totals.hit}%
        {" · "}
        <a className="underline" href="/aurelius-source.zip" download="aurelius-source.zip">app source</a>
      </p>
      <div className="mt-3">
        <table className="w-full text-left text-[12px]">
          <thead>
            <tr className="text-[10px] tracking-[0.14em] text-white/45">
              <th className="pb-2 pr-2 font-medium">SETUP</th>
              <th className="pb-2 pr-2 text-right font-medium">YES-NO</th>
              <th className="pb-2 pr-2 text-right font-medium">HIT</th>
              <th className="pb-2 text-right font-medium">$</th>
            </tr>
          </thead>
          <tbody>
            {shown.map((row) => {
              const n = row.yes + row.no;
              const rate = n ? Math.round((100 * row.yes) / n) : 0;
              return (
                <tr key={`${row.asset}-${row.side}-${row.setup}`} className="border-t border-white/10">
                  <td className="max-w-[14rem] py-2 pr-2">
                    <p className="truncate">{row.setup}</p>
                    <p className="text-[10px] uppercase tracking-wider text-white/40">{row.asset} {row.side}</p>
                  </td>
                  <td className="py-2 pr-2 text-right font-mono tabular-nums">{row.yes}-{row.no}</td>
                  <td className="py-2 pr-2 text-right font-mono tabular-nums">{rate}%</td>
                  <td className={`py-2 text-right font-mono tabular-nums ${row.net < 0 ? "text-down" : "text-up"}`}>{row.net.toFixed(2)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  );
}

function spanLine(rows: { at: string; win: boolean }[], hours: number) {
  const ms = hours ? hours * 3600e3 : 0;
  let hit = 0;
  let lost = 0;
  for (const row of rows) {
    if (ms) {
      const t = Date.parse(row.at);
      if (!Number.isFinite(t) || Date.now() - t > ms) continue;
    }
    if (row.win) hit += 1;
    else lost += 1;
  }
  const n = hit + lost;
  return n ? `${Math.round((hit / n) * 100)}%  ${hit}-${lost}` : "—";
}

function ModeSwitch({
  live,
  paper,
  prime,
  onSubmit,
}: {
  live: "paper" | "prime" | "both";
  paper: { at: string; kind: string; venue: string; profit: number | null; ticker?: string; id?: string }[];
  prime: { at: string; result: string; ticker?: string; id: string }[];
  onSubmit: (only: "paper" | "prime" | "both") => void;
}) {
  const [pick, setPick] = useState<"paper" | "prime" | "both">(live);
  useEffect(() => setPick(live), [live]);
  const rates = useMemo(() => {
    const paperBook = new Map<string, { at: string; win: boolean }>();
    for (const row of paper) {
      if (row.kind !== "banked" || row.venue !== "paper" || row.profit == null) continue;
      const key = row.ticker || row.id || row.at;
      const prev = paperBook.get(key);
      if (!prev || row.at > prev.at) paperBook.set(key, { at: row.at, win: row.profit > 0 });
    }
    const primeBook = prime
      .filter((row) => row.result === "yes" || row.result === "no")
      .map((row) => ({ key: row.ticker || row.id, at: row.at, win: row.result === "yes" }));
    const both = new Map<string, { at: string; win: boolean }>(paperBook);
    for (const row of primeBook) {
      if (!both.has(row.key)) both.set(row.key, { at: row.at, win: row.win });
    }
    const pack = (rows: { at: string; win: boolean }[]) => ({
      h12: spanLine(rows, 12),
      h24: spanLine(rows, 24),
      all: spanLine(rows, 0),
    });
    return {
      paper: pack([...paperBook.values()]),
      prime: pack(primeBook),
      both: pack([...both.values()]),
    };
  }, [paper, prime]);
  const lines = [
    ["PAPER", rates.paper],
    ["PRIME", rates.prime],
    ["BOTH", rates.both],
  ] as const;
  return (
    <section className="flex flex-col gap-4">
      <p className="text-[10px] tracking-[0.18em] text-subtle">TAP A BOOK. SUBMIT LOCKS IT.</p>
      <div className="flex gap-2">
        {(["paper", "prime", "both"] as const).map((key) => (
          <button
            key={key}
            type="button"
            onClick={() => setPick(key)}
            className={cn(
              "h-8 min-w-16 rounded-[3px] border-[0.5px] border-[#4a1020] px-3 text-[10px] tracking-[0.14em]",
              pick === key
                ? "translate-y-px bg-black text-fg shadow-[inset_0_2px_6px_rgba(0,0,0,0.95),inset_0_1px_0_rgba(255,255,255,0.14)]"
                : "bg-transparent text-muted shadow-[0_1px_0_rgba(255,255,255,0.2)]",
            )}
          >
            {key === "both" ? "BOTH" : key.toUpperCase()}
          </button>
        ))}
      </div>
      <button
        type="button"
        onClick={() => onSubmit(pick)}
        className="h-8 w-fit rounded-[3px] border-[0.5px] border-white/70 px-4 text-[10px] tracking-[0.16em] text-fg"
      >
        SUBMIT
      </button>
      <p className="text-sm text-muted">{pick === live ? `Live on ${live}.` : `${live} is live. Submit to switch to ${pick}.`}</p>
      <div className="grid grid-cols-4 gap-y-2 font-mono text-[11px] tabular-nums text-fg">
        <span />
        <span className="text-right text-[10px] tracking-[0.14em] text-subtle">12H</span>
        <span className="text-right text-[10px] tracking-[0.14em] text-subtle">24H</span>
        <span className="text-right text-[10px] tracking-[0.14em] text-subtle">ALL</span>
        {lines.map(([name, row]) => (
          <span key={name} className="contents">
            <span className="text-[10px] tracking-[0.14em] text-subtle">{name}</span>
            <span className="text-right">{row.h12}</span>
            <span className="text-right">{row.h24}</span>
            <span className="text-right">{row.all}</span>
          </span>
        ))}
      </div>
    </section>
  );
}

