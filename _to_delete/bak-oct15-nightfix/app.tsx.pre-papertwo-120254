      setGrokError((s) => ({
        ...s,
        [setup.id]: err instanceof Error ? err.message : "Grok failed",
      }));
    } finally {
      setGrokBusy((s) => ({ ...s, [setup.id]: false }));
      asking.current.delete(setup.id);
    }
  }

