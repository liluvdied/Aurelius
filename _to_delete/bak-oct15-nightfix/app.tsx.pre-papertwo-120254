  );
}

export function PaperTruth({ fills }: { fills: TruthFill[] }) {
  const [all, setAll] = useState(false);
  const live = useMemo(() => kalshiByTrade(fills), [fills]);
  const rows = useMemo(() => {
    const seen = new Set<string>();
    const out: TruthFill[] = [];
    for (const r of [...fills].sort((a, b) => b.at.localeCompare(a.at))) {
      if (r.venue !== "paper" || r.kind !== "banked" || r.profit == null || seen.has(r.tradeId)) continue;
      seen.add(r.tradeId);
      out.push(r);
    }
    return out;
  }, [fills]);
  const today = rows.filter((r) => Date.now() - Date.parse(r.at) < 24 * 3600e3);
  const w = today.filter((r) => (r.profit ?? 0) > 0).length;
  const l = today.filter((r) => (r.profit ?? 0) < 0).length;
  const pnl = today.reduce((t, r) => t + (r.profit ?? 0), 0);
  const both = today.filter((r) => live.has(`${r.ticker}|${r.side}`));
  const paperOnBoth = both.reduce((t, r) => t + (r.profit ?? 0), 0);
  const liveOnBoth = both.reduce((t, r) => t + (live.get(`${r.ticker}|${r.side}`) ?? 0), 0);
  return (
    <div className="flex flex-col gap-3">
      <TruthHeader
        title="PAPER · THE REAL LEDGER"
        sub="LAST 24 HOURS · EVERY TRADE, REAL STAKE, NOTHING HIDDEN"
        chips={[
          { label: "RECORD", value: `${w}-${l}` },
          { label: "PAPER P&L", value: shiftMoney(pnl), tone: pnl >= 0 ? "up" : "down" },
          { label: "ALSO ON KALSHI", value: String(both.length) },
          { label: "PAPER ON THOSE", value: shiftMoney(paperOnBoth), tone: paperOnBoth >= 0 ? "up" : "down" },
          { label: "KALSHI ON THOSE", value: shiftMoney(liveOnBoth), tone: liveOnBoth >= 0 ? "up" : "down" },
        ]}
      />
      <div className="flex flex-col gap-1.5">
        {(all ? rows : rows.slice(0, 12)).map((r) => {
          const k = `${r.ticker}|${r.side}`;
          return (
            <TruthRow
              key={r.tradeId}
              when={`${shiftClock(r.at)} · $${Number(r.stake).toFixed(0)} PAPER`}
              asset={r.asset}
              side={r.side}
              setup={r.pattern || ""}
              left={r.profit}
              right={live.has(k) ? (live.get(k) ?? 0) : "none"}
            />
          );
        })}
      </div>
      {rows.length > 12 ? (
        <button type="button" onClick={() => setAll((v) => !v)} className="self-center rounded-full border border-white/30 px-4 py-1.5 text-[10px] tracking-[0.22em] text-white/80">
          {all ? "SHOW LESS" : `SHOW ALL ${rows.length}`}
        </button>
      ) : null}
    </div>
  );
}

type TruthPrime = { id: string; at: string; asset: string; side: string; pattern: string; result: string; ticker?: string; multiple?: number; live?: string };

type TruthRecords = { honest: { yes: number; no: number }; forty: { yes: number; no: number }; fortyOn: boolean };

