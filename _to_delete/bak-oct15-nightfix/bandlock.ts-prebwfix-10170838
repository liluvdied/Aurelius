/** The gate's own rule: may an order on `side` go out with price `tick` and these bands? */
export function gateAllows(L: Line[], tick: number, side: string): boolean {
  const ns = nearSide(L, tick);
  return !!ns && (!ns.side || ns.side === side);
}
