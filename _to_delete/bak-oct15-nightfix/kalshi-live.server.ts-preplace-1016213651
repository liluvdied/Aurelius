  if (!best) {
    try { await kalshi("DELETE", `/trade-api/v2/communications/rfqs/${rfqId}`); } catch {}
    const nb = Math.max(0, ...out.quotes.map((q: any) => q.no_bid || 0));
    out.bestAny = nb > 0 ? 1 - nb : null;
    out.result = `no quote at or under ${Math.round(maxPx * 100)}c (best ${out.bestAny != null ? Math.round(out.bestAny * 1000) / 10 + "c" : "none"})`;
    log();
    return out;
  }
  out.quote = best;
  // MAKER CONFIRM (Oct 12 ~10 PM PT): the first live accept (ZEC+NATGAS at 82c) came back 204 but the maker hadn't confirmed
  // after 12 s, and we cancelled the RFQ right then, which may have killed it. Now: wait up to 25 s per accept, reading her
  // position AND the quote's own status. If that maker clearly backs out (cancelled/expired/rejected), try the next-best
  // quote still under the ceiling (3 at most). If the status is unclear, stop: never stack a second accept on a pending one.
  const cands = out.quotes.filter((q: any) => q.no_bid > 0 && 1 - q.no_bid <= maxPx).sort((a: any, b: any) => b.no_bid - a.no_bid).slice(0, 3);
  const before = await held();
  let after = before;
  out.confirm = [];
  for (const c of cands) {
    const px = Math.round((1 - c.no_bid) * 10000) / 10000;
    let okAcc = false;
    try {
      const r = await kalshi("PUT", `/trade-api/v2/communications/rfqs/${rfqId}/quotes/${c.id}/accept`, "", { accepted_side: "no" });
      const txt = await r.text();
      out.tries.push({ side: "no", quote: c.id, px, status: r.status, resp: txt.slice(0, 200) });
      okAcc = r.ok;
    } catch (e) { out.tries.push({ side: "no", quote: c.id, error: String(e).slice(0, 120) }); }
    if (!okAcc) continue;
    out.acceptedSide = "no"; out.quote = { id: c.id, px, clean: c.clean };
    let qs = "";
    for (let i = 0; i < 25; i++) {
      await new Promise((r) => setTimeout(r, 1000));
      after = await held();
      if (Number.isFinite(after) && Math.abs(after - before) > 0.01) break;
      if (i % 3 === 2) { try { const r = await kalshi("GET", `/trade-api/v2/communications/quotes/${c.id}`); const j: any = await r.json().catch(() => null); qs = String(j?.quote?.status ?? j?.status ?? qs); } catch {} }
      if (/cancel|expire|reject|decline/i.test(qs)) break;
    }
    out.confirm.push({ quote: c.id, px, status: qs || "unknown", filled: Number.isFinite(after) && Math.abs(after - before) > 0.01 });
    if (Number.isFinite(after) && Math.abs(after - before) > 0.01) break;
    if (!/cancel|expire|reject|decline/i.test(qs)) break;
  }
  // TOP-UP (Oct 13 ~1:55 AM PT, Love: "make sure they're going out at $20"): contracts are sized at the CEILING, so a fill under
  // it spends less ($16.88 at 40.5c on a 48c ceiling). After a real fill, whatever is left of the dollars is asked for once
  // more on the same combo, at no more than the ceiling and never past the dollars + 5%.
  if (Number.isFinite(after) && after > before + 0.01 && !opts.noTopUp) {
    const spent = (after - before) * out.quote.px;
    const left = dollars - spent;
    if (left >= 2) {
      try {
        const n2 = Math.floor((left / out.quote.px) * 100) / 100;
        const r0 = await kalshi("POST", "/trade-api/v2/communications/rfqs", "", { market_ticker: out.ticker, contracts_fp: n2.toFixed(2), rest_remainder: false });
        let id2 = ""; try { id2 = JSON.parse(await r0.text())?.id || ""; } catch {}
        out.topUp = { want: n2, rfq: !!id2 };
        if (id2) {
          let uid2 = "";
          try { const r = await kalshi("GET", `/trade-api/v2/communications/rfqs/${id2}`); uid2 = (await r.json())?.rfq?.creator_user_id || ""; } catch {}
          let b2: any = null;
          for (let i = 0; i < 5 && !b2; i++) {
            await new Promise((r) => setTimeout(r, 900));
            try {
              const r = await kalshi("GET", "/trade-api/v2/communications/quotes", `?rfq_id=${encodeURIComponent(id2)}&rfq_creator_user_id=${encodeURIComponent(uid2)}`);
              const j = await r.json().catch(() => null);
              for (const q of j?.quotes ?? []) {
                if (q.status && q.status !== "open") continue;
                const nb = Number.parseFloat(q.no_bid_dollars ?? "0"), px = 1 - nb;
                if (nb > 0 && px <= maxPx && n2 * px <= left * 1.05 && (!b2 || px < b2.px)) b2 = { id: q.id, px };
              }
            } catch {}
          }
          if (b2) {
            const mid = after;
            try { const r = await kalshi("PUT", `/trade-api/v2/communications/rfqs/${id2}/quotes/${b2.id}/accept`, "", { accepted_side: "no" }); out.topUp.accept = r.status; } catch {}
            for (let i = 0; i < 20; i++) { await new Promise((r) => setTimeout(r, 1000)); const h = await held(); if (Number.isFinite(h) && Math.abs(h - mid) > 0.01) { after = h; break; } }
            out.topUp.px = b2.px; out.topUp.got = Math.round((after - mid) * 100) / 100;
          }
          if (!(after > before + 0.01 && out.topUp.got > 0)) { try { await kalshi("DELETE", `/trade-api/v2/communications/rfqs/${id2}`); } catch {} }
        }
      } catch (e) { out.topUp = { error: String(e).slice(0, 120) }; }
    }
  }
  out.before = before; out.after = after;
  if (Number.isFinite(after) && after < before - 0.01) out.result = `WRONG WAY: position went ${before} -> ${after}`;
  else if (Number.isFinite(after) && after > before + 0.01) out.result = `bought ${Math.round((after - before) * 100) / 100} YES at ${out.topUp?.got > 0 ? Math.round((((after - before - out.topUp.got) * out.quote.px + out.topUp.got * out.topUp.px) / (after - before)) * 10000) / 10000 : out.quote.px}`;
  else if (Number.isFinite(after) && after < before - 0.01) out.result = `WRONG WAY: position went ${before} -> ${after}`;
  else out.result = out.acceptedSide ? `accepted, maker did not confirm (${out.confirm.map((x: any) => `${Math.round(x.px * 1000) / 10}c ${x.status}`).join(", ")})` : `Kalshi refused the accept (${out.tries.map((t: any) => t.status).join("/")})`;
  if (!(after > before + 0.01)) { try { await kalshi("DELETE", `/trade-api/v2/communications/rfqs/${rfqId}`); } catch {} }
  log();
  return out;
}

// COMBO TEST · $1 (Claude, Oct 12 ~9:55 PM PT, Love: "have her try to place one on whatever is available for $1 as a test").
// Runs ONLY from her tap on the SCANNER tab. Picks the next 15M window with 4 to 12 minutes left, takes the 2-3 strongest
// favorites among legs Kalshi is offering in combos (60c to 95c each, no palladium/platinum), and buys the combo for about
// $1 at the best real maker price up to 95c. The point is to prove a real combo fill end to end, not to make money.
async function comboTest(dollars = 1) {
  const fs = await import("node:fs");
  const path = await import("node:path");
  const D = (f: string) => path.join(process.cwd(), "data", f);
  let cs: any = {};
  try { cs = JSON.parse(fs.readFileSync(D("combos-status.json"), "utf8")); } catch {}
  const ev = await comboEvents();
  const now = Date.now();
  const byClose = new Map<string, any[]>();
  for (const m of cs?.markets ?? []) {
    const t = String(m.t || "");
    if (!/^KX[A-Z]+15M-/.test(t) || /PALLADIUM|PLATINUM/.test(t)) continue;
    const left = (Date.parse(m.close) - now) / 1000;
    if (!(left >= 240 && left <= 720)) continue;
    const ya = Number(m.ya), na = Number(m.na);
    const side = ya >= na ? "yes" : "no", ask = Math.max(ya, na);
    if (!(ask >= 0.6 && ask <= 0.95)) continue;
    const event_ticker = t.replace(/-[^-]+$/, "");
    if (ev && !ev.has(event_ticker)) continue;
    const arr = byClose.get(m.close) ?? [];
    arr.push({ market_ticker: t, event_ticker, side, ask });
    byClose.set(m.close, arr);
  }
  const win = [...byClose.entries()].filter(([, a]) => a.length >= 2).sort((a, b) => Date.parse(a[0]) - Date.parse(b[0]))[0];
  if (!win) {
    const out = { at: new Date().toISOString(), tag: "test-$1", result: `no window with 4-12 min left and 2+ combo-eligible favorites right now (${(cs?.markets ?? []).length} markets read, eligible list ${ev ? "read" : "not read"}). Try again in a few minutes.` };
    try { fs.appendFileSync(D("combo-live.jsonl"), JSON.stringify(out) + "\n"); } catch {}
    return out;
  }
  const legs = win[1].sort((a, b) => b.ask - a.ask).slice(0, 3);
  const r: any = await comboBuy(legs, dollars, 0.95, { cap: 0.95, tag: "test-$1" });
  r.paperEst = Math.round(legs.reduce((p, l) => p * l.ask, 1) * 1000) / 1000;
  r.window = win[0];
  return r;
}

