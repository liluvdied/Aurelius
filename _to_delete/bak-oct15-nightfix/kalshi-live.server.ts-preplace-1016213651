// COMBO CASH OUT (Claude, Oct 12 ~6:30 AM PT, Love: "yesss please... let's do that now"). Only ever runs when SHE taps
// SELL NOW -> CONFIRM on a combo row in POSITIONS. Kalshi combos have no order book, so this asks for quotes (RFQ) and
// takes the best one that ONLY bids for her YES (no_bid 0, no NO size offered): on a quote like that the only trade that can
// exist is the maker buying her YES, so the wrong side word cannot fill. Tries "no" first (buy NO against her YES = sell),
// then "yes" if Kalshi rejects it; records which word worked. Refuses quotes below minPx. Checks her position before and
// after: if it ever GROWS, RED alarm. Result: data/rfq-cashout.json (history in data/rfq-cashout.jsonl).
const cr2 = (n: number) => Math.round(n * 100) / 100;
async function rfqCashOut(ticker: string, minPx: number, first: "yes" | "no" = "no", qty?: number) {
  const fs = await import("node:fs");
  const path = await import("node:path");
  const F = (f: string) => path.join(process.cwd(), "data", f);
  const out: any = { at: new Date().toISOString(), ticker, minPx, quotes: [], tries: [] };
  const held = async () => { try { const rows = await allPositions(); const r = rows.find((x: any) => x.ticker === ticker); return r ? r.pos : 0; } catch { return NaN; } };
  const save = () => { try { fs.writeFileSync(F("rfq-cashout.json"), JSON.stringify(out, null, 1)); fs.appendFileSync(F("rfq-cashout.jsonl"), JSON.stringify(out) + "\n"); } catch {} };
  const before = await held();
  out.before = before;
  if (!(before > 0.01)) { out.result = "no YES position held"; save(); return out; }
  // qty (Oct 12, "half at the arm"): sell only that many; never more than she holds.
  const sellN = qty && qty > 0.01 ? Math.min(before, Math.floor(qty * 100) / 100) : before;
  out.sellN = sellN;
  const res0 = await kalshi("POST", "/trade-api/v2/communications/rfqs", "", { market_ticker: ticker, contracts_fp: sellN.toFixed(2), rest_remainder: false });
  const t0 = await res0.text();
  let rfqId = ""; try { rfqId = JSON.parse(t0)?.id || ""; } catch {}
  out.rfqId = rfqId;
  if (!rfqId) { out.result = `RFQ refused ${res0.status}: ${t0.slice(0, 200)}`; save(); return out; }
  let uid = "";
  try { const r = await kalshi("GET", `/trade-api/v2/communications/rfqs/${rfqId}`); uid = (await r.json())?.rfq?.creator_user_id || ""; } catch {}
  let best: any = null;
  for (let i = 0; i < 8; i++) {
    await new Promise((r) => setTimeout(r, 1000));
    try {
      const r = await kalshi("GET", "/trade-api/v2/communications/quotes", `?rfq_id=${encodeURIComponent(rfqId)}&rfq_creator_user_id=${encodeURIComponent(uid)}`);
      const j = await r.json().catch(() => null);
      for (const q of j?.quotes ?? []) {
        if (q.status && q.status !== "open") continue;
        const yb = Number.parseFloat(q.yes_bid_dollars ?? "0"), nb = Number.parseFloat(q.no_bid_dollars ?? "0");
        const nc = Number.parseFloat(q.no_contracts_fp ?? "0");
        const clean = yb > 0 && !(nb > 0) && !(nc > 0);
        if (!out.quotes.some((x: any) => x.id === q.id)) out.quotes.push({ id: q.id, yes_bid: yb, no_bid: nb, clean });
        if (clean && yb >= minPx && (!best || yb > best.yb)) best = { id: q.id, yb };
      }
    } catch {
    }
    if (best && i >= 2) break;
  }
  if (!best) {
    out.result = `no clean quote at or above ${Math.round(minPx * 1000) / 10}c (best seen ${Math.max(0, ...out.quotes.map((q: any) => q.yes_bid))})`;
    try { await kalshi("DELETE", `/trade-api/v2/communications/rfqs/${rfqId}`); } catch {}
    save();
    return out;
  }
  out.quote = best;
  for (const side of [first, first === "no" ? "yes" : "no"]) {
    try {
      const r = await kalshi("PUT", `/trade-api/v2/communications/rfqs/${rfqId}/quotes/${best.id}/accept`, "", { accepted_side: side });
      const txt = await r.text();
      out.tries.push({ side, status: r.status, resp: txt.slice(0, 300) });
      if (r.ok) { out.acceptedSide = side; break; }
    } catch (e) {
      out.tries.push({ side, error: String(e).slice(0, 200) });
    }
  }
  let after = before;
  for (let i = 0; i < 12 && out.acceptedSide; i++) {
    await new Promise((r) => setTimeout(r, 1000));
    after = await held();
    if (Number.isFinite(after) && Math.abs(after - before) > 0.01) break;
  }
  out.after = after;
  if (Number.isFinite(after) && after > before + 0.01) {
    out.result = `WRONG WAY: position grew ${before} -> ${after}`;
    try { const f = F("alarm.json"); const rows = fs.existsSync(f) ? JSON.parse(fs.readFileSync(f, "utf8")) : []; rows.unshift({ at: new Date().toISOString(), text: `RED: combo cash out on ${ticker} ADDED contracts (${before} -> ${after}) with side "${out.acceptedSide}". Check Kalshi now.` }); fs.writeFileSync(f, JSON.stringify(rows.slice(0, 200))); } catch {}
  } else if (Number.isFinite(after) && after < before - 0.01) {
    out.result = `cashed out ${cr2(before - after)} at ${best.yb} (~$${cr2((before - after) * best.yb)}) with side "${out.acceptedSide}"`;
  } else {
    out.result = out.acceptedSide ? `accepted with side "${out.acceptedSide}", waiting on the maker's confirm (position unchanged so far)` : "Kalshi refused both sides";
  }
  if (!(after < before - 0.01)) { try { await kalshi("DELETE", `/trade-api/v2/communications/rfqs/${rfqId}`); } catch {} }
  save();
  return out;
}

// COMBO BUY QUOTE (Claude, Oct 12 ~1 PM PT, Love: "we can go ahead and have her do those [last-5-min combos] on kalshi now").
// SHADOW ONLY, nothing is bought: builds the real Kalshi combo market for a paper combo's legs, asks market makers for a
// price to BUY it (RFQ), records every quote, and cancels. Answers the one question paper can't: what the combo really
// costs. A quote's no_bid is a maker buying NO = selling YES, so YES costs 1 - no_bid.
// COMBO-ELIGIBLE EVENTS (Claude, Oct 12 ~9:50 PM PT, Love: "keep digging, see why it's giving you invalid parameters").
// The cause: Kalshi's cross-category collection lists exactly which events can sit in a combo right now
// (associated_event_tickers), and that list rolls. A coin's CURRENT 15M window can be missing while its next ones are in
// (at 3:32 PM ET, ETH 3:45 was out while BTC/XRP/HYPE 3:45 were in, and that exact combo came back 400 invalid_parameters).
// So before building a combo: read the list (cached 20 s) and drop any leg Kalshi isn't offering. Paper's price ceiling is
// raised by each dropped leg's own price (same bet, one leg fewer), never past the cap. Under 2 legs left = no combo.
async function comboEvents(): Promise<Set<string> | null> {
  const g: any = globalThis as any;
  if (g.__cbEv && Date.now() - g.__cbEv.at < 20000) return g.__cbEv.set;
  try {
    const r = await kalshi("GET", "/trade-api/v2/multivariate_event_collections/KXMVECROSSCATEGORY-R");
    const j: any = await r.json();
    const c: any = j?.multivariate_contract ?? j?.collection ?? Object.values(j || {}).find((v: any) => v && typeof v === "object" && (v.associated_event_tickers || v.associated_events)) ?? j;
    const list: any[] = c?.associated_event_tickers ?? (c?.associated_events ?? []).map((e: any) => e.ticker);
    if (!Array.isArray(list) || !list.length) return null;
    const set = new Set<string>(list.map(String));
    g.__cbEv = { at: Date.now(), set };
    return set;
  } catch { return null; }
}
async function comboFit(legs: any[], maxPx: number, cap: number) {
  const strip = (l: any) => ({ market_ticker: l.market_ticker, event_ticker: l.event_ticker, side: l.side });
  const ev = await comboEvents();
  if (!ev) return { legs: legs.map(strip), maxPx, dropped: [] as string[], listRead: false };
  const keep = legs.filter((l) => ev.has(l.event_ticker));
  const drop = legs.filter((l) => !ev.has(l.event_ticker));
  let px = maxPx;
  for (const d of drop) { const a = Number(d.ask); if (a > 0 && a < 1) px = px / a; }
  return { legs: keep.map(strip), maxPx: Math.min(cap, px), dropped: drop.map((d) => String(d.event_ticker)), listRead: true };
}

