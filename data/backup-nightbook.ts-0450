/** Paper-only twin books (BRICK · TVC GOLD, Oct 6): one per window, $50, BRICK's exits, never sent live. */
export function twinConsider(book: NightRow["book"], c: { ticker: string; side: "up" | "down"; ask: number; label: string }, asset: "btc" | "gold", bands: Record<string, unknown> | null) {
  if (!c || !(c.ask > 0.02 && c.ask < 0.98)) return;
  const mult = 1 / c.ask;
  const rows = read();
  if (rows.some((r) => r.book === book && r.ticker === c.ticker)) return;
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  rows.unshift({ id: `${c.ticker}:${book}`, book, at: new Date().toISOString(), asset, ticker: c.ticker, side: c.side, setup: c.label, ask: c.ask, multiple: r2(mult), stake: PAPER_STAKE, tpPct: newTp(mult), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands, spot: typeof bands?.spot === "number" ? (bands.spot as number) : null, event: null, hourPT });
  write(rows);
  // Twins go to Kalshi only if their RUN pill is on (BRICK · TVC GOLD, Love Oct 6 ~7:30 AM PT: "throw her on rnrnrn").
  if (TAG === "") fireLive(rows[0]);
}

/** TAP / RESCUE tickets (tap.ts): small paper stakes, one per window per book. */
export function tapConsider(c: { ticker: string; side: "up" | "down"; ask: number; label: string }, asset: "btc" | "gold", kind: "tap" | "rescue" | "snap" | "snap16", bands: Record<string, unknown> | null) {
  if (!(c.ask > 0.01 && c.ask < 0.98)) return;
  const rows = read();
  // SNAP books (Love, Oct 4): one $5 ticket per window per book on a hard band rejection at 4x+, each with its own take profit.
  const books: NightRow["book"][] = kind === "tap" ? ["tap3x", "taphold"] : kind === "snap" ? ["snap50", "snap100", "snap200", "snap300", "snaphold"] : kind === "snap16" ? ["x16_50", "x16_100", "x16_200", "x16_300", "x16hold"] : ["rescue"];
  const SNAP_TP: Record<string, number> = { snap50: 50, snap100: 100, snap200: 200, snap300: 300, snaphold: 0, x16_50: 50, x16_100: 100, x16_200: 200, x16_300: 300, x16hold: 0 };
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  let changed = false;
  for (const book of books) {
    if (rows.some((r) => r.book === book && r.ticker === c.ticker && sameMode(r))) continue;
    const stake = kind === "tap" ? 2.5 : kind === "snap16" ? 20 : 5;
    if ((kind === "snap" || kind === "snap16") && rows.some((r) => r.book === book && r.ticker === c.ticker)) continue;
    rows.unshift({ ...tagMode(), id: `${c.ticker}${TAG ? `:${TAG}` : ""}:${book}`, book, at: new Date().toISOString(), asset, ticker: c.ticker, side: c.side, setup: c.label, ask: c.ask, multiple: r2(1 / c.ask), stake, tpPct: book === "tap3x" ? 200 : kind === "snap" || kind === "snap16" ? SNAP_TP[book] ?? 0 : 0, peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands, spot: typeof bands?.spot === "number" ? (bands.spot as number) : null, event: null, hourPT });
    changed = true;
  }
  if (changed) write(rows);
}

/** SQUEEZE TWIN (Love, Oct 4 ~12:15 PM PT: "if it's being squeezed into a corner like that just have her trade whichever side
 *  breaks... paper book her pls"). squeeze.ts decides; one paper trade per window, $50 ($25 at 3x+), same take-profit table. */
