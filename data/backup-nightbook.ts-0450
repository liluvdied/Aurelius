/** 5M / 10M / 15M SOLE (Love, Oct 3): every desk setup that clears her 25% channel rule on the session bands + ONE nav
 *  frame only. One trade per window per book, $50 ($25 at 3x+), 1.38x+, same take-profit table as NEW. */
export function soleConsider(c: { ticker: string; side: "up" | "down"; ask: number; label: string }, asset: string, book: "sole5" | "sole10" | "sole15" | "sole5p" | "sole5z" | "sole5v") {
  if (!(c.ask > 0.02 && c.ask <= 0.725)) return;
  const rows = read();
  if (rows.some((r) => r.book === book && r.ticker === c.ticker && !r.dnaMode)) return;
  let bands: Record<string, unknown> | null = null;
  try {
    bands = JSON.parse(readFileSync(join(process.cwd(), "data", "bands-now.json"), "utf8"))?.[asset] ?? null;
  } catch {
    bands = null;
  }
  const mult = 1 / c.ask;
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  const row: NightRow = { id: `${c.ticker}:${book}`, book, at: new Date().toISOString(), asset, ticker: c.ticker, side: c.side, setup: c.label, ask: c.ask, multiple: r2(mult), stake: mult >= 3 ? PAPER_STAKE / 2 : PAPER_STAKE, tpPct: newTp(mult), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands, spot: typeof bands?.spot === "number" ? (bands.spot as number) : null, event: null, hourPT };
  rows.unshift(row);
  // BANK · 5M SOLE+ (Love, Oct 5 ~1 AM PT: "lets run a BANK 5M SOLE+ book too... majority of those losses were in profit...
  // if shes just in there runnin shit and gettin out before L's"). SOLE+'s exact entries, BANK's exits: after +30% she sells
  // 5% off the highest bid; a band tap the 1m candle rejects banks it (in profit); else the take profit or the bell. Paper only.
  if (book === "sole5p" && !rows.some((r) => r.book === "bank5p" && r.ticker === c.ticker && !r.dnaMode)) {
    rows.unshift({ ...row, id: `${c.ticker}:bank5p`, book: "bank5p", setup: `${c.label} (SOLE+ entry, BANK exit)` });
  }
  write(rows);
  fireLive(row);
}

/** LAST MINUTE (Love, Oct 3 ~6:10 PM PT: "within minutes of the window ending, on the right side of the target, and
 *  still 1.5-1.37x... lower it to 1.32x for this book... take the set up if she can"). Paper only. One per window per
 *  asset, $50, hard take profit (newTp: 5% under the max when +50% can't be reached). */
export function lastConsider(c: { ticker: string; side: "up" | "down"; ask: number; label: string }, asset: string, book: "lastmin" | "lastgrant" = "lastmin") {
  if (!(c.ask > 0.39 && c.ask < 0.77)) return;
  const rows = read();
  if (rows.some((r) => r.book === book && r.ticker === c.ticker && !r.dnaMode)) return;
  let bands: Record<string, unknown> | null = null;
  try {
    bands = JSON.parse(readFileSync(join(process.cwd(), "data", "bands-now.json"), "utf8"))?.[asset] ?? null;
  } catch {
    bands = null;
  }
  const mult = 1 / c.ask;
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  rows.unshift({ id: `${c.ticker}:${book}`, book, at: new Date().toISOString(), asset, ticker: c.ticker, side: c.side, setup: c.label, ask: c.ask, multiple: r2(mult), stake: PAPER_STAKE, tpPct: newTp(mult), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands, spot: typeof bands?.spot === "number" ? (bands.spot as number) : null, event: null, hourPT });
  write(rows);
}

/** BTC HOURLY (hourly.ts): one trade per hour, $50, hard take profit, else the hour's result. */
export function hourConsider(c: { ticker: string; event: string; side: "up" | "down"; ask: number; label: string }, bands: Record<string, unknown> | null, spot: number) {
  const rows = read();
  if (rows.some((r) => r.book === "hour" && (r.ticker.split("-").slice(0, 2).join("-") === c.event || r.ticker === c.ticker))) return;
  const mult = 1 / c.ask;
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  rows.unshift({ ...tagMode(), id: `${c.ticker}${TAG ? `:${TAG}` : ""}:hour`, book: "hour", at: new Date().toISOString(), asset: "btc", ticker: c.ticker, side: c.side, setup: c.label, ask: c.ask, multiple: r2(mult), stake: mult >= 3 ? PAPER_STAKE / 2 : PAPER_STAKE, tpPct: newTp(mult), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands, spot, event: null, hourPT });
  write(rows);
}
export function hourOpen(): NightRow[] {
  return read().filter((r) => r.book === "hour" && r.result === "open");
}
export function hourSell(id: string, bid: number, pct: number) {
  const rows = read();
  const r = rows.find((x) => x.id === id);
  if (!r || r.result !== "open") return;
  let changed = false;
  if (pct > r.peakPct) {
    r.peakPct = r2(pct);
    changed = true;
  }
  const tpH = paperTp() ?? r.tpPct;
  if (tpH > 0 && pct + 1e-9 >= tpH) {
    r.result = "sold";
    r.soldAt = new Date().toISOString(); // when it sold (Love, Oct 3: learn when the BREAK exit is right)
    r.exit = `take profit +${tpH}%`;
    r.sellBid = bid;
    r.pnl = r2((r.stake / r.ask) * bid - r.stake);
    changed = true;
  }
  if (changed) write(rows);
}

/** GOLDEN (golden.ts): one paper trade per window, $10, on the Oct 1 afternoon model's own setups. */
export function goldenConsider(c: { ticker: string; side: "up" | "down"; ask: number; label: string }, asset: "btc" | "gold", bands: Record<string, unknown> | null, book: "golden" | "optA" = "golden") {
  if (!c || !(c.ask > 0.02 && c.ask < 0.98)) return;
  const mult = 1 / c.ask;
  if (mult < 1.38) return;
  const rows = read();
  if (rows.some((r) => r.book === book && r.ticker === c.ticker && sameMode(r))) return;
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  setTimeout(() => brkAlso(c, asset, bands), 0);
  rows.unshift({ ...tagMode(), id: `${c.ticker}${TAG ? `:${TAG}` : ""}:${book}`, book, at: new Date().toISOString(), asset, ticker: c.ticker, side: c.side, setup: c.label, ask: c.ask, multiple: r2(mult), stake: book === "optA" && mult >= 3 ? PAPER_STAKE / 2 : PAPER_STAKE, tpPct: book === "optA" ? newTp(mult) : originalTp(mult), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands, spot: typeof bands?.spot === "number" ? (bands.spot as number) : null, event: null, hourPT });
  write(rows);
}

/** Every tick: real bids → take profit (both books), LOCK THE WIN (new book only). */
// PAPER TAKE PROFIT (Love, Oct 3 ~1:45 PM PT: "raise that in the settings up to 200%... the gate is costing us the
// whole thing"). data/paper-exit.json { tpPct }: when set, every paper book (not taps / BANK) uses this one hard take
// profit instead of its own table, and the paper gates + LOCK THE WIN stand down. Above a trade's max = held to the bell.
export function paperTp(): number | null {
  try {
    const v = Number(JSON.parse(readFileSync(join(process.cwd(), "data", "paper-exit.json"), "utf8")).tpPct);
    return v > 0 ? v : null;
  } catch {
    return null;
  }
}
function clearFor(id: string): number {
  const gc = g as unknown as { __clearAt?: number; __clear?: Record<string, number> };
  if (!gc.__clear || Date.now() - (gc.__clearAt || 0) > 10000) {
    gc.__clearAt = Date.now();
    try {
      const c = JSON.parse(readFileSync(join(process.cwd(), "data", "live-switch.json"), "utf8"))?.lockWin?.clear;
      gc.__clear = { gold: Number(c?.gold) > 0 ? Number(c.gold) : 1.5, btc: Number(c?.btc) > 0 ? Number(c.btc) : 100 };
    } catch {
      gc.__clear = gc.__clear || { gold: 1.5, btc: 100 };
    }
  }
  return gc.__clear[id] ?? 0;
}
/** Kalshi's fee on one fill that takes the book: 7% x contracts x price x (1 - price), rounded up to the cent. */
function kfee(contracts: number, price: number) {
  return Math.ceil(0.07 * contracts * price * (1 - price) * 100 - 1e-9) / 100;
}
const FEE_BOOKS = new Set(["brickcf", "brickcm"]);

// BTC RE-ENTRY (Claude, Oct 8 ~3:35 AM PT, Love: "if she ever exits a position early like that (justly), she's clear to re
// enter into the same position when the next window starts, more time for it to follow through" / "yesss let's do that").
// Re-entry lab (scripts/reentry-lab.py, Oct 4-8): taking the same side at the start of the next window after a lock / gate
// exit won 57% on BTC (+$275 on 153 at $30 after fees; +$172 on the 54 where the exit was right) and 48% on gold (-$419),
// so BTC only. When the book that owned last window (first of the RUN books to fire there) sold it on LOCK THE WIN or a
// TAKE-PROFIT GATE, this paper book buys the same side in the first 2 minutes of the new window. Exits: the same as the
// live books (90% of the max + trail, gates, lock the win; Love ~3:55 AM: "she doesn't need to hold to the bell").
// Paper only: "reent" is never on RUN, so nothing reaches Kalshi.
const MONS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
function windowClose(ticker: string): number | null {
  const m = /-(\d\d)([A-Z]{3})(\d\d)(\d\d)(\d\d)/.exec(ticker);
  if (!m || MONS.indexOf(m[2]) < 0) return null;
  const guess = Date.UTC(2000 + Number(m[1]), MONS.indexOf(m[2]), Number(m[3]), Number(m[4]) + 4, Number(m[5]));
  const nyHour = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", hour: "2-digit", hourCycle: "h23" }).format(new Date(guess)));
  return nyHour === Number(m[4]) ? guess : guess + 3600 * 1000;
}
function prevWindow(ticker: string): string | null {
  const m = /^([A-Z0-9]+)-(\d\d)([A-Z]{3})(\d\d)(\d\d)(\d\d)-(\d\d)$/.exec(ticker);
  if (!m || MONS.indexOf(m[3]) < 0) return null;
  const t = new Date(Date.UTC(2000 + Number(m[2]), MONS.indexOf(m[3]), Number(m[4]), Number(m[5]), Number(m[6])) - 15 * 60 * 1000);
  const p2 = (n: number) => String(n).padStart(2, "0");
  return `${m[1]}-${p2(t.getUTCFullYear() % 100)}${MONS[t.getUTCMonth()]}${p2(t.getUTCDate())}${p2(t.getUTCHours())}${p2(t.getUTCMinutes())}-${p2(t.getUTCMinutes())}`;
}
function reentryTick(assets: Record<string, AssetLike>, rows: NightRow[]): boolean {
  const a = assets.btc;
  const m = a?.market;
  if (!m?.ticker || !/^KXBTC15M-/.test(m.ticker)) return false;
  const close = windowClose(m.ticker);
  if (!close) return false;
  const left = close - Date.now();
  if (left < 780000 || left > 900000) return false;
  if (rows.some((r) => r.book === "reent" && r.ticker === m.ticker)) return false;
  const prev = prevWindow(m.ticker);
  if (!prev) return false;
  let books = ["cotc", "brickc", "brickt", "new", "confirm", "brk1", "brick"];
  try {
    const sw = JSON.parse(readFileSync(join(process.cwd(), "data", "live-switch.json"), "utf8"));
    if (Array.isArray(sw?.liveBook?.books) && sw.liveBook.books.length) books = sw.liveBook.books.map(String).filter((b: string) => b !== "hour");
  } catch {
  }
  const owner = rows.filter((r) => r.ticker === prev && books.includes(r.book) && !r.dnaMode && !(r as { stale?: boolean }).stale).sort((x, y) => (x.at < y.at ? -1 : 1))[0];
  if (!owner || owner.result !== "sold" || !/lock|gate/i.test(String(owner.exit || ""))) return false;
  const ask = r2(1 - Number(owner.side === "up" ? m.noBid : m.yesBid));
  if (!(ask > 0.02 && ask < 0.98)) return false;
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  rows.unshift({ id: `${m.ticker}:reent`, book: "reent", at: new Date().toISOString(), asset: "btc", ticker: m.ticker, side: owner.side, setup: `RE-ENTRY: ${String(owner.book).toUpperCase()} left last window early (${owner.exit}); same side again`, ask, multiple: r2(1 / ask), stake: PAPER_STAKE, tpPct: newTp(1 / ask), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands: null, spot: typeof a?.spot === "number" ? a.spot : null, event: null, hourPT } as NightRow);
  return true;
}

// GOLD · CLEAR $1.50 (Love, Oct 8 ~1:40 PM PT: "paper book skipping any trade with a band within $1.50 the target on
// gold, i want to see how that does over the week"). Her live books' gold trades, one per window (the first RUN book to
// fire owns it, like Kalshi), copied at the same entry in two paper books so they compare like for like:
//   gall   GOLD · ALL       every one of them
//   gclear GOLD · CLEAR $1.50  only the ones with NO session or nav line (VWAP, σ bands, 5/10/15m purple, upper, lower)
//                           within $1.50 of the strike.
// Same exits as any paper book. Paper only, never Kalshi.
function goldClearTick(assets: Record<string, AssetLike>, rows: NightRow[]): boolean {
  const a = assets.gold;
  const tk = a?.market?.ticker;
  const tgt = Number(a?.target) || 0;
  if (!tk || !(tgt > 0)) return false;
  if (rows.some((x) => x.ticker === tk && (x.book === "gall" || x.book === "gclear"))) return false;
  let books = ["cotc", "brickt", "confirm", "brk1", "new", "brick"];
  try {
    const sw = JSON.parse(readFileSync(join(process.cwd(), "data", "live-switch.json"), "utf8"));
    if (Array.isArray(sw?.liveBook?.books) && sw.liveBook.books.length) books = sw.liveBook.books.map(String).filter((b: string) => b !== "hour");
  } catch {
  }
  const src = rows.filter((r) => r.ticker === tk && r.asset === "gold" && books.includes(r.book) && !r.dnaMode && !(r as { stale?: boolean }).stale && Date.now() - Date.parse(r.at) < 120000).sort((x, y) => (x.at < y.at ? -1 : 1))[0];
  if (!src) return false;
  const b = (src.bands || {}) as { vwap?: number; sd?: number; nav?: Record<string, { c?: number; up?: number; dn?: number } | null> };
  const ls: [string, number][] = [];
  if (Number(b.vwap) > 0) {
    ls.push(["session VWAP", Number(b.vwap)]);
    if (Number(b.sd) > 0) for (const k of [0.5, 1, 1.5, 2, 2.5, 3]) ls.push([`+${k}σ`, Number(b.vwap) + k * Number(b.sd)], [`-${k}σ`, Number(b.vwap) - k * Number(b.sd)]);
  }
  for (const f of ["m5", "m10", "m15"]) {
    const n = b.nav?.[f];
    if (!n) continue;
    if (Number(n.c) > 0) ls.push([`${f.slice(1)} purple`, Number(n.c)]);
    if (Number(n.up) > 0) ls.push([`${f.slice(1)} upper`, Number(n.up)]);
    if (Number(n.dn) > 0) ls.push([`${f.slice(1)} lower`, Number(n.dn)]);
  }
  const near = ls.filter(([, L]) => Math.abs(L - tgt) <= 1.5).sort((x, y) => Math.abs(x[1] - tgt) - Math.abs(y[1] - tgt))[0];
  const base = { ...src, peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, soldAt: undefined, bell: undefined } as NightRow;
  rows.unshift({ ...base, id: `${tk}:gall`, book: "gall", setup: `${String(src.book).toUpperCase()} · ${src.setup}${near ? ` · the ${near[0]} ${near[1].toFixed(2)} is within $1.50 of the strike ${tgt.toFixed(2)}` : ""}` } as NightRow);
  if (!near) rows.unshift({ ...base, id: `${tk}:gclear`, book: "gclear", setup: `${String(src.book).toUpperCase()} · ${src.setup} · no line within $1.50 of the strike ${tgt.toFixed(2)}` } as NightRow);
  return true;
}

// DECIDED (Love, Oct 8 ~4:45 PM PT: "$125 over the target for btc, any multiple above 1.28x. anything over $3 on gold at
// the same multiple. enter if there is no band... basically buying into the winners that have already made a decision.
// if it's less profit, but it's more consistent with less losers, may ultimately be our best route on her cold days").
// Paper, one trade per window per asset: price already $125 (BTC) / $3 (gold) past the strike, the side that is winning
// still pays 1.28x or more, and no band standing in front of it (BTC: none of her lines within $30 ahead and not $3 clear;
// gold: no nav upper/lower within $0.50 ahead). Enters the first moment all of that is true with 2+ minutes left.
// Same exits as the other paper books. Never sent to Kalshi.
function decidedTick(assets: Record<string, AssetLike>, rows: NightRow[]): boolean {
  let changed = false;
  let bandsAll: Record<string, any> | null = null;
  try {
    bandsAll = JSON.parse(readFileSync(join(process.cwd(), "data", "bands-now.json"), "utf8"));
  } catch {
    bandsAll = null;
  }
  for (const id of ["btc", "gold"] as const) {
    const a = assets[id] as (AssetLike & { secondsLeft?: number }) | undefined;
    const m = a?.market;
    const tgt = Number(a?.target) || 0;
    const sp = Number(a?.spot) || 0;
    if (!m?.ticker || !(tgt > 0) || !(sp > 0) || !/15M-/.test(m.ticker)) continue;
    if (!(Number(a?.secondsLeft) >= 120)) continue;
    if (rows.some((r) => r.book === "dcd" && r.ticker === m.ticker)) continue;
    const need = id === "btc" ? 125 : 3;
    const side: "up" | "down" | null = sp - tgt >= need ? "up" : tgt - sp >= need ? "down" : null;
    if (!side) continue;
    const ask = r2(1 - Number(side === "up" ? m.noBid : m.yesBid));
    if (!(ask > 0.02 && ask <= 1 / 1.28)) continue;
    const bn = bandsAll?.[id];
    if (!bn || !bandsAll?.at || Date.now() - Date.parse(bandsAll.at) > 45000) continue;
    const ls: [string, number][] = [];
    const nav = bn.nav || {};
    if (id === "btc") {
      if (Number(bn.vwap) > 0) {
        ls.push(["session VWAP", Number(bn.vwap)]);
        if (Number(bn.sd) > 0) for (const k of [0.5, 1, 1.5, 2, 2.5, 3]) ls.push([`+${k}σ`, Number(bn.vwap) + k * Number(bn.sd)], [`-${k}σ`, Number(bn.vwap) - k * Number(bn.sd)]);
      }
      for (const f of ["m5", "m10", "m15"]) for (const k of ["c", "up", "dn"]) if (Number(nav?.[f]?.[k]) > 0) ls.push([`${f.slice(1)} ${k}`, Number(nav[f][k])]);
    } else {
      for (const f of ["m5", "m10", "m15"]) for (const k of ["up", "dn"]) if (Number(nav?.[f]?.[k]) > 0) ls.push([`${f.slice(1)} ${k}`, Number(nav[f][k])]);
    }
    const zone = id === "btc" ? 30 : 0.5;
    const by = id === "btc" ? 3 : 0.25;
    const front = ls.find(([, L]) => {
      const d = side === "up" ? L - sp : sp - L;
      return d > -by && d < zone;
    });
    if (front) continue;
    const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
    const gap = Math.abs(sp - tgt);
    rows.unshift({ id: `${m.ticker}:dcd`, book: "dcd", at: new Date().toISOString(), asset: id, ticker: m.ticker, side, setup: `DECIDED: already $${gap.toFixed(id === "btc" ? 0 : 2)} ${side === "up" ? "above" : "below"} the strike ${tgt.toFixed(id === "btc" ? 2 : 2)}, ${r2(1 / ask)}x, no band in front`, ask, multiple: r2(1 / ask), stake: PAPER_STAKE, tpPct: newTp(1 / ask), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands: bn, spot: sp, event: null, hourPT } as NightRow);
    changed = true;
  }
  return changed;
}

// RIP & TAP 4x (Love, Oct 8 ~7 PM PT: "for gold and silver, they break thru one band initially, tap the next. multiple is
// 4x+. we enter in @ $10. run one at a 100% exit, another at 200%, and another at 90% of the max... i want to see how often
// those hit"). Session ladder (VWAP and every 0.5σ): price breaks through one line, then reaches the next line in the same
// direction inside the same window. On that tap, whichever side pays 4x or more is taken at $10 (setup says if it is the
// bounce back or the continuation). Three paper rows, one per exit: RIP·TAP +100%, +200%, 90% OF MAX; otherwise held
// to the bell. One signal per window per asset. Paper only.
const gRt = globalThis as unknown as { __rt?: Record<string, { tk: string; last: number; broke: { dir: "up" | "down"; i: number } | null; fired: boolean }> };
function ripTapTick(assets: Record<string, any>, rows: NightRow[]): boolean {
  let changed = false;
  const st = (gRt.__rt ||= {});
  for (const id of ["gold", "silver"]) {
    const a = assets?.[id];
    const m = a?.market;
    const sp = Number(a?.spot) || 0;
    const fr = a?.vwap1m?.vwap ? a.vwap1m : a?.vwap5m;
    const vw = Number(fr?.vwap) || 0;
    const sd = Number(fr?.stdev) || 0;
    if (!m?.ticker || !(sp > 0) || !(vw > 0) || !(sd > 0)) continue;
    let s = st[id];
    if (!s || s.tk !== m.ticker) s = st[id] = { tk: m.ticker, last: sp, broke: null, fired: rows.some((r) => r.ticker === m.ticker && r.book === "rt100") };
    const ladder = [-3, -2.5, -2, -1.5, -1, -0.5, 0, 0.5, 1, 1.5, 2, 2.5, 3].map((k) => vw + k * sd);
    const buf = 0.05 * sd;
    if (!s.fired) {
      // a break: the last tick was under / over a line and this one is clearly through it
      for (let i = 0; i < ladder.length; i++) {
        const L = ladder[i];
        if (s.last < L && sp > L + buf) s.broke = { dir: "up", i };
        if (s.last > L && sp < L - buf) s.broke = { dir: "down", i };
      }
      const b = s.broke;
      const nextI = b ? (b.dir === "up" ? b.i + 1 : b.i - 1) : -1;
      const secondsLeft = Number(a?.secondsLeft) || 0;
      if (b && nextI >= 0 && nextI < ladder.length && secondsLeft >= 120 && (b.dir === "up" ? sp >= ladder[nextI] - buf : sp <= ladder[nextI] + buf)) {
        const upAsk = r2(1 - Number(m.noBid));
        const dnAsk = r2(1 - Number(m.yesBid));
        const side: "up" | "down" | null = upAsk > 0.02 && upAsk <= 0.25 ? "up" : dnAsk > 0.02 && dnAsk <= 0.25 ? "down" : null;
        if (side) {
          const ask = side === "up" ? upAsk : dnAsk;
          const mult = 1 / ask;
          const kind = side === b.dir ? "continuation" : "bounce";
          const nm = (k: number) => (k === 0 ? "VWAP" : `${k > 0 ? "+" : "-"}${Math.abs(k)}σ`);
          const ks = [-3, -2.5, -2, -1.5, -1, -0.5, 0, 0.5, 1, 1.5, 2, 2.5, 3];
          const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
          const setup = `RIP & TAP: broke the ${nm(ks[b.i])} ${b.dir}, tapped the ${nm(ks[nextI])}; ${kind} side at ${r2(mult)}x`;
          for (const [book, tp] of [["rt100", 100], ["rt200", 200], ["rt90", Math.round(0.9 * (mult - 1) * 100)]] as const) {
            rows.unshift({ id: `${m.ticker}:${book}`, book, at: new Date().toISOString(), asset: id, ticker: m.ticker, side, setup, ask, multiple: r2(mult), stake: 10, tpPct: tp, peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands: null, spot: sp, event: null, hourPT } as NightRow);
          }
          s.fired = true;
          changed = true;
        }
      }
    }
    s.last = sp;
  }
  return changed;
}

// WAIT 5 (Love, Oct 8 ~7 PM PT: "after 5 minutes into the window, so we get a chance to see what price does first...
// we get to see what price does first, then decide instead of the other way around"). Her live books' trades (the books on
// RUN), but only the first one that fires 5+ minutes into the window, copied at its own entry with the same exits. Compare
// with COMBINED · PRIME on the DAY tab (the same books from the first second). Paper only.
function wait5Tick(assets: Record<string, AssetLike>, rows: NightRow[]): boolean {
  let changed = false;
  let books = ["cotc", "brickt", "confirm", "new", "new24"];
  try {
    const sw = JSON.parse(readFileSync(join(process.cwd(), "data", "live-switch.json"), "utf8"));
    if (Array.isArray(sw?.liveBook?.books) && sw.liveBook.books.length) books = sw.liveBook.books.map(String).filter((b: string) => b !== "hour");
  } catch {
  }
  for (const id of ["btc", "gold"]) {
    const tk = assets?.[id]?.market?.ticker;
    if (!tk || rows.some((r) => r.ticker === tk && r.book === "w5")) continue;
    const close = windowClose(tk);
    if (!close) continue;
    const open5 = close - 900000 + 300000;
    const src = rows.filter((r) => r.ticker === tk && books.includes(r.book) && !r.dnaMode && !(r as { stale?: boolean }).stale && Date.parse(r.at) >= open5 && Date.now() - Date.parse(r.at) < 120000).sort((x, y) => (x.at < y.at ? -1 : 1))[0];
    if (!src) continue;
    rows.unshift({ ...src, id: `${tk}:w5`, book: "w5", peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, soldAt: undefined, bell: undefined, setup: `${String(src.book).toUpperCase()} · ${src.setup} (5+ min in)` } as NightRow);
    changed = true;
  }
  return changed;
}

// REVERSAL · WORST HOURS (Love, Oct 8 ~7 PM PT: "on btc's worst hours, the ones we get hit left and right, we should try
// a book that trades the reversals on those, not the initial entries. waits for price to break thru a band, hit another,
// then enter on btc. solely on the worst hours"). BTC only, only in the hours PRIME HOURS skips (ORIGINAL lost money there
// over the last 7 days, 8+ trades; refreshed every 30 min). Session ladder (VWAP and every 0.5σ): price breaks through
// one line, then reaches the next one in the same window; on that tap she takes the REVERSAL (the side back the other
// way) if it pays 1.38x+, $30, the usual exits. One per window. Paper only.
const gRv = globalThis as unknown as { __rv?: { tk: string; last: number; broke: { dir: "up" | "down"; i: number } | null; fired: boolean } };
function reversalWorstTick(assets: Record<string, any>, rows: NightRow[]): boolean {
  const a = assets?.btc;
  const m = a?.market;
  const sp = Number(a?.spot) || 0;
  const fr = a?.vwap1m?.vwap ? a.vwap1m : a?.vwap5m;
  const vw = Number(fr?.vwap) || 0;
  const sd = Number(fr?.stdev) || 0;
  if (!m?.ticker || !(sp > 0) || !(vw > 0) || !(sd > 0)) return false;
  const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
  let s = gRv.__rv;
  if (!s || s.tk !== m.ticker) s = gRv.__rv = { tk: m.ticker, last: sp, broke: null, fired: rows.some((r) => r.ticker === m.ticker && r.book === "rvw") };
  let changed = false;
  if (!s.fired && (primeHourBad().btc || []).includes(hourPT)) {
    const ks = [-3, -2.5, -2, -1.5, -1, -0.5, 0, 0.5, 1, 1.5, 2, 2.5, 3];
    const ladder = ks.map((k) => vw + k * sd);
    const buf = Math.max(3, 0.05 * sd);
    for (let i = 0; i < ladder.length; i++) {
      const L = ladder[i];
      if (s.last < L && sp > L + buf) s.broke = { dir: "up", i };
      if (s.last > L && sp < L - buf) s.broke = { dir: "down", i };
    }
    const b = s.broke;
    const nextI = b ? (b.dir === "up" ? b.i + 1 : b.i - 1) : -1;
    if (b && nextI >= 0 && nextI < ladder.length && Number(a?.secondsLeft) >= 120 && (b.dir === "up" ? sp >= ladder[nextI] - buf : sp <= ladder[nextI] + buf)) {
      const side: "up" | "down" = b.dir === "up" ? "down" : "up";
      const ask = r2(1 - Number(side === "up" ? m.noBid : m.yesBid));
      if (ask > 0.02 && ask <= 1 / 1.38) {
        const nm = (k: number) => (k === 0 ? "VWAP" : `${k > 0 ? "+" : "-"}${Math.abs(k)}σ`);
        const mult = 1 / ask;
        rows.unshift({ id: `${m.ticker}:rvw`, book: "rvw", at: new Date().toISOString(), asset: "btc", ticker: m.ticker, side, setup: `REVERSAL (worst hour ${hourPT}:00 PT): broke the ${nm(ks[b.i])} ${b.dir}, tapped the ${nm(ks[nextI])}, back the other way`, ask, multiple: r2(mult), stake: mult >= 3 ? PAPER_STAKE / 2 : PAPER_STAKE, tpPct: newTp(mult), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands: null, spot: sp, event: null, hourPT } as NightRow);
        s.fired = true;
        changed = true;
      }
    }
  }
  s.last = sp;
  return changed;
}

// CANDLE BOOKS (Love, Oct 8 ~8 PM PT: "looking at the previous candle... if it's a giant red candle, we can assume the next
// 15m may also be red... what do you think about testing out some other methods of entry?"). A "giant" candle = a window
// that was already decided with 5 minutes left (contract at 95c+ either way). Looked back Sep 21 - Oct 8 on Kalshi's own
// prices, buying at minute 1 and holding to the bell:
//   CANDLE FOLLOW (her instinct, BTC + gold + silver): BTC 49% right, gold 44%, silver 42% -> about -$3,300 together.
//   SNAPBACK (the data's answer, gold + silver only): the next window went the OTHER way 56% (gold) / 58% (silver), held in
//   both halves of the sample: about +$740 gold, +$740 silver at $30. BTC showed nothing either way.
// Paper only, $30, one per window, entered in minute 1-2 at 30-70c, held to the bell.
const gCd = g as unknown as { __candSnap?: Record<string, number> };
function candleTick(assets: Record<string, any>, rows: NightRow[]): boolean {
  const snap = gCd.__candSnap || (gCd.__candSnap = {});
  let changed = false;
  for (const asset of ["btc", "gold", "silver"] as const) {
    const a = assets?.[asset];
    const m = a?.market;
    if (!m?.ticker) continue;
    const close = windowClose(m.ticker);
    if (!close) continue;
    const left = close - Date.now();
    const yb = Number(m.yesBid);
    const nb2 = Number(m.noBid);
    if (left <= 300000 && left > 200000 && snap[m.ticker] == null && yb >= 0 && nb2 >= 0 && (yb > 0 || nb2 > 0)) snap[m.ticker] = r2((yb + (1 - nb2)) / 2);
    if (left > 870000 || left < 780000) continue;
    const prev = prevWindow(m.ticker);
    const pm = prev ? snap[prev] : undefined;
    if (pm == null || (pm > 0.05 && pm < 0.95)) continue;
    const prevDir: "up" | "down" = pm >= 0.95 ? "up" : "down";
    const spot = Number(a?.spot) || 0;
    const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
    const books: Array<["snapb" | "cfol", "up" | "down"]> = [["cfol", prevDir]];
    if (asset !== "btc") books.push(["snapb", prevDir === "up" ? "down" : "up"]);
    for (const [book, side] of books) {
      if (rows.some((r) => r.book === book && r.ticker === m.ticker)) continue;
      const ask = r2(1 - Number(side === "up" ? m.noBid : m.yesBid));
      if (!(ask >= 0.3 && ask <= 0.7)) continue;
      const setup = book === "cfol"
        ? `CANDLE FOLLOW: last 15m closed decided ${prevDir} (${Math.round(pm * 100)}c with 5 min left), following it`
        : `SNAPBACK: last 15m closed decided ${prevDir} (${Math.round(pm * 100)}c with 5 min left), fading it`;
      rows.unshift({ id: `${m.ticker}:${book}`, book, at: new Date().toISOString(), asset, ticker: m.ticker, side, setup, ask, multiple: r2(1 / ask), stake: PAPER_STAKE, tpPct: 0, peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands: null, spot, event: null, hourPT } as NightRow);
      changed = true;
    }
  }
  for (const k of Object.keys(snap)) {
    const c = windowClose(k);
    if (c && Date.now() - c > 3600000) delete snap[k];
  }
  return changed;
}

// LDC BOOKS (Love, Oct 8 ~8:30 PM PT: "remember our LDC? it has 1M - 5M - 15M. i want to try linking those via webhooks.
// fires on the 1M signal, we'll try the 5M and 15M on their own books"). Her TradingView LDC alerts post to the small
// webhook listener (scripts/ldc-hook.mjs), which writes data/ldc-signals.jsonl. Each fresh signal (30 s or newer) books
// the current Kalshi window for that asset on its own book: LDC 1M / 5M / 15M. Buy = up, Sell = down. $30, normal exits,
// one per window per book, only with 2+ minutes left and the side at 30-73c (so it could go live later under her floor).
// Every signal is answered in data/ldc-log.jsonl (booked, or why not). Paper only.
const gLd = g as unknown as { __ldcSeen?: Set<string> };
function ldcTick(assets: Record<string, any>, rows: NightRow[]): boolean {
  const file = join(process.cwd(), "data", "ldc-signals.jsonl");
  if (!existsSync(file)) return false;
  const seen = gLd.__ldcSeen || (gLd.__ldcSeen = new Set<string>());
  let lines: string[];
  try {
    lines = readFileSync(file, "utf8").split("\n").filter((l) => l.trim()).slice(-60);
  } catch {
    return false;
  }
  let changed = false;
  const say = (o: Record<string, unknown>) => {
    try {
      appendFileSync(join(process.cwd(), "data", "ldc-log.jsonl"), JSON.stringify({ at: new Date().toISOString(), ...o }) + "\n");
    } catch {
    }
  };
  for (const l of lines) {
    let s: { at: string; asset: "btc" | "gold" | "silver"; tf: number; side: "up" | "down"; price?: number | null };
    try {
      s = JSON.parse(l);
    } catch {
      continue;
    }
    const key = `${s.at}|${s.asset}|${s.tf}|${s.side}`;
    if (seen.has(key)) continue;
    const age = Date.now() - Date.parse(s.at);
    if (!(age >= 0)) continue;
    seen.add(key);
    if (age > 30000) continue;
    const book = s.tf === 1 ? "ldc1" : s.tf === 5 ? "ldc5" : s.tf === 15 ? "ldc15" : null;
    if (!book) continue;
    const a = assets?.[s.asset];
    const m = a?.market;
    const base = { signal: `${s.tf}M ${String(s.asset).toUpperCase()} ${s.side === "up" ? "BUY" : "SELL"}`, book };
    if (!m?.ticker) {
      say({ ...base, result: "no Kalshi window for that asset right now" });
      continue;
    }
    const close = windowClose(m.ticker);
    const left = close ? close - Date.now() : 0;
    if (left < 120000) {
      say({ ...base, ticker: m.ticker, result: `under 2 minutes left (${Math.round(left / 1000)}s)` });
      continue;
    }
    if (rows.some((r) => r.book === book && r.ticker === m.ticker)) {
      say({ ...base, ticker: m.ticker, result: "already has a trade this window" });
      continue;
    }
    const ask = r2(1 - Number(s.side === "up" ? m.noBid : m.yesBid));
    if (!(ask >= 0.3 && ask <= 0.73)) {
      say({ ...base, ticker: m.ticker, result: `side is ${Math.round(ask * 100)}c (needs 30-73c)` });
      continue;
    }
    const mult = 1 / ask;
    const hourPT = Number(new Intl.DateTimeFormat("en-US", { timeZone: "America/Los_Angeles", hour: "2-digit", hourCycle: "h23" }).format(new Date()));
    rows.unshift({ id: `${m.ticker}:${book}`, book, at: new Date().toISOString(), asset: s.asset, ticker: m.ticker, side: s.side, setup: `LDC ${s.tf}M ${s.side === "up" ? "BUY" : "SELL"} (TradingView${s.price ? ` @ ${s.price}` : ""})`, ask, multiple: r2(mult), stake: PAPER_STAKE, tpPct: newTp(mult), peakPct: 0, exit: null, sellBid: null, result: "open", pnl: null, bands: null, spot: Number(a?.spot) || 0, event: null, hourPT } as NightRow);
    say({ ...base, ticker: m.ticker, result: `booked at ${Math.round(ask * 100)}c` });
    changed = true;
  }
  if (seen.size > 2000) gLd.__ldcSeen = new Set([...seen].slice(-500));
  return changed;
}

export function nightTick(assets: Record<string, AssetLike> | null | undefined) {
  if (!assets) return;
  const ov = paperTp();
  const rows = read();
  try {
    if (scale30(rows)) write(rows);
  } catch {
  }
  try {
    if (reentryTick(assets, rows)) write(rows);
  } catch {
  }
  try {
    if (goldClearTick(assets, rows)) write(rows);
  } catch {
  }
  try {
    if (decidedTick(assets, rows)) write(rows);
  } catch {
  }
  try {
    if (ripTapTick(assets as Record<string, any>, rows)) write(rows);
  } catch {
  }
  try {
    if (wait5Tick(assets, rows)) write(rows);
  } catch {
  }
  try {
    if (reversalWorstTick(assets as Record<string, any>, rows)) write(rows);
  } catch {
  }
  try {
    if (candleTick(assets as Record<string, any>, rows)) write(rows);
  } catch {
  }
  try {
    if (ldcTick(assets as Record<string, any>, rows)) write(rows);
  } catch {
  }
  if (!rows.some((r) => r.result === "open")) return;
  const lock = g.__nightLock || (g.__nightLock = {});
  const bankSt = ((g as unknown as { __bank?: Record<string, { peakBid: number; touch: { L: number; name: string; minute: number } | null }> }).__bank ||= {});
  let bandsNow: Record<string, any> | null = null;
  if (rows.some((r) => r.result === "open" && ["bank", "bank2", "bank5p", "brk", "hold90", "claudex", "trendx", "bank5px", "brickcx", "brickcw", "brickcl"].includes(r.book))) {
    try {
      bandsNow = JSON.parse(readFileSync(join(process.cwd(), "data", "bands-now.json"), "utf8"));
    } catch {
      bandsNow = null;
    }
  }
  let changed = false;
  // 5M CLOSE EXIT TWINS (Love, Oct 5 ~3:30 PM PT: "she gets out IF there is a 5M close on the other side of the band").
  // CLAUDE / TREND / BANK SOLE+ each get a paper twin with the exact same entries and exits, plus one more: the first
  // 5-minute close on the far side of the line she entered on = out, win or lose. 24-hour side-by-side test.
  // Love, Oct 5 ~3:45 PM PT: "run it on the books that it did benefit on, not the books that it hurt" -> BRICK's twin
  // removed (the backtest hurt BRICK, BRICK CLEAN, SOLE+ and COTC in every version).
  const X5: Record<string, NightRow["book"]> = { claude: "claudex", trend: "trendx", bank5p: "bank5px" };
  for (const r of [...rows]) {
    if (r.result !== "open" || !X5[r.book] || r.dnaMode || (r as { stale?: boolean }).stale || Date.now() - Date.parse(r.at) > 120000) continue;
    const tid = `${r.id}:x5`;
    if (rows.some((x) => x.id === tid)) continue;
    rows.unshift({ ...r, id: tid, book: X5[r.book], peakPct: 0 } as NightRow);
    changed = true;
  }
  // EXIT TWINS of BRICK · CLEAN (Love, Oct 7 ~12:20 AM PT: "yesss pls do, i want to see how that does... can we try taking
  // 75% of whats available?"). Same entries as BRICK · CLEAN, paper only:
  //   brickcr  "RIDE": no take-profit gate, no lock the win: 90% of the max then the 1% trail, or the bell.
  //   brickc75 "75%":  BRICK · CLEAN's exits plus a hard take profit at 75% of the max.
  // Gate lab (Oct 7): riding past the 409 gate/lock exits = -$2,064 on paper; TP lab: a hard 75% = -$973. Watching live.
  for (const r of [...rows]) {
    if (r.result !== "open" || r.book !== "brickc" || r.dnaMode || (r as { stale?: boolean }).stale || Date.now() - Date.parse(r.at) > 120000) continue;
    // brickcpt "PATIENT" (Love, Oct 7 ~1:45 PM PT: "i would love to test that out over the next few weeks"): BRICK · CLEAN's
    // exits, except a gate / lock the win does NOT fire while price is moderately past the strike (gold $0.50-$1.50,
    // BTC $25-$50). Exit-why lab, 499 early exits: riding in that zone paid +$894 gold / +$724 BTC. Found by slicing, so it
    // gets weeks on paper before anything live.
    // CUT-LOSS TWINS (Love, Oct 7 ~4 PM PT: "learn to decipher when it's time to cut our losses... breaking thru and
    // reversing thru our initial band entry, if price crosses ANOTHER band and we still have the opportunity to cash out...
    // if you can think of any other reasons to exit we can run those books side by side"). BRICK · CLEAN's entries and
    // exits, plus one way out of a trade that has turned (cutExit below). A week on paper next to the live books.
    for (const [suf, book] of [["ride", "brickcr"], ["tp75", "brickc75"], ["patient", "brickcpt"], ["cut2", "brickcx"], ["wall", "brickcw"], ["late", "brickcl"], ["half", "brickch"]] as const) {
      const tid = `${r.id}:${suf}`;
      if (rows.some((x) => x.id === tid)) continue;
      rows.unshift({ ...r, id: tid, book, peakPct: 0 } as NightRow);
      changed = true;
    }
  }
  // FEE TWINS of BRICK · CLEAN (Love, Oct 7 ~12:40 AM PT: "can she price them to get in at the best multiple she can?
  // lets try it on a paperbook"). Kalshi charges 7% x contracts x price x (1 - price) on every fill that takes the book
  // (a resting order that someone else fills is free). Oct 6: +$158.93 before fees, $143.20 in fees, +$15.72 after.
  // Both twins have Kalshi's fees taken out of their P&L, so they compare with each other (other cards are before fees):
  //   brickcf "FEES":  BRICK · CLEAN exactly as the desk trades it now: buys at the ask (fee), sells into the bid (fee).
  //   brickcm "MAKER": rests a buy at the BID the moment BRICK · CLEAN signals (a better price and no fee). Filled when the
  //                    ask comes down to it within 45 s; if not, it buys at the ask then (fee) as long as it is still 1.37x+.
  //                    Same exits as BRICK · CLEAN, same sell fees.
  const mk = ((g as unknown as { __makerPend?: Record<string, { row: NightRow; limit: number; until: number }> }).__makerPend ||= {});
  for (const r of [...rows]) {
    if (r.result !== "open" || r.book !== "brickc" || r.dnaMode || (r as { stale?: boolean }).stale || Date.now() - Date.parse(r.at) > 120000) continue;
    const fid = `${r.id}:fee`;
    if (!rows.some((x) => x.id === fid)) {
      rows.unshift({ ...r, id: fid, book: "brickcf", peakPct: 0, entryFee: kfee(r.stake / r.ask, r.ask), setup: `${r.setup} (bought at the ask)` } as NightRow);
      changed = true;
    }
    const mid = `${r.id}:maker`;
    if (!mk[mid] && !rows.some((x) => x.id === mid)) {
      const m = assets[r.asset]?.market;
      const bid = m && m.ticker === r.ticker ? (r.side === "up" ? m.yesBid : m.noBid) : 0;
      const limit = bid > 0.02 && bid < r.ask ? bid : Math.max(0.02, Math.round((r.ask - 0.01) * 100) / 100);
      mk[mid] = { row: r, limit, until: Date.parse(r.at) + 45000 };
    }
  }
  for (const [mid, p] of Object.entries(mk)) {
    const r = p.row;
    const a = assets[r.asset] as (AssetLike & { market: { ticker: string; yesBid: number; noBid: number; yesAsk?: number; noAsk?: number } | null }) | undefined;
    const m = a?.market;
    if (!m || m.ticker !== r.ticker || rows.some((x) => x.id === mid)) {
      delete mk[mid];
      continue;
    }
    const askNow = Number(r.side === "up" ? m.yesAsk : m.noAsk) || 0;
    let fill: { px: number; maker: boolean } | null = null;
    if (askNow > 0.02 && askNow <= p.limit + 1e-9) fill = { px: p.limit, maker: true };
    else if (Date.now() >= p.until) {
      delete mk[mid];
      if (askNow > 0.02 && 1 / askNow >= 1.37) fill = { px: askNow, maker: false };
      else continue;
    }
    if (!fill) continue;
    delete mk[mid];
    rows.unshift({ ...r, id: mid, book: "brickcm", ask: fill.px, multiple: r2(1 / fill.px), tpPct: newTp(1 / fill.px), peakPct: 0, at: new Date().toISOString(), entryFee: fill.maker ? 0 : kfee(r.stake / fill.px, fill.px), setup: `${r.setup} (${fill.maker ? `resting buy filled at ${Math.round(fill.px * 100)}c, no fee` : `no fill at the bid in 45 s, bought at ${Math.round(fill.px * 100)}c`})` } as NightRow);
    changed = true;
  }
  for (const id of ["btc", "gold"]) {
    const m = assets[id]?.market;
    if (!m?.ticker) continue;
    for (const r of rows) {
      if (r.result !== "open" || r.ticker !== m.ticker) continue;
      const bid = r.side === "up" ? m.yesBid : m.noBid;
      if (!(bid > 0)) continue;
      const pct = (bid / r.ask - 1) * 100;
      if (pct > r.peakPct) {
        r.peakPct = r2(pct);
        changed = true;
      }
      // HALF AT 75% (Love, Oct 7 ~5:40 PM PT: "instead of taking the whole thing at 75%, take half at that price, and then
      // the gate only catching it if it falls"). brickch = BRICK · CLEAN; the first time the bid reaches 75% of the max, half
      // is sold there; the other half keeps every rule. Lab (scripts/half-lab.py): +$155 gold / +$324 BTC on the trades that
      // end on a gate or lock, but -$400 gold / -$45 BTC overall (it halves the trades that run to the full take profit).
      if (r.book === "brickch" && (r as { halfBid?: number }).halfBid == null && pct + 1e-9 >= 0.75 * (r.multiple - 1) * 100) {
        (r as { halfBid?: number }).halfBid = bid;
        changed = true;
      }
      // TROUGH (Love, Oct 5: stop-loss lab): how far under water each paper trade went, for the stop tests.
      const rt = r as NightRow & { troughPct?: number };
      if (pct < (rt.troughPct ?? 0)) {
        rt.troughPct = r2(pct);
        changed = true;
      }
      let why: string | null = null;
      const tpPeak = g as unknown as { __nightTpPeak?: Record<string, number> };
      const tpp = tpPeak.__nightTpPeak || (tpPeak.__nightTpPeak = {});
      // TAP 3x sells at +200%; TAP HOLD and RESCUE ride to the bell. Nothing else touches them.
      if (/^(snap(50|100|200|300|hold)|x16_(50|100|200|300)|x16hold|rt100|rt200|rt90|snapb|cfol)$/.test(r.book)) {
        if (r.tpPct > 0 && pct + 1e-9 >= r.tpPct) {
          r.result = "sold";
          r.soldAt = new Date().toISOString();
          r.exit = `take profit +${r.tpPct}% (${Math.round(pct)}%)`;
          r.sellBid = bid;
          r.pnl = r2((r.stake / r.ask) * bid - r.stake);
          changed = true;
        }
        continue;
      }
      if (r.book === "tap3x" || r.book === "taphold" || r.book === "rescue") {
        if (r.book === "tap3x" && pct + 1e-9 >= 200) {
          r.result = "sold";
          r.soldAt = new Date().toISOString(); // when it sold (Love, Oct 3: learn when the BREAK exit is right)
          r.exit = `take profit +200% (${Math.round(pct)}%)`;
          r.sellBid = bid;
          r.pnl = r2((r.stake / r.ask) * bid - r.stake);
          changed = true;
        }
        continue;
      }
      // BREAK + HOLD90 run their own exits (below), nothing else.
      if (r.book === "brk" || r.book === "hold90") {
        const rr = ov ? { ...r, tpPct: ov } : r;
        const ex = r.book === "brk" ? breakExit(rr, id, bid, pct, bandsNow) : hold90Exit(rr, id, bid, pct, assets[id], bandsNow);
        if (ex) {
          r.result = "sold";
          r.soldAt = new Date().toISOString(); // when it sold (Love, Oct 3: learn when the BREAK exit is right)
          r.exit = ex;
          r.sellBid = bid;
          r.pnl = r2((r.stake / r.ask) * bid - r.stake);
          changed = true;
        }
        continue;
      }
      const newish = r.book !== "original" && r.book !== "golden";
      // REFINED + CLAUDE + TREND + BRICK + COTC: a gate / lock never sells under breakeven after a gap.
      const aboveWater = !["refined", "claude", "trend", "brick", "cotc", "diamond", "bank", "bank2", "bank5p", "claudex", "trendx", "brickx", "bank5px", "brickt", "brickp", "bricks"].includes(r.book) || pct > 0;
      if (ov && r.book !== "bank" && r.book !== "bank2" && r.book !== "bank5p" && r.book !== "bank5px") {
        if (pct + 1e-9 >= ov) why = `hard take profit +${ov}%`;
      } else if (r.book === "original" || r.book === "golden") {
        if (r.tpPct > 0 && pct + 1e-9 >= r.tpPct) why = `take profit +${r.tpPct}%`;
      } else if (r.tpPct > 0 && (pct + 1e-9 >= r.tpPct || tpp[r.id] != null)) {
        // NEW: ride past the take profit, trail 1% under the best quote, never below the line.
        tpp[r.id] = Math.max(tpp[r.id] ?? pct, pct);
        const trail = Math.max(r.tpPct, Math.floor(tpp[r.id]) - 1);
        if (bid >= 0.97 || pct < trail) why = `take profit: peaked +${Math.round(tpp[r.id])}%, 1% trail`;
      }
      // NEW only sells a winner early with a reason: within $1.50 (gold) / $100 (BTC) of the target.
      const a = assets[id];
      // Near-the-strike distance for early exits = live-switch lockWin.clear, same as her live trades (Oct 7, Love: gold $1).
      const clear = clearFor(id);
      const cushion = a?.spot && a?.target ? (r.side === "up" ? a.spot - a.target : a.target - a.spot) : null;
      const reason = !(clear > 0) || cushion == null || cushion <= clear;
      // Love, Oct 3 ~6:30 PM PT: "definitely take those off on their paper books too" -> the SOLE and LAST MINUTE books
      // have no take-profit gate and no lock-the-win: they ride to 90% of the max available or the bell.
      const freeRide = ["sole5", "sole10", "sole15", "sole5p", "sole5z", "sole5v", "lastmin", "lastgrant", "brickcr"].includes(r.book);
      if (!why && r.book === "brickc75" && pct + 1e-9 >= 0.75 * (r.multiple - 1) * 100) why = `take profit 75% of the max (+${Math.round(pct)}%)`;
      const gated = !ov && newish && !freeRide && r.book !== "bank" && r.book !== "bank2" && r.book !== "bank5p" && r.book !== "bank5px";
      const patientHold = r.book === "brickcpt" && cushion != null && (id === "gold" ? cushion >= 0.5 && cushion < 1.5 : cushion >= 25 && cushion < 50);
      if (!why && gated && reason && aboveWater && !patientHold) {
        // Love's gates: under 1.65x keep a literal +40% once reached; 1.65x+ keep 55% / 60% of the max.
        const maxPct = (r.multiple - 1) * 100;
        const gates = r.multiple < 1.65 ? (40 < maxPct ? [40] : []) : [0.55, 0.6].map((x) => r2(maxPct * x));
        const floor = gates.filter((gp) => r.peakPct + 1e-9 >= gp).pop();
        if (floor != null && pct < floor) why = `take-profit gate +${floor}% (peaked +${r.peakPct}%)`;
      }
      if (gated) lock[r.id] = Math.max(lock[r.id] ?? -100, pct);
      if (!why && (r.book === "bank" || r.book === "bank5p" || r.book === "bank5px")) why = bankExit(r, id, bid, pct, bankSt, bandsNow);
      if (!why && (r.book === "claudex" || r.book === "trendx" || r.book === "bank5px")) why = band5Exit(r, id, pct, bandsNow);
      if (!why && r.book === "bank2") why = bankExit(r, id, bid, pct, bankSt, bandsNow, { arm: 40, give: 10, band: false });
      if (!why && (r.book === "brickcx" || r.book === "brickcw" || r.book === "brickcl")) why = cutExit(r, id, bid, assets[id] as AssetLike & { secondsLeft?: number }, bandsNow);
      if (!why && gated && reason && aboveWater && !patientHold) {
        if (lock[r.id] >= 30 && pct <= 20) why = `locked the win (was +${Math.round(lock[r.id])}%, back to +${Math.round(pct)}%)`;
      }
      if (why) {
        r.result = "sold";
        r.soldAt = new Date().toISOString(); // when it sold (Love, Oct 3: learn when the BREAK exit is right)
        r.exit = why;
        r.sellBid = bid;
        r.pnl = r2((r.stake / r.ask) * bid - r.stake);
        // EXIT CONTEXT (Love, Oct 7: "we should be keeping track of the multiples at those times as well"): the multiple
        // left, how far price was past the strike, and the minutes left, on every exit, for the exit lab / a future model.
        Object.assign(r, { exitMult: bid > 0 ? r2(1 / bid) : null, exitCushion: cushion != null ? r2(cushion) : null, exitLeft: Number((a as { secondsLeft?: number } | undefined)?.secondsLeft) > 0 ? Math.round(Number((a as { secondsLeft?: number }).secondsLeft)) : null });
        if (FEE_BOOKS.has(r.book)) r.pnl = r2(r.pnl - (Number((r as { entryFee?: number }).entryFee) || 0) - kfee(r.stake / r.ask, bid));
        const hb = Number((r as { halfBid?: number }).halfBid) || 0;
        if (r.book === "brickch" && hb > 0) r.pnl = r2((r.stake / r.ask / 2) * (hb + bid) - r.stake);
        changed = true;
      }
    }
  }
  if (changed) write(rows);
}

const brkSt: Record<string, { lastAt: number; through: number }> = {};
/** BREAK: hard take profit, or out the moment the line she entered on breaks with a strong push. */
/** Her lines right now, from bands-now.json: session VWAP +/- 0.5 sd steps, the 5m/10m/15m purple (BTC: nav upper/lower too). */
function linesNow(asset: string, bandsNow: Record<string, any> | null): { name: string; price: number }[] {
  const b = bandsNow?.[asset];
  const vw = Number(b?.vwap) || 0;
  const sd = Number(b?.sd) || 0;
  const out: { name: string; price: number }[] = [];
  if (vw > 0 && sd > 0) for (let k = -6; k <= 6; k += 1) out.push({ name: k === 0 ? "session VWAP" : `${k > 0 ? "+" : ""}${k / 2}σ`, price: vw + (k / 2) * sd });
  for (const [key, lab] of [["m5", "5m"], ["m10", "10m"], ["m15", "15m"]] as const) {
    const f = b?.nav?.[key];
    if (Number(f?.c) > 0) out.push({ name: `${lab} purple`, price: Number(f.c) });
    if (asset === "btc" && Number(f?.up) > 0) out.push({ name: `${lab} upper`, price: Number(f.up) });
    if (asset === "btc" && Number(f?.dn) > 0) out.push({ name: `${lab} lower`, price: Number(f.dn) });
  }
  return out;
}
/** CUT-LOSS exits (paper twins of BRICK · CLEAN, Love Oct 7). Each sells only while the bid still pays back part of the stake.
 *  brickcx "2 BANDS" (Love's rule): the 1m candle has closed back through the line she entered on AND through the next of
 *          her lines beyond it, against the trade; sells if the bid is still at least half of what she paid.
 *  brickcw "WALL" (Claude): price is on the losing side of the strike and one of her unbroken lines now stands between price
 *          and the strike (her own entry rule, turned into an exit: to win it would have to cross a band); 2+ minutes in,
 *          bid at least 35% of what she paid.
 *  brickcl "LATE" (Claude): 5 minutes or less left, price on the losing side of the strike by gold $1 / BTC $50 or more,
 *          bid at least half of what she paid. */
function cutExit(r: NightRow, asset: string, bid: number, a: (AssetLike & { secondsLeft?: number }) | undefined, bandsNow: Record<string, any> | null): string | null {
  const b = bandsNow?.[asset];
  const c1 = Number(b?.nav?.close1m) || Number(b?.spot) || 0;
  const tgt = Number(a?.target) || 0;
  if (!(c1 > 0) || !(bid > 0)) return null;
  const dir = r.side === "up" ? 1 : -1;
  const back = bid / r.ask;
  const lines = linesNow(asset, bandsNow);
  if (r.book === "brickcx") {
    if (back < 0.5) return null;
    const m = /(?:off|through|above|below) the ([+\-−]?[\d.]+σ|session VWAP|VWAP|(?:5m|10m|15m) (?:purple|upper|lower))/i.exec(r.setup || "");
    if (!m) return null;
    const nm = m[1] === "VWAP" ? "session VWAP" : m[1].replace("−", "-");
    const L0 = lines.find((l) => l.name === nm);
    if (!L0 || !(dir * (c1 - L0.price) < 0)) return null;
    const beyond = lines.filter((l) => dir * (l.price - L0.price) < 0).sort((x, y) => Math.abs(x.price - L0.price) - Math.abs(y.price - L0.price))[0];
    if (!beyond || !(dir * (c1 - beyond.price) < 0)) return null;
    return `cut: closed back through the ${L0.name} and the ${beyond.name}, out with ${Math.round(back * 100)}% of the stake`;
  }
  if (!(tgt > 0)) return null;
  const wrong = dir * (c1 - tgt) < 0;
  if (!wrong) return null;
  if (r.book === "brickcw") {
    if (back < 0.35 || Date.now() - Date.parse(r.at) < 120000) return null;
    const wall = lines.find((l) => l.price > Math.min(c1, tgt) && l.price < Math.max(c1, tgt));
    if (!wall) return null;
    return `cut: the ${wall.name} now stands between price and the strike, out with ${Math.round(back * 100)}% of the stake`;
  }
  if (r.book === "brickcl") {
    const left = Number(a?.secondsLeft) || 0;
    const far = asset === "gold" ? 1 : 50;
    if (!(left > 0 && left <= 300) || back < 0.5 || dir * (tgt - c1) < far) return null;
    return `cut: ${Math.round(left / 60)} min left, ${asset === "gold" ? "$" + Math.abs(tgt - c1).toFixed(2) : "$" + Math.round(Math.abs(tgt - c1))} on the wrong side of the strike, out with ${Math.round(back * 100)}% of the stake`;
  }
  return null;
}

function breakExit(r: NightRow, asset: string, bid: number, pct: number, bandsNow: Record<string, any> | null): string | null {
  if (r.tpPct > 0 && pct + 1e-9 >= r.tpPct) return `take profit +${r.tpPct}%`;
  const L = (r as NightRow & { entryLine?: { name: string; price: number } | null }).entryLine;
  const nav = bandsNow?.[asset]?.nav;
  const c1 = Number(nav?.close1m) || 0;
  const at = Number(nav?.close1mAt) || 0;
  if (!L || !(c1 > 0) || !at) return null;
  const s = (brkSt[r.id] ||= { lastAt: Math.floor(Date.parse(r.at) / 1000) - 60, through: 0 });
  if (at <= s.lastAt) return null;
  s.lastAt = at;
  const depth = r.side === "up" ? L.price - c1 : c1 - L.price;
  if (depth > 0) {
    s.through += 1;
    const strong = asset === "btc" ? 20 : 0.4;
    if (depth >= strong) return `strong break of the ${L.name} (${L.price.toFixed(2)}): closed ${depth.toFixed(2)} through, out at ${Math.round(pct)}%`;
    if (s.through >= 2) return `two closes through the ${L.name} (${L.price.toFixed(2)}): out at ${Math.round(pct)}%`;
  } else s.through = 0;
  return null;
}
const h90: Record<string, boolean> = {};
/** HOLD90: hard take profit; a clear winner rides for 90% of the max, backstopped at the TP line. */
function hold90Exit(r: NightRow, asset: string, bid: number, pct: number, a: AssetLike | undefined, bandsNow: Record<string, any> | null): string | null {
  const maxPct = (r.multiple - 1) * 100;
  if (h90[r.id]) {
    if (pct + 1e-9 >= maxPct * 0.9 || bid >= 0.97) return `clear winner held: banked +${Math.round(pct)}% (90% of the max)`;
    if (pct < r.tpPct) return `clear winner faded back to the +${r.tpPct}% line: banked it`;
    return null;
  }
  if (!(r.tpPct > 0 && pct + 1e-9 >= r.tpPct)) return null;
  const spot = Number(a?.spot) || 0;
  const tgt = Number(a?.target) || 0;
  const cushion = asset === "btc" ? 100 : 1.5;
  const past = spot > 0 && tgt > 0 ? (r.side === "up" ? spot - tgt : tgt - spot) : -1;
  let roadClear = false;
  if (past >= cushion && bandsNow?.[asset]) {
    const lo = Math.min(spot, tgt);
    const hi = Math.max(spot, tgt);
    roadClear = !dnaLines(asset, bandsNow[asset]).some((l) => l.price > lo && l.price < hi);
  }
  if (roadClear && maxPct * 0.9 > r.tpPct) {
    h90[r.id] = true;
    return null;
  }
  return `take profit +${r.tpPct}%${past >= cushion ? " (a line sits between price and the strike)" : " (not clear enough to hold)"}`;
}

/** BANK's exits beyond the take profit. Returns a reason to sell, or null to hold. */
const x5Seen: Record<string, number> = {};
/** 5M CLOSE EXIT: the line named in the entry; long = first 5m close below it, short = first 5m close above it. */
function band5Exit(r: NightRow, asset: string, pct: number, bandsNow: Record<string, any> | null): string | null {
  const b = bandsNow?.[asset];
  const nav = b?.nav;
  const c5 = Number(nav?.close5m) || 0;
  const at = Number(nav?.close5mAt) || 0; // the closed 5m candle's start (seconds)
  if (!(c5 > 0) || !at) return null;
  if (at < Math.floor(Date.parse(r.at) / 1000 / 300) * 300) return null; // only candles from the entry on
  if (x5Seen[r.id] === at) return null;
  x5Seen[r.id] = at;
  const s = r.setup || "";
  let L: number | null = null;
  let name = "";
  const m = s.match(/(1|5|10|15)m (?:nav )?(purple|upper|lower)/);
  if (m) {
    const f = nav?.[`m${m[1]}`];
    L = f ? Number(m[2] === "purple" ? f.c : m[2] === "upper" ? f.up : f.dn) || null : null;
    name = `${m[1]}m ${m[2]}`;
  } else {
    const sg = s.match(/([+\-−]?\d+(?:\.\d+)?)σ/);
    if (sg && b?.vwap > 0 && b?.sd > 0) {
      L = Number(b.vwap) + Number(sg[1].replace("−", "-")) * Number(b.sd);
      name = `${sg[1]}σ`;
    } else if (/VWAP/i.test(s) && b?.vwap > 0) {
      L = Number(b.vwap);
      name = "VWAP";
    }
  }
  if (!(L && L > 0)) return null;
  const wrong = r.side === "up" ? c5 < L : c5 > L;
  return wrong ? `5m close ${c5.toFixed(2)} on the other side of the ${name} (${L.toFixed(2)}): out at ${pct >= 0 ? "+" : ""}${Math.round(pct)}%` : null;
}
function bankExit(r: NightRow, asset: string, bid: number, pct: number, st: Record<string, { peakBid: number; touch: { L: number; name: string; minute: number } | null }>, bandsNow: Record<string, any> | null, cfg: { arm: number; give: number; band: boolean } = { arm: 30, give: 5, band: true }): string | null {
  const s = (st[r.id] ||= { peakBid: 0, touch: null });
  s.peakBid = Math.max(s.peakBid, bid);
  // 1. Trailing gate: armed at +arm%, sells give% under the highest bid she reached.
  if (r.peakPct >= cfg.arm && pct > 0 && bid <= s.peakBid * (1 - cfg.give / 100)) {
    const peakPct = Math.round((s.peakBid / r.ask - 1) * 100);
    return `trailing gate: peaked +${peakPct}%, banked ${cfg.give}% off the high (+${Math.round(pct)}%)`;
  }
  if (!cfg.band) return null;
  // 2. Band tap: break = hold, rejection = bank (only in profit).
  const b = bandsNow?.[asset];
  const nav = b?.nav;
  const live = nav?.live1m as { t: number; h: number; l: number; c: number } | null | undefined;
  const c1 = Number(nav?.close1m) || 0;
  const c1At = Number(nav?.close1mAt) || 0;
  if (!b || !live || !(c1 > 0)) return null;
  const tol = asset === "btc" ? 15 : 0.3;
  const up = r.side === "up";
  if (s.touch && c1At >= s.touch.minute) {
    const L = s.touch.L;
    const broke = up ? c1 > L : c1 < L;
    const name = s.touch.name;
    s.touch = null;
    if (!broke && pct > 0) return `band rejection at the ${name}: banked +${Math.round(pct)}%`;
    if (broke) return null; // broke through: hold
  }
  if (!s.touch) {
    const lines = dnaLines(asset, b);
    const hit = lines
      .filter((l) => (up ? l.price > c1 && live.h >= l.price - tol : l.price < c1 && live.l <= l.price + tol))
      .sort((x, y) => (up ? x.price - y.price : y.price - x.price))[0];
    if (hit) s.touch = { L: hit.price, name: hit.name, minute: live.t };
  }
  return null;
}

/** Settle what was held to the bell with Kalshi's real result. */
// Love (4:35 AM): a short review on every closed trade.
function review(r: NightRow): NonNullable<NightRow["notes"]> {
  const worked: string[] = [];
  const better: string[] = [];
  const keep: string[] = [];
  const b = (r.bands ?? null) as { vwap?: number; sd?: number; nav?: Record<string, { c: number; up: number; dn: number } | null> } | null;
  const spot = Number(r.spot) || 0;
  const thr = r.asset === "btc" ? 100 : 2.5;
  const wonAtBell = r.bell ? (r.side === "up" ? r.bell === "yes" : r.bell === "no") : null;
  const maxPct = (r.multiple - 1) * 100;
  // Entry against the lines she watches
  if (b && spot > 0) {
    const lines: [string, number][] = [];
    if (b.vwap && b.sd) for (const m of [-2, -1.5, -1, -0.5, 0, 0.5, 1, 1.5, 2]) lines.push([m === 0 ? "session VWAP" : `${m > 0 ? "+" : ""}${m}σ`, b.vwap + m * b.sd]);
    for (const k of ["m5", "m10", "m15"]) if (b.nav?.[k]) lines.push([`${k.slice(1)}m purple`, b.nav[k]!.c]);
    const against = lines.filter(([, L]) => (r.side === "up" ? L >= spot && L - spot <= thr : L <= spot && spot - L <= thr));
    const support = lines.filter(([, L]) => (r.side === "up" ? L < spot && spot - L <= thr : L > spot && L - spot <= thr));
    if (against.length) better.push(`Entered with the ${against.map(([n]) => n).join(" + ")} right ${r.side === "up" ? "above" : "below"} her. ${r.book === "golden" && r.at < "2026-10-02T22:02:00Z" ? "GOLDEN ran without her DNA until 3:02 PM; it carries it now." : "Her DNA blocks this now."}`);
    else worked.push(`Clean entry: no band right ${r.side === "up" ? "above the long" : "below the short"}.`);
    if (support.length) worked.push(`Had the ${support.map(([n]) => n).join(" + ")} ${r.side === "up" ? "under her as a floor" : "over her as a ceiling"}.`);
  }
  if (r.multiple >= 3) better.push(`${r.multiple.toFixed(2)}x is a long shot; these need a strong reason.`);
  // Exit
  const pnl = Number(r.pnl) || 0;
  if (r.result === "sold") {
    const gaveBack = r.peakPct - (r.sellBid && r.ask ? (r.sellBid / r.ask - 1) * 100 : 0);
    const tp = /take profit/.test(r.exit ?? "");
    if (wonAtBell === true && tp) worked.push(`Take profit banked ${pnl >= 0 ? "+" : ""}${pnl} of the ${r2(r.stake / r.ask - r.stake)} it paid at the bell.`);
    else if (wonAtBell === true) better.push(`Sold early but it won at the bell: holding paid ${r2(r.stake / r.ask - r.stake)} vs ${pnl >= 0 ? "+" : ""}${pnl}. That exit had no good reason.`);
    else if (wonAtBell === false) worked.push(`Exit saved it: it lost at the bell, she banked ${pnl >= 0 ? "+" : ""}${pnl} instead of -${r.stake}.`);
    if (gaveBack > 15) better.push(`Peaked +${Math.round(r.peakPct)}% but sold ${Math.round(gaveBack)} points lower.`);
    if (/take profit/.test(r.exit ?? "")) keep.push("Take profit + trail did its job.");
  } else if (r.result === "win") {
    worked.push(`Held to the bell and won ${pnl >= 0 ? "+" : ""}${pnl}.`);
    if (r.peakPct >= maxPct * 0.75) keep.push("Riding winners past the line pays.");
  } else if (r.result === "loss") {
    if (r.peakPct >= 20) better.push(`Was up +${Math.round(r.peakPct)}% and still lost: a gate/lock with a reason should bank these.`);
    else better.push("Never went green: the setup didn't follow through.");
  }
  if (r.event) better.push(`Taken during the ${r.event}: news windows whip both ways.`);
  if (!worked.length && !better.length) keep.push("Nothing stood out; keep watching.");
  if (r.book !== "original" && !better.length) keep.push("Do more of exactly this.");
  return { worked, better, keep, v: 2 } as NonNullable<NightRow["notes"]>;
}

// SETTLE (Claude, Oct 3 ~4:30 PM PT, Love: "SHIFT still shows open on positions that closed last window"): windows that
// closed settle FIRST, every pass; the old-review backfill is capped per pass. Updates are applied to a FRESH read of the
// ledger by id, so a slow pass can never overwrite trades booked while it was waiting on Kalshi.
function closedWindow(ticker: string): boolean {
  const m = ticker.match(/-(\d\d)([A-Z]{3})(\d\d)(\d\d)(\d\d)/);
  if (!m) return true;
  const mon = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"].indexOf(m[2]);
  if (mon < 0) return true;
  // Kalshi tickers are New York time: EDT (UTC-4) Mar-Oct, EST (UTC-5) otherwise (close enough for "has it closed").
  const off = mon >= 2 && mon <= 9 ? 4 : 5;
  const close = Date.UTC(2000 + Number(m[1]), mon, Number(m[3]), Number(m[4]) + off, Number(m[5]));
  return Date.now() >= close;
}
export async function nightSettle(result: (ticker: string) => Promise<"yes" | "no" | null>) {
  if (g.__nightSettling) return;
  g.__nightSettling = true;
  try {
    const snapshot = read();
    const updates = new Map<string, Partial<NightRow>>();
    const cache = new Map<string, "yes" | "no" | null>();
    const ask = async (tk: string) => {
      if (!cache.has(tk)) cache.set(tk, await result(tk).catch(() => null));
      return cache.get(tk) ?? null;
    };
    // 1. Open trades whose window has closed: settle them now.
    for (const r of snapshot) {
      if (r.result !== "open" || !closedWindow(r.ticker)) continue;
      const res = await ask(r.ticker);
      if (!res) continue;
      const won = (r.side === "up" && res === "yes") || (r.side === "down" && res === "no");
      const fee0 = FEE_BOOKS.has(r.book) ? Number((r as { entryFee?: number }).entryFee) || 0 : 0;
      const hb = r.book === "brickch" ? Number((r as { halfBid?: number }).halfBid) || 0 : 0;
      const pnlBell = hb > 0 ? r2((r.stake / r.ask / 2) * (hb + (won ? 1 : 0)) - r.stake) : r2((won ? r.stake / r.ask - r.stake : -r.stake) - fee0);
      const done = { ...r, result: (won ? "win" : "loss") as NightRow["result"], exit: hb > 0 ? `half sold at ${Math.round(hb * 100)}c, rest held to the bell` : "held to the bell", pnl: pnlBell, bell: res };
      updates.set(r.id, { result: done.result, exit: done.exit, pnl: done.pnl, bell: res, notes: review(done as NightRow) });
    }
    // 2. Sold-early trades still waiting on the bell's answer / a review: a few per pass.
    let budget = 15;
    for (const r of snapshot) {
      if (budget <= 0) break;
      if (r.result === "open" || !closedWindow(r.ticker)) continue;
      if (r.notes && r.bell != null && (r.notes as { v?: number }).v === 2) continue;
      budget -= 1;
      const res = r.bell ?? (await ask(r.ticker));
      if (!res) continue;
      updates.set(r.id, { bell: res, notes: review({ ...r, bell: res } as NightRow) });
    }
    if (updates.size) {
      const fresh = read();
      for (const r of fresh) {
        const u = updates.get(r.id);
        if (!u) continue;
        if (u.result && r.result !== "open") continue; // it was sold meanwhile: keep that
        Object.assign(r, u);
      }
      // EXIT LEDGER (Love, Oct 5 ~12:45 AM PT: "can you start tracking when and when not to use them... down the line can we
      // refine?"). night-book.json only keeps the last 2000 rows (~15 hours), so every settled row is also written once,
      // forever, to data/exit-ledger.jsonl: how it exited, how high it got, and what holding to the bell would have paid.
      // That is the record the gates / lock the win / take profits get tuned from later (by hour, book, multiple, asset).
      try {
        const lines: string[] = [];
        for (const r of fresh) {
          const x = r as NightRow & { arch?: boolean; bell?: string | null };
          if (x.arch || r.result === "open" || (x.bell !== "yes" && x.bell !== "no")) continue;
          const won = (r.side === "up" && x.bell === "yes") || (r.side === "down" && x.bell === "no");
          lines.push(JSON.stringify({ id: r.id, book: r.book, asset: r.asset, side: r.side, at: r.at, hourPT: (r as { hourPT?: number }).hourPT, setup: r.setup, ask: r.ask, multiple: r.multiple, stake: r.stake, peakPct: (r as { peakPct?: number }).peakPct, troughPct: (r as { troughPct?: number }).troughPct, result: r.result, exit: (r as { exit?: string }).exit, soldAt: r.soldAt, sellBid: (r as { sellBid?: number }).sellBid, exitMult: (r as { exitMult?: number }).exitMult, exitCushion: (r as { exitCushion?: number }).exitCushion, exitLeft: (r as { exitLeft?: number }).exitLeft, pnl: r.pnl, bell: x.bell, heldPnl: won ? r2(r.stake / r.ask - r.stake) : -r.stake, stale: (r as { stale?: boolean }).stale || undefined, dnaMode: r.dnaMode }));
          x.arch = true;
        }
        if (lines.length) appendFileSync(join(process.cwd(), "data", "exit-ledger.jsonl"), lines.join("\n") + "\n");
      } catch {
      }
      write(fresh);
    }
  } finally {
    g.__nightSettling = false;
  }
}
