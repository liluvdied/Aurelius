  const t = Date.parse("2026-10-03T03:28:48Z") / 1000;
  for (const sym of ["VANTAGE:BTCUSD", "OANDA:BTCUSD", "COINBASE:BTCUSD", "INDEX:BTCUSD", "PEPPERSTONE:BTCUSD"]) {
