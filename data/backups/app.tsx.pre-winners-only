    diamond: "OFF · 2–8p (chop after the 2 PM reset)",
    diamond25: "OFF · 2–8p (chop after the 2 PM reset)",
  };
  const Col = ({ book, title, note, s }: { book: ShiftNight["book"]; title: string; note: string; s: ReturnType<typeof side> }) => {
    const c = s.pnl >= 0 ? SHIFT_UP : SHIFT_DOWN;
