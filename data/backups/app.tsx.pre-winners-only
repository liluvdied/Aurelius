  // What each trade would have done at that take profit (Love: "show what the trades would have closed at, or whether
  // they would have closed at all"): winners at the bell close at the line (or pay the full max if the line is past it);
  // losers that peaked past the line are saved there; the rest lose the stake at the bell.
  const bellWin = (r: ShiftNight) => (r.bell === "yes" || r.bell === "no" ? (r.bell === "yes") === (r.side === "up") : null);
  const maxP = (r: ShiftNight) => (Number(r.multiple) - 1) * 100;
  const atX = (r: ShiftNight): { pnl: number; how: string } => {
    const bw = bellWin(r);
    if (bw === null) return { pnl: r.pnl ?? 0, how: "not settled" };
    const L = lvl(r);
    if (bw) return L >= maxP(r) - 1e-9 ? { pnl: (r.stake * maxP(r)) / 100, how: "rides to the bell · WIN" } : { pnl: (r.stake * L) / 100, how: `closes at +${Math.round(L)}%` };
    if ((r.peakPct ?? 0) + 1e-9 >= L) return { pnl: (r.stake * L) / 100, how: `closes at +${Math.round(L)}% · saved a loser` };
    return { pnl: -r.stake, how: "never got there · LOSS at the bell" };
  };
  const atTp = done.reduce((t, r) => t + atX(r).pnl, 0);
  const soldEarly = done.filter((r) => r.result === "sold" && bellWin(r) !== null);
  const soldWouldWin = soldEarly.filter((r) => bellWin(r)).length;
  const [paperTp, setPaperTpState] = useState<number | null>(null);
  useEffect(() => {
    getPaperTp().then((v) => setPaperTpState(v)).catch(() => {});
  }, []);
  const soldPct = (r: ShiftNight) => (r.pnl != null && r.stake > 0 ? Math.round((r.pnl / r.stake) * 100) : null);
