type ClaudeBtRow = { ticker: string; at: string; asset: string; side: string; setup: string; multiple: number; hourPT: number; claude: boolean; why: string | null; claudePnl: number | null; claudeExit: string | null; newPnl: number | null; newExit: string | null; origPnl: number | null; bell: string | null; cat: string };
type ClaudeBt = { at: string; night: ClaudeBtRow[]; week: { half: string; group: string; n: number; winPct: number; roiPct: number; pnl10: number }[] } | null;

// CLAUDE BACKTEST: which setups CLAUDE would have taken that the others didn't (and the reverse).
function ClaudeBacktestCard({ bt: btIn, scale = 1 }: { bt: ClaudeBt; scale?: number }) {
  const bt = useMemo(
    () => (btIn ? { ...btIn, night: btIn.night.map((r) => ({ ...r, claudePnl: r.claudePnl == null ? null : r.claudePnl * scale, newPnl: r.newPnl == null ? null : r.newPnl * scale, origPnl: r.origPnl == null ? null : r.origPnl * scale })), week: btIn.week.map((w) => ({ ...w, pnl10: w.pnl10 * scale })) } : null),
    [btIn, scale],
  );
  const [cat, setCat] = useState<"claude-only" | "both" | "others-only" | "all">("claude-only");
  const [limit, setLimit] = useState(30);
  if (!bt) return null;
  const sum = (xs: ClaudeBtRow[], k: "claudePnl" | "newPnl" | "origPnl") => xs.reduce((t, r) => t + (Number(r[k]) || 0), 0);
  const by = (c: string) => bt.night.filter((r) => r.cat === c);
  const took = bt.night.filter((r) => r.claude);
  const tiles = [
    { c: "claude-only", title: "ONLY CLAUDE TOOK", xs: by("claude-only"), main: "claudePnl" as const, sub: "NEW didn't take these" },
    { c: "both", title: "CLAUDE + NEW BOTH TOOK", xs: by("both"), main: "claudePnl" as const, sub: `NEW made ${shiftMoney(sum(by("both"), "newPnl"))} on the same trades` },
    { c: "others-only", title: "CLAUDE PASSED", xs: by("others-only"), main: "newPnl" as const, sub: `what NEW made on them · ORIGINAL ${shiftMoney(sum(by("others-only"), "origPnl"))}` },
  ];
  const list = cat === "all" ? bt.night : bt.night.filter((r) => r.cat === cat);
  const money = (v: number | null) => (v == null ? "—" : shiftMoney(v));
  const col = (v: number | null) => (v == null ? "rgba(255,255,255,0.45)" : v >= 0 ? SHIFT_UP : SHIFT_DOWN);
  return (
    <section className="rounded-[22px] border border-white/25 px-5 py-4 shadow-[0_0_18px_rgba(255,255,255,0.06)]">
      <div className="flex items-baseline justify-between gap-3">
        <p className="text-[10px] tracking-[0.28em] text-white/90">CLAUDE ✦ BACKTEST</p>
        <p className="text-[9px] tracking-[0.2em] text-white/50">AS OF {shiftClock(bt.at)}</p>
      </div>
      <p className="mt-1 text-[10px] leading-snug text-white/55">
        Every setup since the night book began, replayed with CLAUDE's list and exits on the real Kalshi bid path. CLAUDE took {took.length} of {bt.night.length}:{" "}
        <span style={{ color: col(sum(took, "claudePnl")) }}>{shiftMoney(sum(took, "claudePnl"))}</span>.
      </p>
      <div className="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-3">
        {tiles.map((t) => {
          const v = sum(t.xs, t.main);
          const on = cat === t.c;
          return (
            <button key={t.c} type="button" onClick={() => { setCat(on ? "all" : (t.c as typeof cat)); setLimit(30); }} className="flex flex-col gap-1 rounded-2xl border px-4 py-3 text-left" style={{ borderColor: on ? col(v) : "rgba(255,255,255,0.2)" }}>
              <p className="text-[10px] tracking-[0.22em] text-white">{t.title} · {t.xs.length}</p>
              <p className="font-mono text-xl tabular-nums" style={{ color: col(v), textShadow: `0 0 10px ${col(v)}` }}>{shiftMoney(v)}</p>
              <p className="text-[9px] leading-snug text-white/55">{t.sub}</p>
            </button>
          );
        })}
      </div>
      <div className="mt-3 flex flex-col gap-1.5">
        {list.slice(0, limit).map((r) => (
          <details key={r.ticker} className="rounded-2xl border border-white/15 px-4 py-1.5">
            <summary className="flex cursor-pointer list-none items-center justify-between gap-3">
              <span className="truncate text-[10px] tracking-[0.14em] text-white/85">
                {shiftClock(r.at)} · {r.asset.toUpperCase()} {r.side === "up" ? "LONG" : "SHORT"} · {Number(r.multiple).toFixed(2)}x · {r.claude ? "CLAUDE ✓" : "CLAUDE ✕"}
              </span>
              <span className="shrink-0 font-mono text-[11px] tabular-nums">
                <span style={{ color: col(r.claudePnl) }}>C {money(r.claudePnl)}</span> · <span style={{ color: col(r.newPnl) }}>N {money(r.newPnl)}</span>
              </span>
            </summary>
            <div className="mt-1.5 flex flex-col gap-1 pb-1 text-[11px] leading-snug text-white/70">
              <p>{r.setup} · {r.hourPT}:00 PT · bell {r.bell === "yes" ? "UP" : r.bell === "no" ? "DOWN" : "—"}</p>
              {r.claude ? <p style={{ color: SHIFT_UP }}>CLAUDE took it · {r.claudeExit}</p> : <p style={{ color: SHIFT_DOWN }}>CLAUDE passed: {r.why}</p>}
              <p>NEW {r.newPnl == null ? "didn't take it" : `${money(r.newPnl)} · ${r.newExit ?? ""}`} · ORIGINAL {money(r.origPnl)}</p>
            </div>
          </details>
        ))}
        {list.length > limit ? (
          <button type="button" onClick={() => setLimit(list.length)} className="rounded-2xl border border-white/25 py-2 text-[10px] tracking-[0.22em] text-white/80">SHOW ALL {list.length}</button>
        ) : null}
      </div>
      <p className="mt-4 text-[10px] tracking-[0.24em] text-white/80">THE WEEK · {bt.week.find((w) => w.group === "ALL") ? `SEP 24 – OCT 2 · $${Math.round(50 * scale)} A TRADE` : ""}</p>
      <div className="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {["Sep 24-27", "Sep 28-Oct 2"].map((h) => (
          <div key={h} className="rounded-2xl border border-white/15 px-4 py-3">
            <p className="text-[10px] tracking-[0.22em] text-white/85">{h.toUpperCase()}</p>
            {bt.week.filter((w) => w.half === h).map((w) => (
              <p key={w.group} className="mt-1 flex justify-between font-mono text-[11px] tabular-nums text-white/80">
                <span>{w.group} · {w.n}</span>
                <span>{w.winPct}% W · <span style={{ color: col(w.pnl10) }}>{shiftMoney(w.pnl10)}</span></span>
              </p>
            ))}
          </div>
        ))}
      </div>
      <p className="mt-2 text-[9px] leading-snug text-white/45">
        The week is in-sample: CLAUDE's list was chosen from it. The replay leaves out gates / LOCK THE WIN (CLAUDE's only bank profit) and the path guard (rows don't keep the strike), so it reads a little conservative.
      </p>
    </section>
  );
}

