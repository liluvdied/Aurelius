              when={`${shiftClock(r.at)} · BOOK SAID ${r.result.toUpperCase()}${r.multiple ? ` · ${Number(r.multiple).toFixed(2)}x` : ""}`}
              asset={r.asset}
              side={r.side}
              setup={r.pattern || ""}
              left={null}
              right={r.ticker && live.has(k) ? (live.get(k) ?? 0) : "none"}
            />
          );
        })}
      </div>
      {done.length > 12 ? (
        <button type="button" onClick={() => setAll((v) => !v)} className="self-center rounded-full border border-white/30 px-4 py-1.5 text-[10px] tracking-[0.22em] text-white/80">
          {all ? "SHOW LESS" : `SHOW ALL ${done.length}`}
        </button>
      ) : null}
    </div>
  );
}
