    const wins = done.filter((r) => (r.pnl ?? 0) > 0.05).length;
    const losses = done.filter((r) => (r.pnl ?? 0) < -0.05).length;
    return { n: xs.length, open: xs.length - done.length, pnl, wins, losses };
  };
  const BOOKS: { book: ShiftNight["book"]; title: string; note: string }[] = [
    { book: "bank", title: "BANK ⛨", note: "ORIGINAL's DNA-clean entries with her banking exits: after +30%, sells 5% off the highest bid; taps a band and the 1m candle rejects = banks it, breaks through = holds. Never sells at a loss." },
