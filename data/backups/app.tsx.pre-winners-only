  const list0 = pick === "all" ? rowsAll.filter((r) => !isTap(r.book)) : pick === "taps" ? rowsAll.filter((r) => isTap(r.book)) : pick === "origClean" ? rows.filter((r) => r.book === "original" && !bandErr(r)) : rowsAll.filter((r) => r.book === pick);
  // Love, Oct 3 ~12:50 AM PT: "she looks like she's erroring out" -> frozen-feed rows are never shown (never counted).
