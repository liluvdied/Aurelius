        <p className="mt-1 font-mono text-2xl tabular-nums" style={{ color: c, textShadow: `0 0 10px ${c}` }}>{shiftMoney(s.pnl)}</p>
        <p className="font-mono text-[11px] tabular-nums text-white/80">
