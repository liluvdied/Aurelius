    { book: "sole10", title: "10M · SOLE", note: "The same, judged ONLY by the session bands + the 10m nav. The middle point." },
    { book: "sole15", title: "15M · SOLE", note: "The same, judged ONLY by the session bands + the 15m nav." },
    { book: "confirm", title: "CONFIRM ⇄ · BTC", note: "Love's hunch: a band break on Pepperstone or Vantage, entered only when the OTHER feed breaks the same line the same way within 60 seconds. Her 25% channel rule, 1.38x+." },
    { book: "brk1", title: "FIRST BREAK · BTC", note: "The control: enters the moment either feed breaks one of her lines, no confirmation. Same rules. If CONFIRM beats this, your hunch is right." },
    { book: "diamond", title: "DIAMOND ◆", note: "Her best stretches, reinforced: already through the strike (nothing between her and it), no purple/Bollinger right in front, bands open (BTC σ ≥ $150, gold ≥ $5), no 2–7 PM PT chop." },
    { book: "brick", title: "BRICK ▣", note: "Entry logic rewritten from scratch by Claude. A closed 5m candle rejects or breaks one of her lines; the road to the strike must be clear of every band and nav line, and nothing sits right in front (BTC: purple/Bollinger $100, bands $25 · gold $0.75–2.50)." },
    { book: "cotc", title: "C O T C ♛", note: "Cream of the crop: only the 8 setups that won 75%+ over 15+ trades. Gold long taps at −1.5σ / −2σ / +1.5σ, gold Open −0.5σ, gold retests, BTC short taps at +1σ / +1.5σ, BTC close above +1σ." },
    { book: "trend", title: "CLAUDE · TREND", note: "CLAUDE, but gold follows the trend: under the session VWAP and the 15m purple = shorts only; above both = longs only." },
    { book: "claude", title: "CLAUDE ✦", note: "Claude's pick: gold longs (taps, retests, clock, nav close), BTC short taps, BTC close-above longs. Nav + path guards, her worst hours, no-loss gates." },
    { book: "golden", title: "GOLDEN · OCT 1 12:45–3:30", note: "Her Oct 1 afternoon model on its own feeds (BTC session from 5 PM PT, gold bands on 15m, her TP table) — and since 3:02 PM, her true DNA." },
    { book: "optA", title: "OPTION A", note: "NEW, but BTC entries read the 5 PM-start bands. Her 2 PM bands still run nav / path / hour rules." },
    { book: "optB", title: "OPTION B", note: "NEW, but no BTC entries 2:00–3:59 PM PT, right after the session reset." },
    { book: "refined", title: "REFINED", note: "NEW + morning fixes: no BTC purple-close entries, a gate or lock never sells under breakeven after a gap." },
    { book: "new", title: "NEW", note: "Every rule tonight. Nav skip + nav-close entries, worst hours, TP 50/75% of max, LOCK THE WIN." },
    { book: "original", title: "ORIGINAL", note: "Her table 33/44/50/60/max−15, no hours, no lock. Carries her DNA since 11:55 AM: never a line right in front, never a line between her and the strike." },
  ];
  // TAPS live in their own tab (Love: "not the vibe" to have $2.50 lotto tickets paint the whole ledger red).
  const ranked = BOOKS.filter((b) => !isTap(b.book)).map((b) => ({ ...b, s: side(b.book) })).sort((a, b) => b.s.pnl - a.s.pnl);
  const tapRanked = BOOKS.filter((b) => isTap(b.book)).map((b) => ({ ...b, s: side(b.book) })).sort((a, b) => b.s.pnl - a.s.pnl);
  const [pick, setPick] = useState<ShiftNight["book"] | "all" | "origClean" | "taps">("all");
  // DIAMOND classic vs DIAMOND on her 25% logic, toggled inside the DIAMOND card (Love, Oct 3 ~1:30 AM PT).
  const [dFlavor, setDFlavor] = useState<"diamond" | "diamond25">("diamond");
  // ORIGINAL without her band errors (Love: "that's what she looks like"): every ORIGINAL trade whose
  // own review says she entered with a line right above a long / right below a short is set aside.
  const bandErr = (r: ShiftNight) => (r.notes?.better ?? []).some((t) => /right (above|below) her/.test(t));
  const origDone = rows.filter((r) => r.book === "original" && r.result !== "open" && r.pnl != null);
  const statOf = (xs: ShiftNight[]) => ({ n: xs.length, pnl: xs.reduce((t, r) => t + (r.pnl ?? 0), 0), wins: xs.filter((r) => (r.pnl ?? 0) > 0.05).length, losses: xs.filter((r) => (r.pnl ?? 0) < -0.05).length });
  const clean = statOf(origDone.filter((r) => !bandErr(r)));
  const errs = statOf(origDone.filter(bandErr));
  const allO = statOf(origDone);
  const [limit, setLimit] = useState(40);
  const LABEL: Record<string, string> = { original: "ORIG", new: "NEW", refined: "REFINED", golden: "GOLDEN", optA: "OPT A", optB: "OPT B", claude: "CLAUDE", trend: "TREND", brick: "BRICK", cotc: "COTC", diamond: "DIAMOND", diamond25: "DIAMOND 25%", confirm: "CONFIRM", brk1: "1ST BREAK", sole5: "5M SOLE", sole10: "10M SOLE", sole15: "15M SOLE", bank: "BANK", bank2: "BANK 2", brk: "BREAK", hold90: "HOLD 90", tap3x: "TAP 3x", taphold: "TAP HOLD", rescue: "RESCUE", hour: "HOURLY" };
