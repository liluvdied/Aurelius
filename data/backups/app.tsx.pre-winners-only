  // Trades booked while the BTC feed was frozen (OANDA closed for the weekend, Fri 2:00-5:24 PM PT) are
  // listed but never counted: they were decided on a price that wasn't moving.
  const rows = useMemo(() => rowsAll.filter((r) => !r.stale), [rowsAll]);
  // Head to head: every ledger counted from the moment REFINED + GOLDEN started (fair comparison).
  // Seven-ledger start (CLAUDE / OPTION A / OPTION B arrived 8:45 AM PT Oct 2); fall back to REFINED + GOLDEN.
  const firstOf = (books: string[]) => rows.filter((r) => books.includes(r.book)).reduce((m, r) => (r.at < m ? r.at : m), "9999");
  const seven = "2026-10-02T15:45:00.000Z";
  // Ten-ledger start (TREND / BRICK / COTC arrived 10:15 AM PT Oct 2).
  const ten = "2026-10-02T17:15:00.000Z";
  const since = rows.some((r) => r.book === "brick" || r.book === "cotc" || r.book === "trend") ? ten : rows.some((r) => r.book === "claude" || r.book === "optB") ? seven : firstOf(["golden", "refined"]);
  const h2h = since !== "9999";
  const side = (book: ShiftNight["book"]) => {
    const xs = rows.filter((r) => r.book === book && (!h2h || r.at >= since));
    const done = xs.filter((r) => r.result !== "open" && r.pnl != null);
