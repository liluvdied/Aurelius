import { useMemo as useShiftMemo, useState as useShiftState } from "react";
import type { FillEvent as ShiftFill } from "@/lib/desk/fill-log";
import type { HeldOrder as ShiftHeld } from "@/lib/desk/fns";

// SHIFT — the book that starts when Claude took over the desk.
// Kalshi live only. One row per 15-minute window. Pure black; light comes only from lines and numbers.

const SHIFT_UP = "#3ddc84";
const SHIFT_DOWN = "#ff5c5c";

type ShiftRow = { ticker: string; at: string; asset: string; side: string; setup: string; stake: number; multiple: number; pnl: number };

// A 15-minute window is over once its close time passes, even before Kalshi posts the result (Love, Oct 3).
function windowDone(ticker: string): boolean {
  const m = ticker.match(/-(\d\d)([A-Z]{3})(\d\d)(\d\d)(\d\d)/);
  if (!m) return false;
  const mon = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"].indexOf(m[2]);
  if (mon < 0) return false;
  const off = mon >= 2 && mon <= 9 ? 4 : 5;
  return Date.now() >= Date.UTC(2000 + Number(m[1]), mon, Number(m[3]), Number(m[4]) + off, Number(m[5]));
}
function shiftClock(at: string) {
  return new Date(at).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true });
}
function shiftDay(at: string) {
  return new Date(at).toLocaleDateString("en-US", { month: "short", day: "numeric" }).toUpperCase();
}
function shiftMoney(n: number) {
  const s = `$${Math.abs(n).toFixed(2)}`;
  return n > 0.004 ? `+${s}` : n < -0.004 ? `−${s}` : s;
}
const shiftGlow = (color: string, px = 10) => ({ textShadow: `0 0 ${px}px ${color}` });

function ShiftChip({ label, value, tone }: { label: string; value: string; tone?: "up" | "down" }) {
  const color = tone === "up" ? SHIFT_UP : tone === "down" ? SHIFT_DOWN : "#ffffff";
  return (
    <div className="flex min-w-[96px] flex-1 flex-col items-center gap-1 rounded-full border border-white/25 px-4 py-2 shadow-[0_0_14px_rgba(255,255,255,0.08)]">
      <span className="text-[9px] tracking-[0.24em] text-white/70">{label}</span>
      <span className="font-mono text-sm tabular-nums" style={{ color, ...shiftGlow(color, 8) }}>
        {value}
      </span>
    </div>
  );
}

function ShiftCurve({ rows }: { rows: ShiftRow[] }) {
  const [hover, setHover] = useShiftState<number | null>(null);
  const W = 640;
  const H = 200;
  const P = 18;
  const pts = useShiftMemo(() => {
    let run = 0;
    const out: { x: number; y: number; row: ShiftRow | null }[] = [{ x: 0, y: 0, row: null }];
    rows.forEach((row, i) => {
      run += row.pnl;
      out.push({ x: i + 1, y: Math.round(run * 100) / 100, row });
    });
    return out;
  }, [rows]);
  const ys = pts.map((p) => p.y);
  const lo = Math.min(0, ...ys);
  const hi = Math.max(0, ...ys);
  const span = hi - lo || 1;
  const sx = (x: number) => P + (x / Math.max(1, pts.length - 1)) * (W - 2 * P);
  const sy = (y: number) => H - P - ((y - lo) / span) * (H - 2 * P);
  const last = pts[pts.length - 1].y;
  const color = last >= 0 ? SHIFT_UP : SHIFT_DOWN;
  const path = pts.map((p, i) => `${i ? "L" : "M"}${sx(p.x).toFixed(1)},${sy(p.y).toFixed(1)}`).join(" ");
  const h = hover != null ? pts[hover] : null;
  return (
    <div className="relative" onMouseLeave={() => setHover(null)}>
      <svg viewBox={`0 0 ${W} ${H}`} className="h-[200px] w-full" preserveAspectRatio="none" onMouseLeave={() => setHover(null)}>
        <defs>
          <filter id="shift-shiftGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3" result="b" />
            <feMerge>
              <feMergeNode in="b" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
        <line x1={P} x2={W - P} y1={sy(0)} y2={sy(0)} stroke="rgba(255,255,255,0.28)" strokeDasharray="3 6" strokeWidth="1" vectorEffect="non-scaling-stroke" />
        <path d={path} fill="none" stroke={color} strokeWidth="2" filter="url(#shift-shiftGlow)" vectorEffect="non-scaling-stroke" strokeLinejoin="round" />
      </svg>
      {pts.map((p, i) =>
        i === 0 ? null : (
          <button
            key={i}
            type="button"
            aria-label={`Close ${i}`}
            onMouseEnter={() => setHover(i)}
            onFocus={() => setHover(i)}
            onClick={() => setHover(i)}
