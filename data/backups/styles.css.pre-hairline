@import "tailwindcss" source(".");

@theme {
  --font-sans: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --font-display: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
  --color-bg: #000000;
  --color-surface: #000000;
  --color-elevated: #000000;
  --color-fg: #ffffff;
  --color-muted: #ffffff;
  --color-subtle: #f3f3f3;
  --color-line: rgba(255, 255, 255, 0.22);
  --color-line-strong: rgba(255, 255, 255, 0.45);
  --color-accent: #ffffff;
  --color-accent-fg: #000000;
  --color-up: #3ddc84;
  --color-down: #ff5c5c;
  --color-warn: #e7c56a;
  --radius-xs: 4px;
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-xl: 24px;
}

@layer base {
  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: var(--color-bg);
    color: var(--color-fg);
  }
  html,
  body,
  #app {
    min-height: 100%;
    background: var(--color-bg);
  }
  html,
  body {
    overflow-x: hidden;
    overflow-y: auto;
    height: auto;
    touch-action: manipulation;
    -webkit-overflow-scrolling: touch;
  }
  body {
    font-family: var(--font-sans);
    letter-spacing: -0.011em;
  }
  button:not(:disabled),
  [role="button"]:not(:disabled) {
    cursor: pointer;
  }
  ::selection {
    background: color-mix(in oklab, var(--color-fg) 22%, transparent);
    color: var(--color-fg);
  }
}

@layer utilities {
  .hairline {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.28);
  }
  .hairline-soft {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.2);
  }
  .glow-live {
    box-shadow: 0 0 8px color-mix(in oklab, var(--color-fg) 55%, transparent);
  }
  .live-dot {
    background: #3ddc84;
    box-shadow: 0 0 8px #3ddc84;
    animation: live-blink 1.1s ease-in-out infinite;
  }
  .firewall-on {
    background: #3ddc84;
    box-shadow: 0 0 10px #3ddc84;
  }
  .firewall-bad {
    background: #ff2d2d;
    box-shadow: 0 0 12px #ff2d2d;
    animation: firewall-flash 0.5s ease-in-out infinite;
  }
  .glass-range {
    appearance: none;
    height: 22px;
    background: transparent;
    border: none;
  }
  .glass-range::-webkit-slider-runnable-track {
    height: 8px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.35);
  }
  .glass-range::-webkit-slider-thumb {
    appearance: none;
    height: 18px;
    width: 18px;
    margin-top: -6px;
    border-radius: 999px;
    border: 1px solid #fff;
    background: #000;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.45);
  }
  .glass-range::-moz-range-track {
    height: 8px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.35);
  }
  .glass-range::-moz-range-thumb {
    height: 18px;
    width: 18px;
    border-radius: 999px;
    border: 1px solid #fff;
    background: #000;
  }
  .desk-pill {
    display: inline-flex;
    height: 24px;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-radius: 3px;
    border: 1px solid #fff;
    background: #000;
    padding: 0 8px;
    font-size: 10px;
    letter-spacing: 0.04em;
    color: #fff;
  }
}

@keyframes live-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.2;
  }
}

@keyframes aurelius-ring {
  0% {
    transform: scale(1);
    opacity: 0.45;
  }
  100% {
    transform: scale(2.8);
    opacity: 0;
  }
}

@keyframes firewall-flash {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.2;
  }
}

[data-sonner-toaster][data-y-position="top"] [data-sonner-toast][data-front="false"] {
  height: var(--front-toast-height) !important;
  overflow: hidden;
}
[data-sonner-toaster][data-y-position="top"] [data-sonner-toast][data-index="1"] {
  transform: translateY(16px) scale(0.96) !important;
}
[data-sonner-toaster][data-y-position="top"] [data-sonner-toast][data-index="2"] {
  transform: translateY(-14px) scale(0.92) !important;
}
[data-sonner-toaster][data-y-position="top"] [data-sonner-toast][data-front="false"] > * {
  opacity: 0 !important;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* LOVE'S ETHEREAL FRAME (Claude, 2026-10-02 5:30 PM PT): every pill is a compact rounded rectangle
   (the shape of the desk tabs), every card a tighter rounded rectangle, and every white outline glows.
   Unlayered on purpose so it sits over the Tailwind utilities; inline colors (green / red states) still win. */
[class*="rounded-full"][class*="border"] {
  border-radius: 6px !important;
}
[class*="rounded-xl"],
[class*="rounded-2xl"],
[class*="rounded-3xl"],
[class*="rounded-[18px]"],
[class*="rounded-[20px]"],
[class*="rounded-[22px]"],
[class*="rounded-[24px]"] {
  border-radius: 9px !important;
}
[class*="border-white"] {
  border-color: rgba(255, 255, 255, 0.62);
  box-shadow: 0 0 10px rgba(255, 255, 255, 0.13), inset 0 0 8px rgba(255, 255, 255, 0.04);
}
.desk-pill {
  border-radius: 6px;
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.22);
}
.desk-tab-glow {
  border-color: rgba(255, 255, 255, 0.55) !important;
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.14);
}
.desk-tab-glow[data-active="true"] {
  border-color: #fff !important;
  box-shadow: 0 0 12px rgba(255, 255, 255, 0.45), inset 0 0 6px rgba(255, 255, 255, 0.12);
}
