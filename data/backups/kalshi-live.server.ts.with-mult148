// PART SELL (Love, Oct 3 ~2:50 PM PT: "25 - 50 - 75 - 100% buttons on the lil black ones at the bottom"). Sells that
// share of the open position right now (reduce-only, walks the bid down up to 5c like HALF). 100% uses CLOSE.
async function partLive(ticker, pct) {
  const frac = Math.max(0.01, Math.min(1, Number(pct) / 100));
  await clearResting(ticker);
  for (let pass = 0; pass < 3; pass += 1) {
    const open = await fifteenOpen();
    const row = open.find((item) => item.ticker === ticker);
    const pos = row?.pos ?? await signedPosition(ticker);
    if (!(Math.abs(pos) >= 0.02)) return null;
    const res = await fetch(`${ROOT}/trade-api/v2/markets/${ticker}`, { signal: AbortSignal.timeout(8000) });
    if (!res.ok) continue;
    const data = await res.json();
    const yesBid = Number.parseFloat(data.market?.yes_bid_dollars ?? "0");
    const noBid = Number.parseFloat(data.market?.no_bid_dollars ?? "0");
    const yesAsk = Number.parseFloat(data.market?.yes_ask_dollars ?? "0");
    const quote = screenBid(pos, yesBid, yesAsk, noBid, Number.parseFloat(data.market?.no_ask_dollars ?? "0"));
    const floor = Math.max(0.02, Math.round((quote - 0.05) * 100) / 100);
    const plan = halfCuts(pos, yesBid, noBid, yesAsk, 0, floor);
    if (!plan) continue;
    const want = Math.floor(Math.abs(pos) * frac * 100) / 100;
    if (!(want >= 0.01)) return null;
    for (const px of plan.prices) {
      try {
        const placed = await place(ticker, plan.bookSide, px, want.toFixed(2), true, undefined, false, true);
        if (!placed || !(placed.filled >= 0.01)) continue;
        const payout = closeCash(pos, px, placed.yesPrice, placed.filled);
        const left = Math.round((Math.abs(pos) - placed.filled) * 100) / 100;
        return { filled: placed.filled, payout: Math.round(payout * 100) / 100, left };
      } catch (err) {
        noteGate(ticker, "part", false, err instanceof Error ? err.message.slice(0, 140) : "part sell rejected");
      }
    }
  }
  return null;
}
// AUDIT (Claude, read only): Kalshi's own record of every fill and order, so the desk's ledger
// can be checked against the exchange. Writes data/kalshi-audit.json. Never sends anything.
async function auditKalshi() {
  const out = { at: new Date().toISOString(), fills: [], orders: [] };
  try {
    let cursor = "";
    for (let page = 0; page < 5; page += 1) {
      const f = await kalshi("GET", "/trade-api/v2/portfolio/fills", `?limit=200${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ""}`);
      if (!f.ok) {
        out.fillsError = f.status;
        break;
      }
      const data = await f.json();
      out.fills.push(...(data.fills ?? []).map((x) => ({ t: x.created_time, ticker: x.ticker, action: x.action, side: x.side, count: x.count_fp ?? x.count, yes: x.yes_price_dollars ?? x.yes_price, no: x.no_price_dollars ?? x.no_price, fee: x.fee_cost ?? null, order: String(x.order_id ?? "").slice(0, 13), taker: x.is_taker })));
      if (!data.cursor || !(data.fills ?? []).length) break;
      cursor = data.cursor;
    }
  } catch (err) {
    out.fillsError = String(err?.message || err);
  }
  try {
    const st = await kalshi("GET", "/trade-api/v2/portfolio/settlements", "?limit=200");
    if (st.ok) out.settlements = ((await st.json()).settlements ?? []).map((x) => ({ t: x.settled_time, ticker: x.ticker, result: x.market_result, value: x.value, revenue: x.revenue, fee: x.fee_cost ?? null, yesCount: x.yes_count_fp ?? x.yes_count, noCount: x.no_count_fp ?? x.no_count }));
  } catch {
  }
  try {
    const o = await kalshi("GET", "/trade-api/v2/portfolio/orders", "?limit=200");
    if (o.ok) out.orders = ((await o.json()).orders ?? []).map((x) => ({ t: x.created_time, ticker: x.ticker, action: x.action, side: x.side, status: x.status, type: x.type, count: x.fill_count_fp ?? x.fill_count, initial: x.initial_count_fp ?? x.initial_count, yes: x.yes_price_dollars ?? x.yes_price, id: String(x.order_id ?? "").slice(0, 13), client: x.client_order_id }));
    else out.ordersError = o.status;
  } catch (err) {
    out.ordersError = String(err?.message || err);
  }
  try {
    writeFileSync(join(process.cwd(), "data", "kalshi-audit.json"), JSON.stringify(out, null, 1));
  } catch {
  }
  return out;
}
// HISTORY (Claude, read only): every Kalshi fill + settlement we can page back through.
async function kalshiHistory() {
  const out = { at: new Date().toISOString(), fills: [], settlements: [] };
  for (const [path, key] of [["/trade-api/v2/portfolio/fills", "fills"], ["/trade-api/v2/portfolio/settlements", "settlements"]]) {
    let cursor = "";
    for (let page = 0; page < 40; page += 1) {
      const res = await kalshi("GET", path, `?limit=200${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ""}`);
      if (!res.ok) break;
      const data = await res.json();
      const rows = data[key] ?? [];
      if (key === "fills") out.fills.push(...rows.map((x) => ({ t: x.created_time, ticker: x.ticker, action: x.action, count: x.count_fp ?? x.count, yes: x.yes_price_dollars ?? x.yes_price, fee: x.fee_cost ?? null, order: x.order_id })));
      else out.settlements.push(...rows.map((x) => ({ t: x.settled_time, ticker: x.ticker, result: x.market_result })));
      if (!data.cursor || !rows.length) break;
      cursor = data.cursor;
    }
  }
  try {
    writeFileSync(join(process.cwd(), "data", "kalshi-history.json"), JSON.stringify(out));
  } catch {
  }
  return { fills: out.fills.length, settlements: out.settlements.length };
}
