    const res = await fetch(`${ROOT}/trade-api/v2/markets/${ticker}`, { signal: AbortSignal.timeout(8000) });
    if (!res.ok) return finishClose(ticker, payout, basis);
    const data = await res.json();
    const yesBid = Number.parseFloat(data.market?.yes_bid_dollars ?? "0");
    const noBid = Number.parseFloat(data.market?.no_bid_dollars ?? "0");
    const yesAsk = Number.parseFloat(data.market?.yes_ask_dollars ?? "0");
    const noAsk = Number.parseFloat(data.market?.no_ask_dollars ?? "0");
    const qty = Math.abs(pos);
    const cost = Number.parseFloat(row?.market_exposure_dollars ?? "0");
    const entry = cost > 0 ? cost / qty : 0;
    const slip = manual ? 0.05 : 0.01;
    const liveBid = screenBid(pos, yesBid, yesAsk, noBid, noAsk);
    if (gate) return finishClose(ticker, payout, basis);
    if (!(liveBid > 0.02)) return finishClose(ticker, payout, basis);
    if (manual && minPrice > 0.02 && liveBid + 0.005 < minPrice) return finishClose(ticker, payout, basis);
    if (!manual) return finishClose(ticker, payout, basis);
    const rung = null;
    const asked = 0;
    const triggerPct = 0;
    const triggerBid = 0;
    const floorBid = minPrice > 0.02 ? Math.round(minPrice * 100) / 100 : Math.round((liveBid - slip) * 100) / 100;
    const low = floorBid;
    const cashPrices = [];
    const start = Math.round(Math.min(0.99, liveBid) * 100) / 100;
    const stop = Math.round(Math.max(0.02, Math.min(start, low)) * 100) / 100;
    for (let px = start; px >= stop - 1e-9 && cashPrices.length < (minPrice > 0.02 ? 3 : 6); px = Math.round((px - 0.01) * 100) / 100) {
      if (!cashPrices.includes(px)) cashPrices.push(px);
    }
    const prices = pos > 0
      ? cashPrices
      : cashPrices.map((cash) => Math.round((1 - cash) * 100) / 100).filter((px, index, all) => px > 0.01 && px < 0.99 && all.indexOf(px) === index);
    const bookSide = pos > 0 ? "ask" : "bid";
    let filledThis = false;
    for (const px of prices) {
      try {
        const placed = await place(ticker, bookSide, px, qty.toFixed(2), true, undefined, false, true);
        if (!placed || !(placed.filled >= 0.01)) continue;
        const cash = closeCash(pos, px, placed.yesPrice, placed.filled);
        payout += cash;
        basis += entry * placed.filled;
        filledThis = true;
        const after = await signedPosition(ticker);
        if (after * sign < -0.01) {
          noteGate(ticker, "flip", false, "exit opened the other side");
          const back = Math.abs(after);
          const undoSide = after > 0 ? "ask" : "bid";
          const quote = await fetch(`${ROOT}/trade-api/v2/markets/${ticker}`, { signal: AbortSignal.timeout(8000) });
          const undone = quote.ok ? await quote.json() : {};
          const undoBid = screenBid(
            after,
            Number.parseFloat(undone.market?.yes_bid_dollars ?? "0"),
            Number.parseFloat(undone.market?.yes_ask_dollars ?? "0"),
            Number.parseFloat(undone.market?.no_bid_dollars ?? "0"),
            Number.parseFloat(undone.market?.no_ask_dollars ?? "0"),
          );
          if (undoBid > 0.02) {
            const undoStart = Math.round(Math.min(0.99, undoBid) * 100) / 100;
            for (let i = 0; i < 3; i += 1) {
              const raw = Math.round((undoStart - i * 0.01) * 100) / 100;
              const undoPx = undoSide === "ask" ? raw : Math.round((1 - raw) * 100) / 100;
              if (!(undoPx > 0.01) || !(undoPx < 0.99)) continue;
              try {
                await place(ticker, undoSide, undoPx, back.toFixed(2), true, undefined, false, true);
              } catch {
              }
              const left = await signedPosition(ticker);
              if (Math.abs(left) < 0.01 || left * after < 0) break;
            }
          }
          markDone(ticker);
          fireOnce(ticker);
        }
        break;
      } catch {
      }
    }
    if (!filledThis) return finishClose(ticker, payout, basis);
  }
  return finishClose(ticker, payout, basis);
}
const GATE_TEST = join(process.cwd(), "data", "gate-test.json");
function readGateTest() {
  try {
    const row = JSON.parse(readFileSync(GATE_TEST, "utf8"));
    return row && typeof row === "object" ? row : {};
  } catch {
    return {};
  }
}
async function seedGate(side, ticker, yesAsk, noAsk, label) {
  const sym = symbolOf(ticker);
  if (sym !== "silver") return { status: "blocked", reason: "the one-dollar test is silver only" };
  if (side !== "up" && side !== "down") return { status: "blocked", reason: "no side" };
  const open = await fifteenOpen();
  if (open.some((row) => symbolOf(row.ticker) === "silver")) return { status: "blocked", reason: "silver is already open" };
  const quote = await liveAsks(ticker);
  const yes = quote?.yesAsk ?? yesAsk;
  const no = quote?.noAsk ?? noAsk;
  const ask = side === "up" ? yes : no;
  if (!(ask > 0.02) || !(ask < 0.99)) return { status: "blocked", reason: "no quote" };
  const count = Math.floor(1 / ask * 100) / 100;
  if (!(count >= 0.01)) return { status: "blocked", reason: "size" };
  const bookSide = side === "up" ? "bid" : "ask";
  const yesPrice = side === "up"
    ? Math.min(0.99, Math.round((ask + 0.01) * 100) / 100)
    : Math.max(0.01, Math.round((1 - ask - 0.01) * 100) / 100);
  let placed = null;
  try {
    placed = await place(ticker, bookSide, yesPrice, count.toFixed(2), false, { gateTest: true, label: label || "gate test" }, true);
  } catch (err) {
    return { status: "blocked", reason: err instanceof Error ? err.message.slice(0, 140) : "test failed" };
  }
  if (!placed || !(placed.filled > 0)) return { status: "blocked", reason: sent.__aureliusBlock || "unfilled" };
  const paid = side === "up" ? placed.yesPrice : Math.round((1 - placed.yesPrice) * 1e4) / 1e4;
  const row = {
    on: true,
    ticker,
    side,
    dollars: 1,
    asset: "silver",
    label: label || "gate test",
    at: new Date().toISOString(),
    filled: placed.filled,
    paid,
  };
  writeFileSync(GATE_TEST, JSON.stringify(row, null, 2));
  return { status: "filled", ...row };
}
async function alignPrime() {
  const open = await fifteenOpen();
  let paper = {};
  try {
    paper = JSON.parse(readFileSync(join(process.cwd(), "data", "paper-live.json"), "utf8"));
  } catch {
    paper = {};
  }
  const test = readGateTest();
  for (const held of open) {
    const side = held.pos > 0 ? "up" : "down";
    if (test.on === true && test.ticker === held.ticker && test.side === side) continue;
    if (paper.on === true && paper.ticker === held.ticker && paper.side === side) continue;
    if (paperSeat(held.ticker, side)) continue;
    const rows = listPrimePaper().filter((row) => row.ticker === held.ticker);
    const live = rows.find((row) => row.result === "open");
    const approved = live || rows[0];
    if (approved && approved.side === side) continue;
    if (approved && approved.side !== side) await flattenTicker(held.ticker);
    else if (!approved) await flattenTicker(held.ticker);
  }
}
async function halfLive(ticker) {
  await clearResting(ticker);
  for (let pass = 0; pass < 3; pass += 1) {
    const open = await fifteenOpen();
    const row = open.find((item) => item.ticker === ticker);
    const pos = row?.pos ?? await signedPosition(ticker);
    if (!(Math.abs(pos) >= 0.02)) return null;
    const res = await fetch(`${ROOT}/trade-api/v2/markets/${ticker}`, { signal: AbortSignal.timeout(8000) });
    if (!res.ok) continue;
    const data = await res.json();
    const yesBid = Number.parseFloat(data.market?.yes_bid_dollars ?? "0");
    const noBid = Number.parseFloat(data.market?.no_bid_dollars ?? "0");
    const yesAsk = Number.parseFloat(data.market?.yes_ask_dollars ?? "0");
    const cost = row?.cost ?? 0;
    const quote = screenBid(pos, yesBid, yesAsk, noBid, Number.parseFloat(data.market?.no_ask_dollars ?? "0"));
    const floor = Math.max(0.02, Math.round((quote - 0.05) * 100) / 100);
    const plan = halfCuts(pos, yesBid, noBid, yesAsk, 0, floor);
    if (!plan) continue;
    for (const px of plan.prices) {
      try {
        const placed = await place(ticker, plan.bookSide, px, plan.count, true, undefined, false, true);
        if (!placed || !(placed.filled >= 0.01)) continue;
        const payout = closeCash(pos, px, placed.yesPrice, placed.filled);
        const left = Math.round((Math.abs(pos) - placed.filled) * 100) / 100;
        return { filled: placed.filled, payout: Math.round(payout * 100) / 100, left };
      } catch (err) {
        noteGate(ticker, "half", false, err instanceof Error ? err.message.slice(0, 140) : "half rejected");
      }
    }
  }
  return null;
}
