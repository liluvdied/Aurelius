          ticker: row.slug,
          side,
          source: "live",
          venue: "polymarket",
          setupId: `${row.slug}:1h`,
          autoFilled: true,
          probe: false,
          patternLabel: "1H Bitcoin",
          stake: Math.round(stake * 100) / 100,
          ask,
          multiple: ask > 0 ? Math.round(1 / ask * 100) / 100 : 0,
          contracts,
          result: "open",
          payout: null,
          profit: null,
          exitPct: null,
          holdToExpiry: true,
          conviction: 0,
          notes: "On the account. The trail is on.",
