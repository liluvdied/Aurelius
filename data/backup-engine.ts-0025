        openedAt: (/* @__PURE__ */ new Date()).toISOString(),
        closedAt: null,
        asset,
        ticker: row.ticker,
        side,
        source: "live",
        setupId: `${row.ticker}:${side}:held`,
        autoFilled: false,
        patternLabel: labelFor(row.ticker, side) || "Live",
        stake,
        ask,
        multiple: Math.round(1 / ask * 100) / 100,
        contracts,
        result: "open",
        payout: null,
        profit: null,
        exitPct: null,
        holdToExpiry: false,
        conviction: 0,
        notes: "On the trail.",
        grokThesis: "",
        target: null,
        lastSpot: null,
        venue: "kalshi"
      },
      ...next
    ];
  }
  next = next.map((t) => {
    if (t.source !== "live" || t.result !== "open" || (t.patternLabel && t.patternLabel !== "Live")) return t;
    const label = labelFor(t.ticker, t.side);
    return label ? { ...t, patternLabel: label } : t;
  });
  return next;
}
