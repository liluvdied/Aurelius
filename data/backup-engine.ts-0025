              asset: id || "btc",
              side: row.pos > 0 ? "up" : "down",
              stake: row.cost,
              multiple: entryPx > 0 ? Math.round((1 / entryPx) * 100) / 100 : 0,
              bidPct: Math.round((bid / entryPx - 1) * 100),
              targetPct: decision.lock,
              payout,
              profit: Math.round((payout - row.cost) * 100) / 100,
              reason: decision.why,
              short: row.pos < 0,
