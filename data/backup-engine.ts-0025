    gLiveCopy.__liveCopyAgain = false;
    void copyLiveBookSafe(gLiveCopy.__lastAssets || assets);
  }
}
// DIRECT WIRE: BRICK / COTC fire to Kalshi in the same instant the paper book books them (nightbook.ts live hook).
setLiveHook(() => {
