              yesAsk,
              secondsLeft: null,
              spot: snap?.spot ?? null,
              strike: target || null
            });
          }
        }
      } catch {
      }
      // A slider set past the exit can wait. A slider set under it cannot sell early.
      if (laterPin && pin && Number(pin.ask) > 0 && qty > 0) {
