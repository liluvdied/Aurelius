// (file: kalshi-positions.tsx; positions.tsx is the desk's original open-trade list) POSITIONS tab (Claude, Oct 9, Love: "let's make a POSITIONS tab where we can do everything there, not just for trading,
// for all positions held on kalshi" + autosell). Every open Kalshi position, its value, and her autosell rule.
import { useState } from "react";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { getPositions, sellPosition, setAutosell } from "@/lib/desk/fns";

const UP = "#3ddc84";
const DOWN = "#ff5c5c";
const usd = (n: number) => `${n >= 0 ? "+" : "−"}$${Math.abs(n).toFixed(2)}`;
const when = (iso: string) => (iso ? new Date(iso).toLocaleString("en-US", { timeZone: "America/Los_Angeles", month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }) : "");

function Row({ p, onSet, onSell }: { p: any; onSet: (mode: "pct" | "price", v: number | null) => void; onSell: () => void }) {
  const [mode, setMode] = useState<"pct" | "price">(p.rule?.mode ?? "pct");
  const [val, setVal] = useState<string>(p.rule ? String(p.rule.mode === "price" ? Math.round(p.rule.value * 100) : p.rule.value) : "");
  const [confirm, setConfirm] = useState(false);
  const c = p.pnl >= 0 ? UP : DOWN;
  return (
    <div className="rounded-[12px] border px-3 py-2" style={{ borderColor: p.rule ? "rgba(179,136,255,0.6)" : "rgba(255,255,255,0.15)" }}>
      <p className="font-mono text-[10px] leading-snug text-white/90">{p.title}</p>
      <p className="font-mono text-[9px] text-white/50">
        {p.side.toUpperCase()} · {p.qty} @ {Math.round(p.entry * 100)}c · cost ${p.cost.toFixed(2)} · bid {Math.round(p.bid * 100)}c · closes {when(p.closes)}
      </p>
      <p className="mt-0.5 font-mono text-[13px] tabular-nums" style={{ color: c }}>
        ${p.value.toFixed(2)} <span className="text-[10px]">{usd(p.pnl)} ({p.pct >= 0 ? "+" : ""}{p.pct}%)</span>
      </p>
      <div className="mt-1.5 flex flex-wrap items-center gap-1.5">
        <span className="text-[8px] tracking-[0.2em] text-white/50">AUTOSELL AT</span>
        <button type="button" onClick={() => setMode(mode === "pct" ? "price" : "pct")} className="rounded-full border px-2 py-0.5 font-mono text-[9px] text-white/80" style={{ borderColor: "rgba(255,255,255,0.3)" }}>
          {mode === "pct" ? "+% GAIN" : "PRICE ¢"}
        </button>
        <input
          value={val}
          onChange={(e) => setVal(e.target.value.replace(/[^0-9.]/g, ""))}
          inputMode="decimal"
          placeholder={mode === "pct" ? "e.g. 200" : "e.g. 50"}
          className="w-16 rounded-md border bg-transparent px-1.5 py-0.5 font-mono text-[10px] text-white"
          style={{ borderColor: "rgba(255,255,255,0.3)" }}
        />
        <button type="button" onClick={() => onSet(mode, Number(val) > 0 ? Number(val) : null)} className="rounded-full border px-2 py-0.5 font-mono text-[9px]" style={{ borderColor: "#B388FF", color: "#B388FF" }}>
          {p.rule ? "UPDATE" : "SET"}
        </button>
        {p.rule ? (
          <button type="button" onClick={() => onSet(mode, null)} className="rounded-full border px-2 py-0.5 font-mono text-[9px] text-white/60" style={{ borderColor: "rgba(255,255,255,0.3)" }}>
            CLEAR
          </button>
        ) : null}
        <span className="flex-1" />
        {confirm ? (
          <>
            <button type="button" onClick={() => { setConfirm(false); onSell(); }} className="rounded-full border px-2 py-0.5 font-mono text-[9px]" style={{ borderColor: DOWN, color: DOWN }}>
              CONFIRM SELL
            </button>
            <button type="button" onClick={() => setConfirm(false)} className="font-mono text-[9px] text-white/50">cancel</button>
          </>
        ) : (
          <button type="button" onClick={() => setConfirm(true)} className="rounded-full border px-2 py-0.5 font-mono text-[9px] text-white/80" style={{ borderColor: "rgba(255,255,255,0.4)" }}>
            SELL NOW
          </button>
        )}
      </div>
      {p.rule ? (
        <p className="mt-1 font-mono text-[9px]" style={{ color: "#B388FF" }}>
          ● sells automatically when {p.rule.mode === "pct" ? `it's up ${p.rule.value}%` : `the bid reaches ${Math.round(p.rule.value * 100)}c`}
        </p>
      ) : null}
    </div>
  );
}

export function PositionsTab() {
  const qc = useQueryClient();
  const q = useQuery({ queryKey: ["positions"], queryFn: () => getPositions(), refetchInterval: 15000 });
  const rows = q.data?.rows ?? [];
  const total = rows.reduce((s: number, p: any) => s + p.value, 0);
  const cost = rows.reduce((s: number, p: any) => s + p.cost, 0);
  const refresh = (r: { rows: any[] }) => qc.setQueryData(["positions"], (old: any) => ({ ...(old || {}), rows: r.rows }));
  return (
    <section className="mx-3 mt-3 rounded-[14px] px-3 py-3" style={{ border: "1px solid rgba(255,255,255,0.18)", background: "#000" }}>
      <div className="flex items-baseline justify-between gap-2">
        <p className="text-[10px] tracking-[0.28em] text-white/90">POSITIONS · EVERYTHING ON KALSHI</p>
        <p className="font-mono text-[10px]" style={{ color: total - cost >= 0 ? UP : DOWN }}>
          ${total.toFixed(2)} <span className="text-white/50">on ${cost.toFixed(2)}</span>
        </p>
      </div>
      <p className="mt-1 font-mono text-[9px] leading-snug text-white/50">
        Set an autosell on anything: a % gain on what you paid, or a price for your side (50 = sell at 50c). The desk checks every ~20 s and sells the
        whole position when it's reached, then alerts you. You'll also get an alert the first time a position turns green.
      </p>
      <div className="mt-2 flex flex-col gap-2">
        {!q.data ? (
          <p className="font-mono text-[10px] text-white/50">loading your positions…</p>
        ) : rows.length ? (
          rows.map((p: any) => (
            <Row
              key={`${p.ticker}:${p.rule?.at ?? ""}`}
              p={p}
              onSet={(mode, v) => void setAutosell({ data: v == null ? { ticker: p.ticker, clear: true } : { ticker: p.ticker, mode, value: v } }).then(refresh)}
              onSell={() => void sellPosition({ data: { ticker: p.ticker } }).then(refresh)}
            />
          ))
        ) : (
          <p className="font-mono text-[10px] text-white/50">No open positions.</p>
        )}
      </div>
    </section>
  );
}
