// ORACLE (Claude, Oct 9 ~2:45 PM PT, Love: "can we construct a reasoning model that would cross reference all available
// markets with available information on those markets... strictly probabilities... as long as it's not a coin flip and
// we're trading on valid information with conviction and reason for the conviction"). PAPER ONLY.
//  1. CANDIDATES (this file, every 6 h): open Kalshi markets closing in 6-96 h, priced 8-92c, with volume, minus what the
//     desk / scanner already cover (15-min crypto + metals, hourly BTC, weather). data/oracle-candidates.json.
//  2. FORECASTS: a scheduled Claude session (twice a day) researches a shortlist and appends one line per market to
//     data/oracle-forecasts.jsonl: its probability, the reason, the sources, and the price it saw. Written BEFORE the result.
//  3. PAPER: a forecast trades $10 only when its probability beats the ask by 7+ points after Kalshi's fee.
//  4. REPORT CARD: every forecast is scored against the market's own price at that moment (Brier score, lower = better).
//     The bar to ever go live: 100+ settled forecasts that beat the market's score AND a green paper book.
import { readFileSync, writeFileSync, existsSync } from "node:fs";
import { join } from "node:path";
const BASE = "https://external-api.kalshi.com/trade-api/v2";
const STAKE = 10;
const EDGE = 0.07;
const SKIP = /^(KXBTC|KXETH|KXSOL|KXXRP|KXDOGE|KXGOLD|KXSILVER|KXTEMP|KXHIGH|KXLOW|KXINXU|KXNASDAQ100U)/;
const g = globalThis as unknown as { __orBusy?: boolean; __orCandAt4?: number; __orAt?: number };
const D = (f: string) => join(process.cwd(), "data", f);
const rd = (f: string, dflt: any) => { try { return existsSync(D(f)) ? JSON.parse(readFileSync(D(f), "utf8")) : dflt; } catch { return dflt; } };
const r2 = (x: number) => Math.round(x * 100) / 100;
const r3 = (x: number) => Math.round(x * 1000) / 1000;
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
const fee = (p: number, stake: number) => r2(0.07 * p * (1 - p) * (stake / p));
const dol = (m: any, k: string) => { const v = m[`${k}_dollars`]; if (v != null) return Number(v); const c = m[k]; return c != null ? Number(c) / 100 : NaN; };
async function get(path: string) {
  const res = await fetch(BASE + path, { headers: { Accept: "application/json" }, signal: AbortSignal.timeout(20000) });
  if (res.status === 429) { await sleep(5000); throw new Error("429"); }
  if (!res.ok) throw new Error(String(res.status));
  return res.json() as Promise<any>;
}
type F = { at: string; ticker: string; prob: number; reason: string; sources?: string[]; yesAsk?: number; noAsk?: number; title?: string; by?: string };
type P = { id: string; ticker: string; title: string; side: "yes" | "no"; ask: number; prob: number; reason: string; at: string; stake: number; fee: number; result: "open" | "win" | "loss" | "void"; pnl: number | null };
function forecasts(): F[] {
  try {
    if (!existsSync(D("oracle-forecasts.jsonl"))) return [];
    return readFileSync(D("oracle-forecasts.jsonl"), "utf8").split("\n").filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter((x) => x && x.ticker && x.prob >= 0 && x.prob <= 1);
  } catch { return []; }
}
async function candidates() {
  const out: any[] = [];
  const minC = Math.floor((Date.now() + 6 * 3600 * 1000) / 1000), maxC = Math.floor((Date.now() + 7 * 24 * 3600 * 1000) / 1000);
  const cat: Record<string, string> = {};
  try { for (const x of (await get(`/series`))?.series ?? []) cat[String(x.ticker)] = String(x.category || ""); } catch {}
  const byEv: Record<string, any[]> = {};
  let complete = true;
  let cursor = "";
  for (let page = 0; page < 40; page += 1) {
    await sleep(2500);
    let j: any = null;
    for (let tries = 0; tries < 4 && !j; tries += 1) {
      try { j = await get(`/markets?status=open&min_close_ts=${minC}&max_close_ts=${maxC}&limit=1000${cursor ? `&cursor=${cursor}` : ""}`); } catch (e) { try { writeFileSync(D("oracle-probe.json"), JSON.stringify({ page, tries, error: String(e) })); } catch {} await sleep(6000); }
    }
    if (!j) { complete = false; break; }
    for (const m of j?.markets ?? []) {
      const series = String(m.event_ticker || "").split("-")[0];
      if (SKIP.test(series) || SKIP.test(String(m.ticker))) continue;
      const y = dol(m, "yes_ask");
      const vol = Number(m.volume_fp ?? m.volume ?? 0);
      if (!(y >= 0.08 && y <= 0.92 && vol >= 100)) continue;
      (byEv[m.event_ticker] ||= []).push({ ticker: m.ticker, event: m.event_ticker, category: cat[series] || "", title: m.title, option: m.yes_sub_title || m.subtitle || "", closes: m.close_time, yesAsk: r2(y), noAsk: r2(dol(m, "no_ask")), volume: vol, rules: String(m.rules_primary || "").slice(0, 500) });
    }
    cursor = j?.cursor || "";
    if (!cursor) break;
  }
  for (const list of Object.values(byEv)) out.push(...list.sort((a, b) => b.volume - a.volume).slice(0, 3));
  out.sort((a, b) => b.volume - a.volume);
  // balance: at most 60 per category so sports can't crowd out everything else
  const per: Record<string, number> = {};
  const bal = out.filter((m) => { const k = m.category || "Other"; per[k] = (per[k] || 0) + 1; return per[k] <= 60; });
  out.length = 0; out.push(...bal);
  writeFileSync(D("oracle-candidates.json"), JSON.stringify({ at: new Date().toISOString(), n: out.length, complete, note: "Open Kalshi markets closing in 6 h - 7 days, 8-92c, volume 100+, top 3 per event, minus the desk's / scanner's own markets. Prices are a snapshot; re-check before forecasting.", markets: out.slice(0, 400) }, null, 1));
}
export async function oracleTick() {
  if (g.__orBusy || Date.now() - (g.__orAt || 0) < 60000) return;
  g.__orBusy = true;
  g.__orAt = Date.now();
  try {
    if (Date.now() - (g.__orCandAt4 || 0) > 6 * 3600 * 1000) {
      let age = Infinity;
      try { age = Date.now() - Date.parse(rd("oracle-candidates.json", {}).at || 0); } catch {}
      const prev = rd("oracle-candidates.json", {});
      const retry = (!prev.n || prev.complete === false || prev.complete == null) && age > 15 * 60000;
      if (age > 6 * 3600 * 1000 || retry) await candidates();
      if (rd("oracle-candidates.json", {}).complete === true) g.__orCandAt4 = Date.now();
    }
    // paper: one trade per forecast that clears the edge
    const rows: P[] = rd("oracle-paper.json", []);
    for (const f of forecasts()) {
      const y = Number(f.yesAsk), n = Number(f.noAsk);
      let side: "yes" | "no" | null = null, ask = 0;
      if (y > 0.02 && y < 0.98 && f.prob - y - fee(y, 1) * y >= EDGE) { side = "yes"; ask = y; }
      else if (n > 0.02 && n < 0.98 && (1 - f.prob) - n - fee(n, 1) * n >= EDGE) { side = "no"; ask = n; }
      if (!side) continue;
      const id = `${f.ticker}:${f.at}`;
      if (rows.some((r) => r.id === id)) continue;
      rows.unshift({ id, ticker: f.ticker, title: f.title || f.ticker, side, ask: r2(ask), prob: f.prob, reason: f.reason, at: f.at, stake: STAKE, fee: fee(ask, STAKE), result: "open", pnl: null });
    }
    // settle paper + score forecasts
    const results: Record<string, string> = rd("oracle-results.json", {});
    const need = [...new Set([...rows.filter((r) => r.result === "open").map((r) => r.ticker), ...forecasts().map((f) => f.ticker)])].filter((t) => !results[t]).slice(0, 25);
    for (const t of need) {
      await sleep(700);
      try {
        const j = await get(`/markets/${encodeURIComponent(t)}`);
        const res = String(j?.market?.result || "");
        if (res === "yes" || res === "no") results[t] = res;
        else if (/void|cancel/i.test(String(j?.market?.status || ""))) results[t] = "void";
      } catch {}
    }
    writeFileSync(D("oracle-results.json"), JSON.stringify(results));
    for (const r of rows) {
      if (r.result !== "open" || !results[r.ticker]) continue;
      if (results[r.ticker] === "void") { r.result = "void"; r.pnl = 0; continue; }
      const won = results[r.ticker] === r.side;
      r.result = won ? "win" : "loss";
      r.pnl = r2(won ? (r.stake / r.ask) * (1 - r.ask) - r.fee : -r.stake - r.fee);
    }
    writeFileSync(D("oracle-paper.json"), JSON.stringify(rows.slice(0, 1000), null, 1));
  } catch {
  } finally {
    g.__orBusy = false;
  }
}
export function oracle() {
  const fs = forecasts();
  const results: Record<string, string> = rd("oracle-results.json", {});
  const rows: P[] = rd("oracle-paper.json", []);
  let n = 0, ours = 0, mkt = 0;
  for (const f of fs) {
    const res = results[f.ticker];
    if (res !== "yes" && res !== "no") continue;
    const o = res === "yes" ? 1 : 0;
    const mid = Number.isFinite(Number(f.yesAsk)) && Number.isFinite(Number(f.noAsk)) ? (Number(f.yesAsk) + (1 - Number(f.noAsk))) / 2 : NaN;
    if (!Number.isFinite(mid)) continue;
    n++; ours += (f.prob - o) ** 2; mkt += (mid - o) ** 2;
  }
  const done = rows.filter((r) => r.result === "win" || r.result === "loss");
  const cand = rd("oracle-candidates.json", null);
  return {
    candidates: cand ? { at: cand.at, n: cand.n } : null,
    forecasts: fs.length,
    scored: n,
    brierOurs: n ? r3(ours / n) : null,
    brierMarket: n ? r3(mkt / n) : null,
    paper: { n: done.length, w: done.filter((r) => r.result === "win").length, p: r2(done.reduce((a, r) => a + (r.pnl || 0), 0)), open: rows.filter((r) => r.result === "open").length },
    latest: fs.slice(-12).reverse().map((f) => ({ ...f, result: results[f.ticker] || null, trade: rows.find((r) => r.id === `${f.ticker}:${f.at}`) || null })),
  };
}
