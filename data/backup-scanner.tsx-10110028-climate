        </>
      ) : null}

      <H>MARKET MAP · WHAT'S WORTH SCANNING</H>
      <div className="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {MAP.map((m) => (
          <div key={m.name} className="rounded-2xl border px-4 py-3" style={{ borderColor: `${TIER[m.tier]}66` }}>
            <p className="flex items-baseline justify-between gap-2 text-[10px] tracking-[0.18em]" style={{ color: TIER[m.tier] }}>
              <span>{m.name}</span>
              <span className="text-[8px] tracking-[0.2em]">{m.status}</span>
            </p>
            <p className="mt-1 text-[9px] leading-snug text-white/55">{m.data}</p>
          </div>
        ))}
      </div>
      <p className="mt-3 text-[9px] leading-snug text-white/45">
        Why low multiples: across Kalshi's history, contracts under 10c win less often than their price says (longshots lose most), while 90c+ contracts win a little
        more often than priced. Takers lose more than makers. (Bürgi, Deng &amp; Whelan, 2025.)
      </p>
    </section>
  );
}
