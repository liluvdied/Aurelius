import { Fragment, useState, type ReactNode } from "react";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { addLoveCall, editLoveCall, getHourLotto, getLoveCalls, getMentions, getOracle, getPositions, getScanner } from "@/lib/desk/fns";

const UP = "#3ddc84";
const DOWN = "#ff5c5c";
const usd = (n: number) => `${n >= 0 ? "+" : "−"}$${Math.abs(n).toFixed(2)}`;
const tone = (n: number) => (n > 0.005 ? UP : n < -0.005 ? DOWN : "rgba(255,255,255,0.75)");
const ago = (iso: string | null | undefined) => (iso ? `${Math.max(0, Math.round((Date.now() - Date.parse(iso)) / 60000))} min ago` : "starting…");
const KIND: Record<string, string> = { "high-lock": "DAILY HIGH · LOCK-IN", "low-lock": "DAILY LOW · LOCK-IN", hourly: "HOURLY · NEAR THE READING" };

// "Will the temp in New York City be above 66.99° on Oct 9, 2026 at 11am EDT? · 67° or above"
//   -> { where: "New York City", when: "Oct 9 · 11am EDT", what: "67° or above" }
function pretty(title: string) {
  const t = String(title || "");
  const [q, opt] = t.split(" · ");
  const where = (q.match(/\bin ([A-Z][A-Za-z.' -]+?)(?: be| on| today| tomorrow| between| have|\?|,)/) || [])[1] || "";
  const date = (q.match(/\bon ([A-Z][a-z]{2,8} \d{1,2})/) || [])[1] || "";
  const time = (q.match(/\bat (\d{1,2}(?::\d\d)?\s?(?:am|pm)(?: [A-Z]{2,4})?)/i) || [])[1] || "";
  const kind = /\bhigh\b/i.test(q) ? "high" : /\blow\b/i.test(q) ? "low" : /temp/i.test(q) ? "temp" : "";
  // Eastern -> her Pacific time ("6pm EDT" -> "3pm PT").
  const et = time.match(/^(\d{1,2})(?::(\d\d))?\s?(am|pm) E[DS]T$/i);
  let tPT = time;
  if (et) {
    let h = (Number(et[1]) % 12) + (/pm/i.test(et[3]) ? 12 : 0) - 3;
    if (h < 0) h += 24;
    tPT = `${h % 12 === 0 ? 12 : h % 12}${et[2] ? `:${et[2]}` : ""}${h < 12 ? "am" : "pm"} PT`;
  }
  return { where, when: [date, tPT].filter(Boolean).join(" · "), what: (opt || "").trim(), kind, q };
}
function betLine(side: string, what: string, kind: string) {
  const subject = kind === "high" ? "the day's high" : kind === "low" ? "the day's low" : kind === "temp" ? "the reading" : "it";
  return side === "yes" ? `betting ${subject} IS ${what || "yes"}` : `betting ${subject} is NOT ${what || "yes"}`;
}

function Card({ title, sub, money, line, children, note }: { title: string; sub?: string; money?: number | null; line?: ReactNode; children?: ReactNode; note?: string }) {
  const has = typeof money === "number";
  const c = has ? (money! >= 0 ? UP : DOWN) : "rgba(255,255,255,0.85)";
  const glow = has && money! > 0.005;
  return (
    <div className="flex flex-col gap-1 rounded-2xl border px-4 py-3" style={{ borderColor: glow ? "rgba(61,220,132,0.55)" : has && money! < -0.005 ? "rgba(255,92,92,0.45)" : "rgba(255,255,255,0.2)", boxShadow: glow ? "0 0 14px rgba(61,220,132,0.18)" : "none" }}>
      <p className="text-[10px] tracking-[0.26em] text-white">{title}</p>
      {sub ? <p className="text-[9px] leading-snug text-white/55">{sub}</p> : null}
      {has ? (
        <p className="mt-1 font-mono text-2xl tabular-nums" style={{ color: c, textShadow: `0 0 10px ${c}` }}>
          {usd(money!)}
        </p>
      ) : null}
      {line ? <p className="font-mono text-[11px] tabular-nums text-white/80">{line}</p> : null}
      {note ? <p className="font-mono text-[9px] tracking-[0.12em] text-white/55">{note}</p> : null}
      {children}
    </div>
  );
}
function TradeRow({ head, sub, right, rightColor, border }: { head: ReactNode; sub?: ReactNode; right: string; rightColor: string; border?: string }) {
  return (
    <div className="flex items-start gap-2 rounded-xl border px-3 py-2" style={{ borderColor: border || "rgba(255,255,255,0.14)" }}>
      <div className="min-w-0 flex-1">
        <p className="font-mono text-[10px] leading-snug text-white">{head}</p>
        {sub ? <p className="font-mono text-[9px] leading-snug text-white/55">{sub}</p> : null}
      </div>
      <span className="shrink-0 font-mono text-[11px] tabular-nums" style={{ color: rightColor }}>
        {right}
      </span>
    </div>
  );
}
const H = ({ children }: { children: ReactNode }) => <p className="mt-5 text-[10px] tracking-[0.26em] text-white/80">{children}</p>;

const MAP: { tier: "green" | "yellow" | "red"; name: string; data: string; status: string }[] = [
  { tier: "green", name: "Weather · daily high / low", data: "Settles on the station's official max/min. The station's live readings put a floor under the high and a ceiling over the low as the day goes.", status: "SCANNING" },
  { tier: "green", name: "Weather · hourly temperature", data: "Settles on a blended AREA index, not one station. She learns each city's gap from every settled hour, trades a city only after 6+ lessons, and needs a cushion of 4F or the 90th-percentile miss + 1.5F.", status: "SCANNING" },
  { tier: "yellow", name: "Mentions · what will X say", data: "Kalshi's own record of what each speaker actually said, rallies vs everything else. Before the event only, 20+ points off the record. Paper until it proves itself.", status: "PAPER" },
  { tier: "yellow", name: "ORACLE · reasoned forecasts", data: "Researched probabilities written before the result, scored against the market's own price. Real money only after 100+ forecasts that beat the crowd.", status: "PAPER" },
  { tier: "yellow", name: "Fed / CPI / jobs / yields / commodities", data: "Futures and nowcasts price these; ORACLE checks Kalshi against them. Liquid ones are usually fair.", status: "ORACLE" },
  { tier: "red", name: "Pure coin flips", data: "No data that settles the answer ahead of the crowd. Skipped on purpose.", status: "SKIP" },
];
const TIER = { green: UP, yellow: "#ffd27a", red: "#ff8a8a" };

function LoveCalls() {
  const qc = useQueryClient();
  const lq = useQuery({ queryKey: ["love-calls"], queryFn: () => getLoveCalls(), refetchInterval: 60000 });
  const pq = useQuery({ queryKey: ["positions"], queryFn: () => getPositions(), refetchInterval: 30000 });
  const L = lq.data as any;
  const pos: any[] = (pq.data as any)?.rows ?? [];
  const [pick, setPick] = useState("");
  const [reason, setReason] = useState("");
  const [sure, setSure] = useState(70);
  const [busy, setBusy] = useState(false);
  const [sellAt, setSellAt] = useState<Record<string, string>>({});
  const p = pos.find((x) => x.ticker === pick);
  const save = (r: any) => qc.setQueryData(["love-calls"], r);
  const logged = new Set((L?.rows ?? []).filter((r: any) => r.result === "open").map((r: any) => r.ticker));
  return (
    <Card
      title="LOVE'S CALLS ✍️"
      sub="Your own trades with the reason you took them, scored against the price you paid. If your instinct beats the crowd over 20-30 calls, that's when the bigger tickets earn their place."
      money={L?.total?.n ? L.total.p : null}
      line={L ? `${L.total.w}/${L.total.n} won${L.total.n ? ` · ${L.total.roi >= 0 ? "+" : ""}${L.total.roi}% on what you staked` : ""} · ${L.open} open` : "loading…"}
      note={L && Object.keys(L.by || {}).length ? Object.entries(L.by).map(([k, c]: any) => `${k.toUpperCase()} ${usd(c.p)} ${c.w}/${c.n}`).join(" · ") : undefined}
    >
      <div className="mt-2 flex flex-col gap-1.5 rounded-xl border px-3 py-2" style={{ borderColor: "rgba(179,136,255,0.45)" }}>
        <p className="text-[9px] tracking-[0.2em]" style={{ color: "#B388FF" }}>LOG A CALL FROM YOUR POSITIONS</p>
        <select value={pick} onChange={(e) => setPick(e.target.value)} className="rounded-lg bg-black px-2 py-1.5 font-mono text-[10px] text-white" style={{ border: "1px solid rgba(255,255,255,0.25)" }}>
          <option value="">pick a position…</option>
          {pos.filter((x) => !logged.has(x.ticker)).map((x) => (
            <option key={x.ticker} value={x.ticker}>
              {x.side.toUpperCase()} @ {Math.round(x.entry * 100)}c · ${x.cost.toFixed(2)} · {String(x.title).slice(0, 70)}
            </option>
          ))}
        </select>
        <textarea value={reason} onChange={(e) => setReason(e.target.value)} placeholder="why you took it (e.g. he always says Iran at rallies)" rows={2} className="rounded-lg bg-black px-2 py-1.5 font-mono text-[10px] text-white placeholder:text-white/35" style={{ border: "1px solid rgba(255,255,255,0.25)" }} />
        <div className="flex items-center gap-2 font-mono text-[9px] text-white/70">
          <span>HOW SURE</span>
          <input type="range" min={50} max={99} value={sure} onChange={(e) => setSure(Number(e.target.value))} className="glass-range flex-1" />
          <span className="w-8 text-right">{sure}%</span>
        </div>
        <button
          type="button"
          disabled={!p || !reason.trim() || busy}
          onClick={() => {
            if (!p) return;
            setBusy(true);
            void addLoveCall({ data: { ticker: p.ticker, side: p.side, entry: p.entry, stake: p.cost, reason, conviction: sure / 100, title: p.title } })
              .then((r) => { save(r); setPick(""); setReason(""); })
              .finally(() => setBusy(false));
          }}
          className="self-start rounded-full border px-3 py-1 font-mono text-[9px] tracking-[0.15em] disabled:opacity-40"
          style={{ borderColor: "#B388FF", color: "#B388FF" }}
        >
          {busy ? "LOGGING…" : "LOG THIS CALL"}
        </button>
      </div>
      <div className="mt-2 flex flex-col gap-1.5">
        {(L?.rows ?? []).slice(0, 20).map((r: any) => (
          <div key={r.id} className="rounded-xl border px-3 py-2" style={{ borderColor: r.result === "open" ? "rgba(179,136,255,0.4)" : (r.pnl ?? 0) >= 0 ? "rgba(61,220,132,0.45)" : "rgba(255,92,92,0.4)" }}>
            <div className="flex items-start gap-2">
              <p className="min-w-0 flex-1 font-mono text-[10px] leading-snug text-white">
                {r.side.toUpperCase()} @ {Math.round(r.entry * 100)}c · {r.title}
              </p>
              <span className="shrink-0 font-mono text-[11px]" style={{ color: r.result === "open" ? "#B388FF" : tone(r.pnl ?? 0) }}>
                {r.result === "open" ? "OPEN" : `${r.result === "sold" ? `SOLD ${Math.round((r.exit ?? 0) * 100)}c ` : r.result.toUpperCase() + " "}${usd(r.pnl ?? 0)}`}
              </span>
            </div>
            <p className="font-mono text-[9px] leading-snug text-white/55">
              "{r.reason}"{r.conviction ? ` · ${Math.round(r.conviction * 100)}% sure` : ""} · ${r.stake.toFixed(2)} in
            </p>
            {r.result === "open" ? (
              <div className="mt-1 flex items-center gap-1.5">
                <input value={sellAt[r.id] ?? ""} onChange={(e) => setSellAt((s) => ({ ...s, [r.id]: e.target.value }))} placeholder="sold at ¢" inputMode="numeric" className="w-20 rounded-md bg-black px-2 py-0.5 font-mono text-[9px] text-white placeholder:text-white/35" style={{ border: "1px solid rgba(255,255,255,0.25)" }} />
                <button type="button" onClick={() => Number(sellAt[r.id]) > 0 && void editLoveCall({ data: { id: r.id, sell: Number(sellAt[r.id]) } }).then(save)} className="rounded-full border px-2 py-0.5 font-mono text-[9px] text-white/80" style={{ borderColor: "rgba(255,255,255,0.35)" }}>
                  I SOLD IT
                </button>
                <span className="flex-1" />
                <button type="button" onClick={() => void editLoveCall({ data: { id: r.id, remove: true } }).then(save)} className="font-mono text-[9px] text-white/40">
                  remove
                </button>
              </div>
            ) : null}
          </div>
        ))}
        {L && !L.rows?.length ? <p className="font-mono text-[9px] text-white/45">Your first call shows up here. Held to the end, it settles itself from Kalshi's result.</p> : null}
      </div>
    </Card>
  );
}

